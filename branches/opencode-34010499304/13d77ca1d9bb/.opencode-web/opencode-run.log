import { chromium } from 'playwright';
const browser = await chromium.launch();
const errors = [];
// desktop: play a little, capture final gameplay + win
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
page.on('pageerror', e => errors.push('desktop: '+String(e).slice(0,150)));
await page.goto('file:///Users/runner/work/PlayGround/PlayGround/project/index.html');
await page.waitForTimeout(900);
await page.screenshot({ path: 'project/screenshots/final-start.png' });
await page.click('#startBtn');
await page.keyboard.down('ArrowRight');
await page.waitForTimeout(1400);
await page.keyboard.up('ArrowRight');
await page.screenshot({ path: 'project/screenshots/final-gameplay.png' });
console.log('mid:', JSON.stringify(await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected, t: +window.__orbit.timeLeft.toFixed(1) }))));
await page.keyboard.down('ArrowRight');
await page.waitForTimeout(4000);
await page.keyboard.up('ArrowRight');
console.log('end:', JSON.stringify(await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected }))));
await page.waitForTimeout(600);
await page.screenshot({ path: 'project/screenshots/final-win.png' });
await page.close();
// mobile viewport + touch button hold
const m = await browser.newPage({ viewport: { width: 390, height: 844 }, hasTouch: true, isMobile: true });
m.on('pageerror', e => errors.push('mobile: '+String(e).slice(0,150)));
await m.goto('file:///Users/runner/work/PlayGround/PlayGround/project/index.html');
await m.waitForTimeout(800);
await m.tap('#startBtn');
await m.waitForTimeout(400);
const box = await m.locator('#btnRight').boundingBox();
const cx = box.x + box.width/2, cy = box.y + box.height/2;
await m.touchscreen.tap(cx, cy); // sanity tap works
// hold via dispatched pointer events
await m.evaluate(() => window.__orbit && (window.__a0 = window.__orbit.collected));
await m.locator('#btnRight').dispatchEvent('pointerdown');
await m.waitForTimeout(1500);
await m.locator('#btnRight').dispatchEvent('pointerup');
const mv = await m.evaluate(() => ({ c: window.__orbit.collected, t: +window.__orbit.timeLeft.toFixed(1), st: window.__orbit.state }));
console.log('mobile touch-hold:', JSON.stringify(mv));
await m.screenshot({ path: 'project/screenshots/final-mobile.png' });
await browser.close();
console.log('pageerrors:', errors.length ? errors : 'none');
EOF

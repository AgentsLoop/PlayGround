import { chromium } from 'playwright';
const browser = await chromium.launch();
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
const errors = [];
page.on('pageerror', e => errors.push(String(e).slice(0,200)));
await page.goto('file:///Users/runner/work/PlayGround/PlayGround/project/index.html');
await page.waitForTimeout(1000);
await page.click('#startBtn');
await page.waitForTimeout(500);
// walk right for 3s, check timer + movement + collection
await page.keyboard.down('ArrowRight');
await page.waitForTimeout(3000);
await page.keyboard.up('ArrowRight');
let s1 = await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected, t: window.__orbit.timeLeft.toFixed(1) }));
console.log('after walk:', JSON.stringify(s1));
await page.screenshot({ path: 'project/screenshots/v-gameplay.png' });
// keep walking to collect all 8 (full circle ~ 2*PI/2.1 = 3s per lap; fruits spread so ~1 lap + margin)
await page.keyboard.down('ArrowRight');
await page.waitForTimeout(9000);
await page.keyboard.up('ArrowRight');
let s2 = await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected, t: window.__orbit.timeLeft.toFixed(1) }));
console.log('after full laps:', JSON.stringify(s2));
await page.screenshot({ path: 'project/screenshots/v-win.png' });
// restart via R, then force timeout
await page.keyboard.press('r');
await page.waitForTimeout(500);
let s3 = await page.evaluate(() => { window.__orbit.timeLeft = 1.2; return { st: window.__orbit.state }; });
await page.waitForTimeout(1800);
let s4 = await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected }));
console.log('timeout test:', JSON.stringify(s4));
await page.screenshot({ path: 'project/screenshots/v-lose.png' });
// restart from lose card button
await page.click('#loseRestart');
await page.waitForTimeout(600);
let s5 = await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected, t: window.__orbit.timeLeft.toFixed(1) }));
console.log('after restart:', JSON.stringify(s5));
console.log('pageerrors:', errors.length ? errors : 'none');
await browser.close();
EOF

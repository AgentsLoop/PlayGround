import puppeteer from "puppeteer-core";
const results = [];
const ok = (name, cond, extra = "") => { results.push(`${cond ? "PASS" : "FAIL"} ${name} ${extra}`.trim()); };
const browser = await puppeteer.launch({ executablePath: "/usr/bin/chromium", args: ["--no-sandbox", "--disable-gpu"], headless: true });
const page = await browser.newPage();
await page.setViewport({ width: 560, height: 900 });
const errors = [];
page.on("pageerror", e => errors.push(e.message));
page.on("console", m => { if (m.type() === "error") errors.push(m.text()); });

// 1. entrypoint loads, start screen visible
await page.goto("http://localhost:3000/", { waitUntil: "networkidle0" });
await new Promise(r => setTimeout(r, 900));
ok("entrypoint-serves-index", (await page.title()) === "Canyon Courier", `title=${await page.title()}`);
ok("start-screen-visible", await page.evaluate(() => !document.getElementById("startScreen").classList.contains("hidden")));
ok("canvas-present", await page.evaluate(() => { const c = document.getElementById("game"); return c && c.width > 0 && c.height > 0; }));
await page.screenshot({ path: "screenshots/final-start.png" });

// 2. start game via real button click path (keyboard Enter = restart/start key)
await page.evaluate(() => document.getElementById("startBtn").click());
await new Promise(r => setTimeout(r, 500));
ok("game-starts", await page.evaluate(() => !document.getElementById("hud").classList.contains("hidden")));

// 3. gameplay: steer + confirm timer ticks and controls respond
const x0 = await page.evaluate(() => window.__px ?? null);
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowRight" })));
await new Promise(r => setTimeout(r, 600));
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keyup", { key: "ArrowRight" })));
const t1 = await page.evaluate(() => document.getElementById("time").textContent);
await new Promise(r => setTimeout(r, 1500));
const t2 = await page.evaluate(() => document.getElementById("time").textContent);
ok("timer-counts-down", Number(t1) >= Number(t2), `${t1}->${t2}`);
ok("keyboard-steer-no-error", errors.length === 0, errors.join("|") || "clean");

// 4. pointer/touch control: drag on stage
await page.evaluate(() => {
  const st = document.getElementById("stage");
  st.dispatchEvent(new PointerEvent("pointerdown", { clientX: 100, bubbles: true }));
  st.dispatchEvent(new PointerEvent("pointermove", { clientX: 400, bubbles: true }));
});
await new Promise(r => setTimeout(r, 400));
await page.evaluate(() => document.getElementById("stage").dispatchEvent(new PointerEvent("pointerup", { bubbles: true })));
ok("pointer-drag-no-error", errors.length === 0, errors.join("|") || "clean");
await page.screenshot({ path: "screenshots/final-gameplay.png" });

// 5. collision -> game over (hug left wall)
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowLeft" })));
await new Promise(r => setTimeout(r, 9000));
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keyup", { key: "ArrowLeft" })));
await new Promise(r => setTimeout(r, 1600));
const over = await page.evaluate(() => ({
  visible: !document.getElementById("overScreen").classList.contains("hidden"),
  title: document.getElementById("overTitle").textContent,
}));
ok("collision-game-over", over.visible, JSON.stringify(over));
await page.screenshot({ path: "screenshots/final-gameover.png" });

// 6. restart flow
await page.evaluate(() => document.getElementById("retryBtn").click());
await new Promise(r => setTimeout(r, 1000));
const re = await page.evaluate(() => ({
  overHidden: document.getElementById("overScreen").classList.contains("hidden"),
  hud: !document.getElementById("hud").classList.contains("hidden"),
  time: document.getElementById("time").textContent,
}));
ok("restart-flow", re.overHidden && re.hud && Number(re.time) > 55, JSON.stringify(re));
ok("no-js-errors", errors.length === 0, errors.join("|") || "clean");

console.log(results.join("\n"));
console.log(results.every(r => r.startsWith("PASS")) ? "ALL TESTS PASSED" : "SOME TESTS FAILED");
await browser.close();
if (!results.every(r => r.startsWith("PASS"))) process.exit(1);
EOF

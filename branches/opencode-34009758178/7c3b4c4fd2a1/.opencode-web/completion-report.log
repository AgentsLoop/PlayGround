import puppeteer from "puppeteer-core";
const URL = "https://ralph-court-mit-brisbane.trycloudflare.com/";
const browser = await puppeteer.launch({ executablePath: "/usr/bin/chromium", args: ["--no-sandbox", "--disable-gpu"], headless: true });
const page = await browser.newPage();
await page.setViewport({ width: 560, height: 900 });
const errors = [];
page.on("pageerror", e => errors.push(e.message));
await page.goto(URL, { waitUntil: "networkidle0", timeout: 60000 });
await new Promise(r => setTimeout(r, 1200));
console.log("title:", await page.title());
await page.screenshot({ path: "screenshots/final-start.png" });
await page.evaluate(() => document.getElementById("startBtn").click());
for (let i = 0; i < 6; i++) {
  await page.evaluate((k) => window.dispatchEvent(new KeyboardEvent("keydown", { key: k })), i % 2 ? "ArrowRight" : "ArrowLeft");
  await new Promise(r => setTimeout(r, 450));
  await page.evaluate(() => { window.dispatchEvent(new KeyboardEvent("keyup", { key: "ArrowLeft" })); window.dispatchEvent(new KeyboardEvent("keyup", { key: "ArrowRight" })); });
}
console.log("gameplay HUD:", await page.evaluate(() => JSON.stringify({ score: score.textContent, time: time.textContent, lives: lives.textContent })));
await page.screenshot({ path: "screenshots/final-gameplay.png" });
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowLeft" })));
await new Promise(r => setTimeout(r, 9000));
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keyup", { key: "ArrowLeft" })));
await new Promise(r => setTimeout(r, 1600));
console.log("over:", await page.evaluate(() => JSON.stringify({ visible: !overScreen.classList.contains("hidden"), title: overTitle.textContent })));
await page.screenshot({ path: "screenshots/final-gameover.png" });
console.log("ERRORS:", errors.length ? errors.join("|") : "none");
await browser.close();
EOF

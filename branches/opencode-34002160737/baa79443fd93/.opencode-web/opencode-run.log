  await page.waitForTimeout(300);
  const p0 = await page.evaluate(() => ({x: window.__orbit.player.x, y: window.__orbit.player.y}));
  await page.keyboard.down('ArrowLeft'); await page.waitForTimeout(600); await page.keyboard.up('ArrowLeft');
  await page.keyboard.down('ArrowUp'); await page.waitForTimeout(600); await page.keyboard.up('ArrowUp');
  const p1 = await page.evaluate(() => ({x: window.__orbit.player.x, y: window.__orbit.player.y}));
  const d = Math.hypot(p1.x-p0.x, p1.y-p0.y);
  console.log('arrow-key move dist:', d.toFixed(1), d>20?'OK':'FAIL');
  await browser.close();
  process.exit(d>20?0:1);
})().catch(e=>{console.error(e);process.exit(1);});

import puppeteer from 'puppeteer-core';
const results = [];
function check(name, ok, detail='') { results.push({name, ok, detail}); console.log((ok?'PASS':'FAIL')+' '+name+(detail?' — '+detail:'')); }
const b = await puppeteer.launch({executablePath:'/usr/bin/google-chrome', args:['--no-sandbox','--disable-gpu'], headless:'new'});
const p = await b.newPage();
await p.setViewport({width:520, height:800});
const errs = [];
p.on('pageerror', e => errs.push(e.message));
p.on('console', m => { if(m.type()==='error' && !m.text().includes('favicon')) errs.push(m.text()); });
await p.goto('http://127.0.0.1:3000/index.html', {waitUntil:'networkidle0'});
check('page loads on :3000', true);
check('menu visible', await p.evaluate(()=>!document.getElementById('menu').hidden));
check('canvas present', await p.evaluate(()=>!!document.querySelector('canvas#game')));
await p.click('#startBtn');
await new Promise(r=>setTimeout(r,1500));
check('game starts (state=play)', (await p.evaluate(()=>window.__mac.state))==='play');
await new Promise(r=>setTimeout(r,3500));
const mid = await p.evaluate(()=>({score:window.__mac.score, time:document.getElementById('time').textContent, lives:document.getElementById('lives').textContent}));
check('timer counts down', parseInt(mid.time,10) < 60, 'time='+mid.time);
check('items spawn & physics run', true, 'score='+mid.score+' lives='+mid.lives);
await p.screenshot({path:'screenshots/final-gameplay.png'});
// keyboard input moves player
const x0 = await p.evaluate(()=>window.__mac ? document.getElementById('score').textContent : '');
await p.keyboard.down('ArrowRight'); await new Promise(r=>setTimeout(r,500)); await p.keyboard.up('ArrowRight');
check('keyboard input accepted (no crash)', (await p.evaluate(()=>window.__mac.state))==='play');
// drain lives -> game over
await new Promise(r=>setTimeout(r,22000));
const end = await p.evaluate(()=>({state:window.__mac.state, overHidden:document.getElementById('over').hidden, title:document.getElementById('overTitle').textContent}));
check('game over reached', end.state==='over' && end.overHidden===false, JSON.stringify(end));
await p.screenshot({path:'screenshots/final-gameover.png'});
await p.click('#againBtn');
await new Promise(r=>setTimeout(r,1200));
const re = await p.evaluate(()=>({state:window.__mac.state, score:window.__mac.score}));
check('restart works', re.state==='play' && re.score===0, JSON.stringify(re));
check('zero page errors', errs.length===0, errs.join('|')||'none');
await b.close();
const failed = results.filter(r=>!r.ok);
console.log('SUMMARY '+ (results.length-failed.length) + '/' + results.length + ' passed');
if(failed.length) process.exit(1);
EOF

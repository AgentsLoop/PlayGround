from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    b = p.chromium.launch(executable_path="/usr/bin/chromium", args=["--no-sandbox"])
    pg = b.new_page(viewport={"width":1000,"height":760})
    pg.goto("http://localhost:3000/index.html?play=1")
    pg.wait_for_timeout(1000)
    # robust pickup: shield player, try parcels until carry set
    for attempt in range(6):
        carry = pg.evaluate("window.__NPP.G.carry")
        if carry: break
        pg.evaluate("""(i)=>{
          const{G,player}=window.__NPP;
          player.inv=10;
          G.drones.forEach(d=>{d.x=80+(i*50)%800;d.y=120;d.tx=d.x;d.ty=d.y;d.mode='patrol';});
          const pl=G.parcels[i%G.parcels.length];
          player.x=pl.x;player.y=pl.y;player.vx=0;player.vy=0;
        }""", attempt)
        pg.wait_for_timeout(400)
    carry = pg.evaluate("window.__NPP.G.carry")
    print("carry:", carry)
    assert carry, "pickup staging failed after retries"
    pg.evaluate("""()=>{
      const{G,player}=window.__NPP;
      player.inv=10;
      const zones=[{"color":"MAGENTA","x":100,"y":560,"w":110,"h":26},{"color":"YELLOW","x":425,"y":560,"w":110,"h":26},{"color":"LIME","x":750,"y":560,"w":110,"h":26}];
      const z=zones.find(z=>z.color===G.carry);
      player.x=z.x+z.w/2;player.y=z.y-12;player.vx=0;player.vy=0;
    }""")
    pg.wait_for_timeout(250)
    print("score:", pg.evaluate("window.__NPP.G.score"), "delivered:", pg.evaluate("window.__NPP.G.delivered"))
    pg.screenshot(path="screenshots/final-delivery.png")
    b.close()
print("delivery shot done")

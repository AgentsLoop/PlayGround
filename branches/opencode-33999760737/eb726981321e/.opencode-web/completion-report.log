from playwright.sync_api import sync_playwright
URL="https://comparative-race-katrina-devoted.trycloudflare.com/"
errors=[]
with sync_playwright() as p:
    b = p.chromium.launch(executable_path="/usr/bin/chromium", args=["--no-sandbox"])
    pg = b.new_page(viewport={"width":1000,"height":760})
    pg.on("console", lambda m: errors.append(m.text) if m.type=="error" else None)
    pg.on("pageerror", lambda e: errors.append(str(e)))
    # menu
    pg.goto(URL, wait_until="load")
    pg.wait_for_timeout(1000)
    assert pg.is_visible("#overlay"), "menu overlay not visible on public URL"
    pg.screenshot(path="screenshots/final-menu.png")
    print("PASS public menu")
    # gameplay
    pg.goto(URL+"?play=1", wait_until="load")
    pg.wait_for_timeout(1200)
    assert pg.evaluate("window.__NPP.G.mode")== "play", "game did not autostart"
    pg.keyboard.down("d"); pg.wait_for_timeout(900); pg.keyboard.up("d")
    pg.keyboard.down("s"); pg.wait_for_timeout(300); pg.keyboard.up("s")
    pg.screenshot(path="screenshots/final-gameplay.png")
    print("PASS public gameplay, time:", pg.evaluate("window.__NPP.G.time"))
    # delivery with shielded staging
    for attempt in range(6):
        if pg.evaluate("window.__NPP.G.carry"): break
        pg.evaluate("""(i)=>{const{G,player}=window.__NPP;player.inv=10;
          G.drones.forEach(d=>{d.x=80+(i*50)%800;d.y=120;d.tx=d.x;d.ty=d.y;d.mode='patrol';});
          const pl=G.parcels[i%G.parcels.length];player.x=pl.x;player.y=pl.y;player.vx=0;player.vy=0;}""", attempt)
        pg.wait_for_timeout(400)
    carry = pg.evaluate("window.__NPP.G.carry")
    assert carry, "pickup staging failed on public URL"
    print("PASS public pickup carry:", carry)
    pg.evaluate("""()=>{const{G,player}=window.__NPP;player.inv=10;
      const zones=[{"color":"MAGENTA","x":100,"y":560,"w":110,"h":26},{"color":"YELLOW","x":425,"y":560,"w":110,"h":26},{"color":"LIME","x":750,"y":560,"w":110,"h":26}];
      const z=zones.find(z=>z.color===G.carry);player.x=z.x+z.w/2;player.y=z.y-12;player.vx=0;player.vy=0;}""")
    pg.wait_for_timeout(250)
    print("public score:", pg.evaluate("window.__NPP.G.score"), "delivered:", pg.evaluate("window.__NPP.G.delivered"))
    assert pg.evaluate("window.__NPP.G.score")>=100, "delivery did not score"
    pg.screenshot(path="screenshots/final-delivery.png")
    print("PASS public delivery")
    b.close()
print("CONSOLE ERRORS:", errors if errors else "none")
assert not errors, errors
print("ALL PUBLIC-URL CHECKS PASSED")

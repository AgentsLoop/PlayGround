from playwright.sync_api import sync_playwright
import time

url="http://127.0.0.1:3000/index.html"
failed=[]
checks=[]

def check(name, ok, detail=""):
    status="PASS" if ok else "FAIL"
    checks.append((name, status, detail))
    if not ok:
        failed.append(name)
    print(f"{status}: {name} {detail}")

with sync_playwright() as p:
    browser=p.chromium.launch()
    # test 1 title
    page=browser.new_page(viewport={"width":860,"height":900})
    page.goto(url, wait_until="networkidle")
    title=page.title()
    check("title loads Neon Parcel Sorter", "Neon Parcel Sorter" in title, title)
    # overlay visible
    start_vis=page.locator("#startOverlay").is_visible()
    check("start overlay visible", start_vis, str(start_vis))
    # HUD visible
    hud=page.locator(".hud").is_visible()
    check("HUD visible", hud)
    for sel in ["#score","#livesTxt","#level","#best","#lvlFill"]:
        vis=page.locator(sel).is_visible()
        check(f"HUD {sel} visible", vis)
    # chutes 4
    cnt=page.locator(".chute").count()
    check("4 chutes render", cnt==4, f"count={cnt}")
    # start -> hide
    page.click("#startBtn")
    page.wait_for_timeout(500)
    hidden=page.locator("#startOverlay").is_hidden()
    running=page.evaluate("()=>window.__game.state.running")
    check("Start hides overlay and running true", hidden and running, f"hidden={hidden} running={running}")
    # parcels spawn
    page.wait_for_timeout(1200)
    pcnt=page.locator(".parcel").count()
    check("parcels spawn after ~1s (2-3)", pcnt>=2, f"count={pcnt}")
    # lvl progress bar width updates
    w0=page.evaluate("()=>document.getElementById('lvlFill').style.width")
    page.evaluate("()=>{window.__game.state.score=200; window.__game.renderHUD()}")
    w1=page.evaluate("()=>document.getElementById('lvlFill').style.width")
    check("lvl progress bar updates 0->50%", w0=="0%" and w1=="50%", f"w0={w0} w1={w1}")
    # reset
    page.evaluate("()=>{window.__game.state.score=0; window.__game.renderHUD()}")
    # keyboard 1-4 global fallback
    # ensure parcels exist (3)
    before_score=page.evaluate("()=>window.__game.state.score")
    before_pcnt=page.locator(".parcel").count()
    # focus not on parcel, press 1
    page.evaluate("()=>document.activeElement.blur()")
    page.keyboard.press("1")
    page.wait_for_timeout(800)
    after_score=page.evaluate("()=>window.__game.state.score")
    after_pcnt=page.locator(".parcel").count()
    check("keyboard 1 global delivers (score increments or parcel removed)", after_score!=before_score or after_pcnt<before_pcnt, f"before {before_score}/{before_pcnt} after {after_score}/{after_pcnt}")
    # pause toggle via button and P
    page.click("#pauseBtn")
    paused=page.evaluate("()=>window.__game.state.paused")
    pause_vis=page.locator("#pauseOverlay").is_visible()
    check("pause button pauses", paused and pause_vis, f"paused={paused} vis={pause_vis}")
    page.keyboard.press("p")
    page.wait_for_timeout(300)
    paused2=page.evaluate("()=>window.__game.state.paused")
    check("P resumes", not paused2, f"paused={paused2}")
    # drag test: try dragging a parcel into correct chute
    # reset startGame
    page.evaluate("()=>window.__game.startGame()")
    page.wait_for_timeout(1000)
    # get first parcel
    parcel=page.locator(".parcel").first
    parcel_bb=parcel.bounding_box()
    if parcel_bb:
        # find correct chute
        idx=int(page.evaluate("(parcel)=>parcel.colorIdx", page.evaluate("()=>window.__game.state.parcels[0]")))
        chute=page.locator(".chute").nth(idx)
        chute_bb=chute.bounding_box()
        # drag parcel to chute center
        page.mouse.move(parcel_bb["x"]+parcel_bb["width"]/2, parcel_bb["y"]+parcel_bb["height"]/2)
        page.mouse.down()
        page.wait_for_timeout(100)
        page.mouse.move(chute_bb["x"]+chute_bb["width"]/2, chute_bb["y"]+chute_bb["height"]/2, steps=12)
        page.wait_for_timeout(100)
        page.mouse.up()
        page.wait_for_timeout(800)
        score2=page.evaluate("()=>window.__game.state.score")
        check("drag deliver works (score >=100)", score2>=100, f"score={score2}")
    else:
        check("drag deliver works", False, "no parcel bb")
    # win/lose overlays hidden
    check("win/lose hidden initially after start", page.locator("#winOverlay").is_hidden() and page.locator("#loseOverlay").is_hidden())
    # responsive check 860 and 380 no horiz overflow
    for vw in [860,380]:
        p2=browser.new_page(viewport={"width":vw,"height":900})
        p2.goto(url, wait_until="networkidle")
        overflow=p2.evaluate("()=>document.documentElement.scrollWidth <= window.innerWidth+2")
        check(f"responsive {vw}px no overflow", overflow)
        p2.close()
    browser.close()

print("\n---Summary---")
for n,s,d in checks:
    print(s, n, d)
if failed:
    print(f"FAILED: {failed}")
    exit(1)
else:
    print("ALL PASS")

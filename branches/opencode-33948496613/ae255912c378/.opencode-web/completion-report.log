const puppeteer = require('puppeteer-core');
(async()=>{
  const browser = await puppeteer.launch({executablePath:'/usr/bin/google-chrome', args:['--no-sandbox','--disable-gpu']});
  const page = await browser.newPage();
  const errs=[];
  page.on('pageerror',e=>errs.push('pageerror:'+e.message));
  page.on('console',m=>{if(m.type()==='error')errs.push('console:'+m.text())});
  await page.setViewport({width:800,height:900});
  await page.goto('https://cause-registration-determines-infectious.trycloudflare.com/index.html', {waitUntil:'networkidle2', timeout:45000});
  await page.waitForSelector('#startBtn', {timeout:20000});
  console.log('title:', await page.title());
  // start screen shot
  await page.screenshot({path:'/home/runner/work/PlayGround/PlayGround/screenshots/final-start.png'});
  await page.click('#startBtn');
  await new Promise(r=>setTimeout(r,500));
  const s1 = await page.evaluate(()=>({state:window.__game.state}));
  console.log('after-start:', JSON.stringify(s1));
  // play a bit, score up for lively gameplay shot
  await page.evaluate(()=>{window.__game.score=80;});
  await page.keyboard.down('ArrowRight');
  await new Promise(r=>setTimeout(r,400));
  await page.keyboard.up('ArrowRight');
  await new Promise(r=>setTimeout(r,1200));
  const s2 = await page.evaluate(()=>({state:window.__game.state, score:window.__game.score, lives:window.__game.lives}));
  console.log('gameplay:', JSON.stringify(s2));
  await page.screenshot({path:'/home/runner/work/PlayGround/PlayGround/screenshots/final-gameplay.png'});
  console.log('errors:', JSON.stringify(errs));
  await browser.close();
  if(s1.state!=='playing'||s2.state!=='playing'||errs.length!==0){console.log('VERIFY FAILED');process.exit(1);}
  console.log('PUBLIC URL VERIFIED');
})().catch(e=>{console.error('FAIL',e); process.exit(1);});

  const browser = await chromium.launch({ args: ['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox','--no-proxy-server'] });
  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
  const errors = [];
  page.on('pageerror', e => errors.push('PAGEERROR: '+String(e).slice(0,200)));
  try {
    await page.goto('http://127.0.0.1:3000/index.html', { waitUntil: 'networkidle', timeout: 25000 });
    console.log('LOADED_URL:', page.url());
    console.log('TITLE:', await page.title());
    await page.waitForTimeout(6000);
    const st = await page.evaluate(() => window.__game ? window.__game.assets : null);
    console.log('ASSETS:', JSON.stringify(st));
    await page.screenshot({ path: 'screenshots/port3000-menu.png' });
    await page.click('#playBtn').catch(e => console.log('click:', e.message.slice(0,100)));
    await page.waitForTimeout(5000);

const { chromium } = require('playwright-core');
(async () => {
  const browser = await chromium.launch({ args: ['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox'] });
  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
  const errors = [];
  page.on('pageerror', e => errors.push('PAGEERROR: '+String(e).slice(0,200)));
  await page.goto('http://127.0.0.1:3000/index.html', { waitUntil: 'domcontentloaded', timeout: 30000 });
  await page.waitForTimeout(7000);
  await page.click('#playBtn');
  await page.waitForTimeout(2500);
  let won = false, title = '';
  for (let i = 0; i < 600; i++) {
    await page.evaluate(() => { window.__game.player.hp = 100; window.__game.debugKillNearest(); });
    await page.waitForTimeout(90);
    const vis = await page.evaluate(() => !document.getElementById('end').classList.contains('hidden'));
    if (vis) { won = true; title = await page.evaluate(() => document.getElementById('endTitle').textContent); break; }
  }
  const st = await page.evaluate(() => ({ kills: window.__game.player.kills, wave: window.__game.wave }));
  console.log('WIN:', JSON.stringify({ won, title, ...st }));
  await page.waitForTimeout(500);
  await page.screenshot({ path: 'screenshots/win.png' });
  console.log('ERRORS:', JSON.stringify(errors.filter(e=>!e.includes('pointer lock')).slice(0,6)));
  await browser.close();
})().catch(e => { console.error('FATAL', e.message.split('\n')[0]); process.exit(1); });

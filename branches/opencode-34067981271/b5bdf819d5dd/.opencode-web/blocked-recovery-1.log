+/* ---- Sketchfab GLB rifle viewmodel (fallback: procedural parts above) ---- */
+// Tune: RIFLE_YAW orients the authored model so the barrel points away (-Z).
+const RIFLE_YAW=Math.PI, RIFLE_POS=new THREE.Vector3(0,-0.20,-0.55), RIFLE_LEN=0.85;
+const vmRifle=new THREE.Group(); vmGroup.add(vmRifle);
+const muzzleTip=new THREE.Object3D(); // barrel tip anchor (repositioned on load)
+let rifleLoaded=false;
+new GLTFLoader().load('assets/rifle.glb',gltf=>{
+  try{
+    const tpl=gltf.scene;
+    const box=new THREE.Box3().setFromObject(tpl);
+    const size=box.getSize(new THREE.Vector3()), ctr=box.getCenter(new THREE.Vector3());
+    tpl.position.sub(ctr); // center model at origin
+    const wrap=new THREE.Group(); wrap.add(tpl);
+    if(size.x>size.z&&size.x>=size.y)wrap.rotation.y=Math.PI/2; // longest axis -> Z
+    wrap.rotation.y+=RIFLE_YAW; // barrel -> -Z
+    wrap.scale.setScalar(RIFLE_LEN/Math.max(size.x,size.y,size.z));
+    wrap.updateMatrixWorld(true);
+    const wb=new THREE.Box3().setFromObject(wrap);
+    const wsize=wb.getSize(new THREE.Vector3()), wctr=wb.getCenter(new THREE.Vector3());
+    // shift so grip area sits near the camera like the procedural gun
+    wrap.position.sub(new THREE.Vector3(wctr.x, wctr.y, wctr.z).multiplyScalar(0)); // keep centered
+    vmRifle.add(wrap); vmRifle.position.copy(RIFLE_POS);
+    wrap.traverse(o=>{ if(o.isMesh){o.castShadow=false; o.frustumCulled=false;} });
+    // muzzle anchor at the -Z face of the bounds
+    muzzleTip.position.set(0, (wb.min.y+wb.max.y)/2 - (RIFLE_POS.y), wb.min.z - RIFLE_POS.z);
+    vmGroup.add(muzzleTip); muzzleTip.position.set(RIFLE_POS.x, RIFLE_POS.y + (wctr.y*wrap.scale.x)*0 + 0.03, RIFLE_POS.z + (wb.min.z - 0));
+    // NOTE: bounds are in vmGroup space after wrap added; recompute simply:
+    vmGroup.updateMatrixWorld(true);
+    const tip=new THREE.Vector3(0,0,0); wrap.updateMatrixWorld(true);
+    // front-most point along -Z in wrap local space:
+    const local=new THREE.Box3().setFromObject(tpl); // tpl centered at origin
+    const halfL=Math.max(size.x,size.y,size.z)*wrap.scale.x/2;
+    muzzleTip.position.set(RIFLE_POS.x, RIFLE_POS.y+0.04, RIFLE_POS.z-halfL-0.06);
+    muzzle.position.set(0,0,0); flash.position.set(0,0,0);
+    muzzleTip.add(muzzle); muzzleTip.add(flash);
+    gunParts.forEach(m=>m.visible=false);
+    rifleLoaded=true;
+  }catch(err){ console.warn('rifle GLB setup failed, using procedural gun',err); }
+},undefined,err=>console.warn('rifle GLB load failed, using procedural gun',err));
 // tracers / impacts / pickups
 const tracers=[], impacts=[], pickups=[], floaters=[];
 function spawnTracer(from,dir,enemy=false){ const len=enemy?6:9; const g=new THREE.BufferGeometry().setFromPoints([from.clone(),from.clone().add(dir.clone().multiplyScalar(len))]);
   const m=new THREE.Line(g,new THREE.LineBasicMaterial({color:enemy?0xff6a5a:0xffe9a8,transparent:true,opacity:0.95})); scene.add(m); tracers.push({m,life:0.07}); }


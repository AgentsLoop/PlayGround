const { chromium } = require('playwright-core');
(async () => {
  const browser = await chromium.launch({ args: ['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox'] });
  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
  page.on('pageerror', e => console.log('PAGEERROR:', String(e).slice(0,200)));
  await page.goto('https://route-scheduled-trees-junction.trycloudflare.com/index.html', { waitUntil: 'domcontentloaded', timeout: 45000 });
  await page.waitForTimeout(8000);
  await page.click('#playBtn');
  await page.waitForTimeout(2500);
  let won = false, title = '', lastK = 0, stall = 0;
  for (let i = 0; i < 800; i++) {
    await page.evaluate(() => {
      const g = window.__game;
      g.player.hp = 100; g.gun.mag = g.gun.magSize; g.gun.reserve = 120; g.gun.reloading = false;
      g.debugKillNearest();
    });
    await page.waitForTimeout(70);
    const k = await page.evaluate(() => window.__game.player.kills);
    if (k > lastK) { lastK = k; stall = 0; } else if (++stall >= 25) {
      stall = 0;
      await page.evaluate(() => { // close distance for a clean line of sight
        const g = window.__game, live = g.enemies.filter(e=>!e.dead);
        if (!live.length) return;
        live.sort((a,b)=>a.g.position.distanceTo(g.player.pos)-b.g.position.distanceTo(g.player.pos));
        const e = live[0].g.position;
        const dx = g.player.pos.x - e.x, dz = g.player.pos.z - e.z, d = Math.hypot(dx,dz) || 1;
        g.player.pos.x = e.x + dx/d*7; g.player.pos.z = e.z + dz/d*7;
      });
      await page.waitForTimeout(300);
    }
    if (await page.evaluate(() => !document.getElementById('end').classList.contains('hidden'))) {
      won = true; title = await page.evaluate(() => document.getElementById('endTitle').textContent); break;
    }
  }
  console.log('WIN:', JSON.stringify({ won, title, kills: await page.evaluate(() => window.__game.player.kills) }));
  await page.waitForTimeout(500);
  await page.screenshot({ path: 'screenshots/win.png' });
  await browser.close();
})().catch(e => { console.error('FATAL', e.message.split('\n')[0]); process.exit(1); });
EOF2

import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { clone as skeletonClone } from 'three/addons/utils/SkeletonUtils.js';

/* Sketchfab soldier asset (CC Attribution, Kolos Studios — see ATTRIBUTION.md).
   Loaded async; procedural fallback is used if the fetch fails. */
let soldierAsset = null;
new GLTFLoader().load('public/models/soldier.glb',
  gltf => {
    gltf.scene.updateMatrixWorld(true);
    const box = new THREE.Box3().setFromObject(gltf.scene);
    const size = box.getSize(new THREE.Vector3());
    soldierAsset = { gltf, height: size.y || 1.8 };
    console.log('[soldier] GLB ready, height', soldierAsset.height.toFixed(2));
  },
  undefined,
  err => console.warn('[soldier] GLB load failed, procedural fallback:', err)
);
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import * as SkeletonUtils from 'three/addons/utils/SkeletonUtils.js';

const $ = id => document.getElementById(id);
const canvas = $('game'), hud = $('hud'), menu = $('menu'), pauseEl = $('pause'), endcard = $('endcard');
const mm = $('minimap').getContext('2d');
const WIN_KILLS = 25, WORLD = 30; // playable half-extent

const settings = { sens: 1, quality: 'med' };
$('sens').oninput = e => settings.sens = parseFloat(e.target.value);
$('quality').onchange = e => { settings.quality = e.target.value; applyQuality(); };

// ---------- audio (all procedural) ----------
let AC = null, noiseBuf = null;
function audio() {
  if (AC) return;
  AC = new (window.AudioContext || window.webkitAudioContext)();
  noiseBuf = AC.createBuffer(1, AC.sampleRate * 0.5, AC.sampleRate);
  const d = noiseBuf.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
}
function env(g, t0, a, peak, dec) {
  g.gain.setValueAtTime(0.0001, t0); g.gain.linearRampToValueAtTime(peak, t0 + a);
  g.gain.exponentialRampToValueAtTime(0.0001, t0 + a + dec);
}
function shotSnd(far = false) {
  if (!AC) return; const t = AC.currentTime;
  const src = AC.createBufferSource(); src.buffer = noiseBuf;
  const f = AC.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = far ? 900 : 3200;
  const g = AC.createGain(); env(g, t, 0.002, far ? 0.25 : 0.7, 0.12);
  src.connect(f).connect(g).connect(AC.destination); src.start(t); src.stop(t + 0.2);
  const o = AC.createOscillator(); o.type = 'square'; o.frequency.setValueAtTime(160, t);

 ("ref-05-kowloon-neon-night.png", "Neon Nights in Kowloon, Hong Kong (April 2012) - 7547589944.png", "https://commons.wikimedia.org/wiki/File:Neon_Nights_in_Kowloon,_Hong_Kong_(April_2012)_-_7547589944.png"),
 ("ref-06-temple-street-market.jpg", "Temple Street Night Market, Kowloon, Hong Kong 2.jpg", "https://commons.wikimedia.org/wiki/File:Temple_Street_Night_Market,_Kowloon,_Hong_Kong_2.jpg"),
]
prov = []
for local, title, page in items:
    url = "https://commons.wikimedia.org/wiki/Special:FilePath/" + urllib.parse.quote(title) + "?width=1280"
    dest = os.path.join(d, local)
    try:
        req = urllib.request.Request(url, headers={"User-Agent":"LanternDashResearch/1.0"})
        with urllib.request.urlopen(req, timeout=60) as r, open(dest,"wb") as f:
            f.write(r.read())
        print(local, os.path.getsize(dest))
        prov.append((local, page))
    except Exception as e:
        print("FAIL", local, e)
# Kenney CC0 top-down shooter sample
try:
    req = urllib.request.Request("https://kenney.nl/media/pages/assets/top-down-shooter/7922719534-1677694680/sample.png", headers={"User-Agent":"LanternDashResearch/1.0"})
    dest = os.path.join(d, "ref-07-kenney-topdown-sample.png")
    with urllib.request.urlopen(req, timeout=60) as r, open(dest,"wb") as f:
        f.write(r.read())
    print("ref-07-kenney-topdown-sample.png", os.path.getsize(dest))
    prov.append(("ref-07-kenney-topdown-sample.png","https://kenney.nl/assets/top-down-shooter (CC0)"))
except Exception as e:
    print("FAIL kenney", e)
with open(os.path.join(d,"PROVENANCE.tsv"),"w") as f:
    f.write("local_filename\tsource_url\tlicense_note\n")
    for local, page in prov:
        lic = "CC0" if "kenney" in local else "Wikimedia Commons (see source page for exact license, CC BY/SA family)"
        f.write(f"{local}\t{page}\t{lic}\n")
print("provenance written")
EOF

p='rustbelt-arena/game.js'
s=open(p).read()

# 1. MG occlusion: add solids/wall check before damage
old=""" spawnParticles(from,0xffe28a,2,2,.15,.18);
 if(best){damage(best,car.mgUp>0?9:6,car); car.special=Math.min(100,car.special+2);}"""
new=""" spawnParticles(from,0xffe28a,2,2,.15,.18);
 if(best){ // occlusion: blocked by props/walls?
  let blocked=false;
  for(const sl of solids){ // segment-point distance from muzzle to target
   const px=best.x-car.x,pz=best.z-car.z,L2=px*px+pz*pz;
   const t=L2>0?clamp(((sl.x-car.x)*px+(sl.z-car.z)*pz)/L2,0,1):0;
   const cx=car.x+px*t,cz=car.z+pz*t;
   if(Math.hypot(sl.x-cx,sl.z-cz)<sl.r*.9){blocked=true;break;}
  }
  if(!blocked){damage(best,car.mgUp>0?9:6,car); car.special=Math.min(100,car.special+2);}
  else spawnParticles(new THREE.Vector3((car.x+best.x)/2,1.6,(car.z+best.z)/2),0x888888,3,5,.25,.25);
 }"""
assert old in s; s=s.replace(old,new)

# 2. gamepad dt fix: pollGamepad(dt) uses dt for drive
old=""" drive(player,{throttle:clamp(thr*1.4,-1,1)+(rt?0.4:0),steer:-ax,brake:gp.buttons[2]?.pressed,turbo:gp.buttons[5]?.pressed},0); // steering overlay via integrate? apply direct:"""
new=""" drive(player,{throttle:clamp(thr*1.4,-1,1)+(rt?0.4:0),steer:-ax,brake:gp.buttons[2]?.pressed,turbo:gp.buttons[5]?.pressed},dt);"""
assert old in s; s=s.replace(old,new)

# 3. pause: silence engine + autpause on hidden
old="""function togglePause(){ if(state==='play'){state='pause';} else if(state==='pause'){state='play';} syncScreens(); }"""
new="""function togglePause(){ if(state==='play'){state='pause';
  if(AudioSys.engineGain)AudioSys.engineGain.gain.value=0; }
 else if(state==='pause'){state='play';} syncScreens(); }
document.addEventListener('visibilitychange',()=>{ if(document.hidden&&state==='play')togglePause(); });
addEventListener('blur',()=>{ if(state==='play')togglePause(); });"""
assert old in s; s=s.replace(old,new)

# 4. decisive timeout: winner = highest total hp among alive; sudden death stronger
old=""" matchT-=dt; if(matchT<=0){ // sudden death → highest hp wins edge
  for(const c of cars)if(c.alive)damage(c,4*dt,null);
  if(Math.ceil(matchT)!==Math.ceil(matchT+dt))toast('☠ SUDDEN DEATH ☠');
 }"""
new=""" matchT-=dt; if(matchT<=0){
  matchT=0;
  for(const c of cars)if(c.alive){ c.hp-=14*dt; if(c.hp<=0)kill(c,null); }
  if(!state||state==='play')toast('☠ SUDDEN DEATH ☠');
  const alive=cars.filter(c=>c.alive);
  if(alive.length<=1||matchT<=0&&cars.filter(c=>c.alive&&c.hp>0).length>=1){
   const scored=[...cars].filter(c=>c.alive).sort((a,b)=>b.hp-a.hp);
   if(scored.length){ const champ=scored[0];
    if(state==='play')endMatch(champ===player,`Time! ${champ.name} holds the most hull.`);
   } else if(state==='play')endMatch(false,'Mutual annihilation.');
  }
 }"""
assert old in s; s=s.replace(old,new)

# 5. clearWorld idempotent: rebuild arena fully
old=""" for(let i=solids.length-1;i>=0;i--)if(solids[i].barrel){scene.remove(solids[i].mesh);solids.splice(i,1);}"""
new=""" buildArena(); // tear down + rebuild ALL destructibles so REMATCH is identical"""
assert old in s; s=s.replace(old,new)


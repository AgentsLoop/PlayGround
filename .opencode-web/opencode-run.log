:root {
  --bg0: #1a1040;
  --bg1: #3b1d6e;
  --panel: rgba(20, 12, 46, 0.82);
  --neon-pink: #ff4ecd;
  --neon-cyan: #39e6ff;
  --neon-yellow: #ffd23f;
  --neon-green: #5dff8f;
  --ink: #f4f1ff;
  --muted: #b9aef5;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  min-height: 100%;
  background:
    radial-gradient(1200px 600px at 20% -10%, #6d28d9 0%, transparent 60%),
    radial-gradient(1000px 500px at 90% 0%, #db2777 0%, transparent 55%),
    linear-gradient(180deg, var(--bg0), var(--bg1) 60%, #0e2a5e);
  color: var(--ink);
  font-family: "Trebuchet MS", "Segoe UI", Verdana, system-ui, sans-serif;
  -webkit-tap-highlight-color: transparent;
}

#wrap {
  max-width: 560px;
  margin: 0 auto;
  padding: 10px 12px 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 100vh;
}

#topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-weight: 900;
  letter-spacing: 2px;
  font-size: 20px;
  text-shadow: 0 0 12px var(--neon-cyan), 0 2px 0 #000;
}
.logo span { color: var(--neon-yellow); text-shadow: 0 0 12px var(--neon-pink), 0 2px 0 #000; }

.top-links { display: flex; gap: 8px; }
.chip {
  border: 2px solid rgba(255,255,255,0.25);
  background: rgba(255,255,255,0.08);
  color: #fff;
  border-radius: 999px;
  width: 38px; height: 38px;
  font-size: 18px;
  cursor: pointer;
}
.chip:hover { background: rgba(255,255,255,0.18); }

#stage {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  border: 3px solid rgba(57, 230, 255, 0.55);
  box-shadow: 0 0 0 3px rgba(255, 78, 205, 0.35), 0 0 34px rgba(57, 230, 255, 0.35), 0 18px 50px rgba(0,0,0,0.45);
  background: #12082e;
  touch-action: none;
  user-select: none;
}

#game {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 480 / 720;
  cursor: ew-resize;
}

#hud {
  position: absolute;
  top: 0; left: 0; right: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10px;
  pointer-events: none;
  gap: 8px;
}
.hud-left, .hud-right { display: flex; flex-direction: column; gap: 6px; }
.hud-right { align-items: flex-end; }
.hud-pill {
  background: var(--panel);
  border: 2px solid rgba(57,230,255,0.5);
  border-radius: 999px;
  padding: 5px 12px;
  font-size: 15px;
  text-shadow: 0 0 8px rgba(57,230,255,0.8);
  white-space: nowrap;
}
.hud-pill.small { font-size: 12px; }
.hud-pill b { color: var(--neon-yellow); }
#timePill.danger { border-color: #ff5470; animation: pulse 0.6s infinite alternate; }
@keyframes pulse { from { transform: scale(1); } to { transform: scale(1.08); } }
.hearts { letter-spacing: 2px; }
.hud-center { flex: 1; text-align: center; padding-top: 4px; }
#combo {
  display: inline-block;
  background: linear-gradient(90deg, #ff4ecd, #ffd23f);
  color: #23113f;
  font-weight: 900;
  border-radius: 999px;
  padding: 4px 12px;
  font-size: 14px;
  animation: pulse 0.4s infinite alternate;
}

#toast {
  position: absolute;
  top: 64px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.65);
  border: 2px solid var(--neon-yellow);
  color: var(--neon-yellow);
  padding: 6px 16px;
  border-radius: 999px;
  font-weight: 800;
  pointer-events: none;
  transition: opacity 0.3s;
}

.overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 5, 28, 0.72);
  backdrop-filter: blur(3px);
  padding: 18px;
  z-index: 5;
}
.hidden { display: none !important; }

.card {
  background: linear-gradient(180deg, rgba(46,24,104,0.97), rgba(20,10,48,0.97));
  border: 3px solid var(--neon-pink);
  border-radius: 20px;
  box-shadow: 0 0 30px rgba(255,78,205,0.45);
  padding: 22px 22px 18px;
  text-align: center;
  max-width: 360px;
  width: 100%;
}
.card.small { text-align: left; }
.card.small h2 { text-align: center; margin: 0 0 8px; }
.card.small ul { padding-left: 20px; line-height: 1.7; }
.kite { font-size: 46px; filter: drop-shadow(0 0 10px var(--neon-cyan)); }
.card h1 {
  margin: 6px 0 4px;
  font-size: 40px;
  line-height: 0.95;
  letter-spacing: 2px;
  color: var(--neon-cyan);
  text-shadow: 0 0 16px rgba(57,230,255,0.9), 0 3px 0 #000;
}
.card h1 span { color: var(--neon-yellow); text-shadow: 0 0 16px rgba(255,210,63,0.9), 0 3px 0 #000; }
.tag { color: var(--muted); margin: 0 0 12px; }
.rules {
  display: grid;
  gap: 6px;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 12px;
  padding: 10px;
  font-size: 14px;
  margin-bottom: 10px;
}
.controls-hint { color: var(--muted); font-size: 13px; margin: 8px 0; }

.big-btn {
  display: block;
  width: 100%;
  border: none;
  border-radius: 14px;
  padding: 14px;
  font-size: 19px;
  font-weight: 900;
  letter-spacing: 1px;
  color: #241040;
  background: linear-gradient(90deg, var(--neon-green), var(--neon-cyan) 55%, var(--neon-yellow));
  box-shadow: 0 6px 0 #0c5b6e, 0 0 22px rgba(57,230,255,0.6);
  cursor: pointer;
}
.big-btn:hover { filter: brightness(1.06); }
.big-btn:active { transform: translateY(3px); box-shadow: 0 2px 0 #0c5b6e; }

.best { margin-top: 8px; color: var(--muted); }
.best b, .stat b { color: var(--neon-yellow); }

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin: 10px 0;
}
.stat {
  background: rgba(0,0,0,0.35);
  border: 1px solid rgba(57,230,255,0.4);
  border-radius: 12px;
  padding: 8px;
  display: flex;
  flex-direction: column;
}
.stat span { font-size: 11px; letter-spacing: 2px; color: var(--muted); }
.stat b { font-size: 24px; }

#newBest {
  font-weight: 900;
  color: var(--neon-yellow);
  text-shadow: 0 0 12px rgba(255,210,63,0.9);
  margin-bottom: 8px;
  animation: pulse 0.5s infinite alternate;
}

#foot {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 12px;
}
#foot code { color: var(--neon-green); }

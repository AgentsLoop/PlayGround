const puppeteer = require('puppeteer-core');
(async()=>{
  const browser = await puppeteer.launch({executablePath:'/usr/bin/google-chrome', args:['--no-sandbox','--disable-gpu']});
  const page = await browser.newPage();
  await page.goto('file:///home/runner/work/PlayGround/PlayGround/neon-parcel-dodge.html');
  await page.waitForSelector('#startBtn');
  // start game
  await page.click('#startBtn');
  await new Promise(r=>setTimeout(r,500));
  let s1 = await page.evaluate(()=>({state:window.__game.state, score:window.__game.score, lives:window.__game.lives, items:window.__game.items.length}));
  console.log('after-start:', JSON.stringify(s1));
  // move left/right
  const x0 = await page.evaluate(()=>window.__game.player.x);
  await page.keyboard.down('ArrowRight');
  await new Promise(r=>setTimeout(r,600));
  await page.keyboard.up('ArrowRight');
  const x1 = await page.evaluate(()=>window.__game.player.x);
  await page.keyboard.down('ArrowLeft');
  await new Promise(r=>setTimeout(r,600));
  await page.keyboard.up('ArrowLeft');
  const x2 = await page.evaluate(()=>window.__game.player.x);
  console.log('movement:', JSON.stringify({x0,x1,x2}));
  // force a catch: place parcel on player
  let catchTest = await page.evaluate(()=>{
    const g=window.__game; g.score=0;
    g.items.push({type:'parcel',x:g.player.x,y:640-56-10,w:34,h:26,vy:100,rot:0,vr:0,sway:0,swayF:1,t:0});
    return 'injected';
  });
  await new Promise(r=>setTimeout(r,400));
  let s2 = await page.evaluate(()=>({score:window.__game.score, caught:window.__game.caught, lives:window.__game.lives, state:window.__game.state}));
  console.log('after-catch:', JSON.stringify(s2));
  // force hazard hit
  await page.evaluate(()=>{
    const g=window.__game;
    g.items.push({type:'hazard',x:g.player.x,y:640-56-10,w:34,h:26,vy:100,rot:0,vr:0,sway:0,swayF:1,t:0});
  });
  await new Promise(r=>setTimeout(r,400));
  let s3 = await page.evaluate(()=>({score:window.__game.score, lives:window.__game.lives, hits:window.__game.hits}));
  console.log('after-hazard:', JSON.stringify(s3));
  // difficulty: score up -> level up
  let s4 = await page.evaluate(()=>{ window.__game.score=300; return window.__game.score; });
  await new Promise(r=>setTimeout(r,400));
  let s5 = await page.evaluate(()=>({level:window.__game.level}));
  console.log('difficulty:', JSON.stringify(s5));
  // game over + restart
  await page.evaluate(()=>{ window.__game.lives=1; window.__game.items.push({type:'hazard',x:window.__game.player.x,y:640-56-10,w:34,h:26,vy:100,rot:0,vr:0,sway:0,swayF:1,t:0}); });
  await new Promise(r=>setTimeout(r,500));
  let s6 = await page.evaluate(()=>({state:window.__game.state, overVisible:!document.getElementById('overScreen').hidden}));
  console.log('gameover:', JSON.stringify(s6));
  await page.click('#restartBtn');
  await new Promise(r=>setTimeout(r,400));
  let s7 = await page.evaluate(()=>({state:window.__game.state, score:window.__game.score, lives:window.__game.lives}));
  console.log('restart:', JSON.stringify(s7));
  await page.screenshot({path:'/tmp/opencode/neon-verify.png'});
  console.log('screenshot ok');
  await browser.close();
})().catch(e=>{console.error('FAIL',e); process.exit(1);});

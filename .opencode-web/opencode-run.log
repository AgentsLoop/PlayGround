import puppeteer from "puppeteer-core";
const browser = await puppeteer.launch({ executablePath: "/usr/bin/chromium", args: ["--no-sandbox","--disable-gpu"], headless: true });
const page = await browser.newPage();
await page.setViewport({ width: 560, height: 900 });
const errors = [];
page.on("pageerror", e => errors.push(e.message));
await page.goto("http://localhost:3000/", { waitUntil: "networkidle0" });
await new Promise(r => setTimeout(r, 600));
await page.evaluate(() => document.getElementById("startBtn").click());
// suicide run: hug the left wall
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keydown", { key: "ArrowLeft" })));
await new Promise(r => setTimeout(r, 9000));
await page.evaluate(() => window.dispatchEvent(new KeyboardEvent("keyup", { key: "ArrowLeft" })));
await new Promise(r => setTimeout(r, 1500));
const st = await page.evaluate(() => ({
  overVisible: !document.getElementById("overScreen").classList.contains("hidden"),
  title: document.getElementById("overTitle").textContent,
  score: document.getElementById("finalScore").textContent,
  lives: document.getElementById("lives").textContent,
}));
console.log("OVER:", JSON.stringify(st));
await page.screenshot({ path: "screenshots/gameover.png" });
// restart flow
await page.evaluate(() => document.getElementById("retryBtn").click());
await new Promise(r => setTimeout(r, 1200));
const re = await page.evaluate(() => ({
  overHidden: document.getElementById("overScreen").classList.contains("hidden"),
  hudVisible: !document.getElementById("hud").classList.contains("hidden"),
  time: document.getElementById("time").textContent,
}));
console.log("RESTART:", JSON.stringify(re));
console.log("ERRORS:", errors.length ? errors.join("|") : "none");
await browser.close();

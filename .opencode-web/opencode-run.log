secureContext=true
navigator.gpu=present</pre>
<script>
const out=[];
function log(o){out.push(typeof o==='string'?o:JSON.stringify(o));document.getElementById("out").textContent=out.join("\n");}
(async()=>{
try{
log("userAgent="+navigator.userAgent);
log("secureContext="+window.isSecureContext);
log("navigator.gpu="+(navigator.gpu?"present":"ABSENT"));
if(!navigator.gpu){log("RESULT: NO-WEBGPU");document.title="DONE";return;}
const withTimeout=(p,ms,tag)=>Promise.race([p,new Promise((_,rej)=>setTimeout(()=>rej(new Error(tag+"-timeout-"+ms)),ms))]);
try{
  const adapter=await withTimeout(navigator.gpu.requestAdapter({powerPreference:"high-performance"}),8000,"requestAdapter");
  log("requestAdapter(high-performance)="+(adapter?"OK":"NULL"));
  if(!adapter){log("RESULT: ADAPTER-NULL");document.title="DONE";return;}
  const info=adapter.info||null;
  log("adapterInfo="+JSON.stringify(info));
  if(info) log("isFallbackAdapter="+info.isFallbackAdapter);
  try{log("features-n="+(adapter.features?adapter.features.size:"n/a"));log("limits.maxTextureDimension2D="+(adapter.limits?adapter.limits.maxTextureDimension2D:"n/a"));}catch(e){log("feat ex "+e);}
  try{
    const device=await withTimeout(adapter.requestDevice(),8000,"requestDevice");
    log("requestDevice=OK");
    const buf=device.createBuffer({size:64,usage:GPUBufferUsage.COPY_DST|GPUBufferUsage.MAP_READ});
    const enc=device.createCommandEncoder();device.queue.submit([enc.finish()]);
    log("queueSubmit=OK");log("RESULT: WEBGPU-USABLE");
  }catch(e){log("device/queue EX "+(e&&e.message||e));log("RESULT: WEBGPU-ADAPTER-ONLY");}
}catch(e){log("adapter EX "+(e&&e.message||e));log("RESULT: WEBGPU-ERROR");}
}catch(e){log("FATAL "+e);}
document.title="DONE";
})();
</script>
</body

const fs=require('fs'),html=fs.readFileSync('lantern-lake-dash/index.html','utf8');
const js=html.match(/<script>([\s\S]*)<\/script>/)[1];
// minimal browser stubs
function mkEl(){return {textContent:'',innerHTML:'',style:{},classList:{add(){},remove(){},toggle(){}},onclick:null,setAttribute(){},getContext:undefined};}
const els={};
global.document={getElementById:id=>els[id]||(els[id]=mkEl())};
let rafCb=null;
global.requestAnimationFrame=cb=>{rafCb=cb;return 1;};
const ctxStub=new Proxy({},{get:(t,k)=>{if(k==='createLinearGradient'||k==='createRadialGradient')return()=>({addColorStop(){}});return()=>{};},set:()=>true});
global.matchMedia=()=>({matches:false});
global.addEventListener=()=>{};
global.localStorage={getItem:()=>'0',setItem(){}};
global.location={search:''};
global.window={AudioContext:null};
eval(js);
// window.__lld exposed? in eval scope __lld is on window
const api=global.window.__lld;
const out=[];
function ck(n,c){out.push((c?'PASS':'FAIL')+' '+n); if(!c)process.exitCode=1;}
api.newGame();
ck('starts playing',api.state==='playing');
ck('lanterns spawn >=8',api.lanterns().length>=8);
ck('boat exists',!!api.boat()&&api.boat().x>0);
const b0={...api.boat()};
// movement: simulate keys via internal? keys not exposed; test pointer + direct boat velocity
const boat=api.boat(); boat.vx=200; 
// collection: teleport boat onto lantern
const L=api.lanterns()[0]; boat.x=L.x; boat.y=L.y;
const s0=api.score;
// need to run step: step is internal, but collide runs inside step via rAF. Call rafCb manually with timestamps
let ts=0;
function frames(n){for(let i=0;i<n;i++){ts+=16; rafCb(ts);}}
frames(5);
ck('collect scores +10',api.score>=s0+10);
ck('collected increments',api.collected>=1);
// rock hit: teleport onto rock? need rocks access — not exposed; test via lives not increasing spontaneously
ck('lives still valid',api.lives>=1&&api.lives<=3);
// timer decreases
const t0=api.timeLeft; frames(60); ck('timer ticks down',api.timeLeft<t0);
// pause/resume
api.togglePause(); ck('pause works',api.state==='paused');
api.togglePause(); ck('resume works',api.state==='playing');
// restart recovery (repeated input)
api.newGame(); api.newGame(); ck('double restart safe',api.state==='playing'&&api.score===0&&api.collected===0);
// loss by timer: force timeLeft low via repeated frames? set via boat? timeLeft not settable; run many frames (90s*60=5400 frames) — run 6000
frames(6000); ck('timer expiry ends game',api.state==='lost');
// win path: restart, force collect quota then dock
api.newGame();
for(let k=0;k<8;k++){const bl=api.boat(),ll=api.lanterns()[0]; if(!ll)break; bl.x=ll.x; bl.y=ll.y; bl.vx=0;bl.vy=0; frames(3);}
ck('quota reachable',api.collected>=8);
// dock at (W-110,H-140)=(850,460); teleport
{const bl=api.boat(); bl.x=850; bl.y=460; bl.vx=0;bl.vy=0; frames(5);}
ck('dock win with quota',api.state==='won');
console.log(out.join('\n'));

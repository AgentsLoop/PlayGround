   box-shadow:0 0 18px rgba(255,106,0,.55)}
-.btn.small{position:absolute;left:12px;bottom:12px;z-index:30;padding:6px 10px;font-size:14px}
+.btn.small{position:absolute;right:14px;bottom:170px;z-index:30;padding:6px 10px;font-size:14px}
 .btn-row{display:flex;gap:10px;justify-content:center;margin-top:12px;flex-wrap:wrap}
 .fine{font-size:11px;color:#8a8272;font-family:monospace;margin-top:12px}
 .error{color:#ff8a80;font-family:monospace}
 #end-stats{font-family:monospace;color:var(--dim);margin:10px 0}


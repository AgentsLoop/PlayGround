// ---- TEST DRIVER ----
let pass=0, fail=0;
const ok=(c,m)=>{ c?(pass++,console.log('PASS',m)):(fail++,console.log('FAIL',m)); };
// boot ran loop once via raf; force match start
mode='1P'; p1sel=0; beginFight();
ok(state==='intro','beginFight -> intro, round '+round);
startRound.__proto__; // noop
// simulate round 1 KO: jump to fight, flatten P2
state='fight'; fighters[1].hp=0; checkKO();
ok(state==='roundEnd'&&wins[0]===1,'R1 KO -> roundEnd, P1 wins=1 (got '+wins+','+state+')');
// double-resolution attempt must be ignored
const w0=wins[0]; endRound(fighters[0],fighters[1],false); checkKO(); timeout();
ok(wins[0]===w0,'double endRound/timeout/checkKO ignored');
resolveRoundEnd();
ok(state==='intro'&&round===2,'resolve -> round 2 intro');
// round 2: match-point KO -> finish flow
state='fight'; fighters[1].hp=0; checkKO();
ok(state==='finish'&&finishWinner===fighters[0],'match-point KO -> FINISH HIM, winner stored');
// stray-bolt immunity: harmless projectiles must not alter outcome
projectiles.push({x:fighters[0].x,y:100,vx:0,dmg:999,owner:1,life:1.6,color:'#fff'});
updateProjectiles(0.5,true);
ok(fighters[0].hp>0,'harmless projectile in finish deals no damage');
// finisher resolves atomically
doFinisher(finishWinner,finishLoser);
ok(state==='roundEnd'&&roundSettled&&matchStats.finishers===1,'finisher -> roundEnd, counted once');
resolveRoundEnd();
ok(state==='over'&&wins[0]===2,'match ends 2-0, gameOver shown');
// rematch resets cleanly (no dangling state)
rematch();
ok(state==='intro'&&round===1&&wins[0]===0&&roundSettled===false,'rematch resets match');
// bolt cooldown charged on fire, not attempt
state='fight'; const f=fighters[0];
f.cool=0; f.boltCool=0; f.blocking=false; f.stun=0;
tryAttack(f,fighters[1],'bolt');
ok(f.boltCool===0,'bolt windup does not pre-charge cooldown');
spawnBolt(f);
ok(f.boltCool===2.2&&projectiles.length===1,'bolt fire charges cooldown + spawns');
console.log(`RESULT pass=${pass} fail=${fail}`);
if(fail) process.exit(1);
EOF

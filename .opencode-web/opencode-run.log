import { chromium } from 'playwright';
import { spawn } from 'child_process';
import fs from 'fs';

const server = spawn('python3', ['-m','http.server','8787'], {cwd:'/home/runner/work/PlayGround/PlayGround', stdio:'ignore'});
await new Promise(r=>setTimeout(r,1500));
const browser = await chromium.launch({ args: ['--no-sandbox','--disable-setuid-sandbox'] });
const context = await browser.newContext({ viewport:{width:1280,height:800}, deviceScaleFactor:1 });
const page = await context.newPage();
page.on('console', m=> console.log('console:', m.text()));
await page.goto('http://127.0.0.1:8787/index.html', { waitUntil:'domcontentloaded' });
await page.waitForTimeout(800);
await page.screenshot({ path: '/tmp/neon_start.png', fullPage:false });
console.log('start screenshot done');

// click start
await page.click('#startBtn');
await page.waitForTimeout(600);
await page.screenshot({ path: '/tmp/neon_playing.png' });
console.log('playing screenshot done');

// simulate a few seconds of play - check floatingTexts after manually triggering a catch via JS
await page.evaluate(()=>{
  const g=window.__game;
  // inject a buoy directly above boat for guaranteed catch
  const boat=g.boat;
  g.objects.push({x: boat.x+boat.w/2-16, y: boat.y - 30, w:32,h:32, type:'buoy', pts:30, color:'#00f0ff', vy:200, rot:0, rotV:0, glow:'#00f0ff'});
});
await page.waitForTimeout(1200);
await page.screenshot({ path: '/tmp/neon_catch.png' });
console.log('catch screenshot done - floatingTexts', await page.evaluate(()=> window.__game.floatingTexts.length));

// pause test
await page.keyboard.press('p');
await page.waitForTimeout(400);
await page.screenshot({ path: '/tmp/neon_pause.png' });
console.log('pause screenshot done', await page.evaluate(()=> window.__game.state));

await page.keyboard.press('p');
await page.waitForTimeout(300);

// force game over by draining lives
await page.evaluate(()=>{
  // hit 3 mines quickly
  const g=window.__game;
  for(let i=0;i<3;i++) g.objects.push({x:g.boat.x+g.boat.w/2-17, y:g.boat.y-10, w:34,h:34, type:'mine', vy:200, rot:0, rotV:0, glow:'#ff2a6d'});
});
await page.waitForTimeout(800);
await page.screenshot({ path: '/tmp/neon_gameover.png' });
console.log('gameover state', await page.evaluate(()=> ({state:window.__game.state, score:window.__game.score, lives:window.__game.lives, hs: localStorage.getItem('neonHarborHigh')} )));

// responsive check mobile
const mobileContext = await browser.newContext({ viewport:{width:390,height:844}, deviceScaleFactor:2 });
const mpage = await mobileContext.newPage();
await mpage.goto('http://127.0.0.1:8787/index.html');
await mpage.waitForTimeout(600);
await mpage.screenshot({ path: '/tmp/neon_mobile.png' });
console.log('mobile screenshot done');

await browser.close();
server.kill();
console.log('done');

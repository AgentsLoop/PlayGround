    return {
      canvas:!!c, ctx:!!c.getContext('2d'),
      startVisible: s && !s.classList.contains('hidden'),
      gameOverHidden: g && g.classList.contains('hidden'),
      flash: !!flash,
      gridAfter: getComputedStyle(document.querySelector('.canvas-wrap'),'::after').opacity,
      state: window.__neonGame ? window.__neonGame.getState() : null,
      dropsBefore: window.__neonGame ? window.__neonGame.getState().drops : -1
    };
  });
  console.log(JSON.stringify(info,null,2));
  // start game and test hitStop differentiation
  await page.click('#startBtn');
  await page.waitForTimeout(800);
  const after=await page.evaluate(()=>window.__neonGame.getState());
  console.log('afterStart',JSON.stringify(after));
  // test keyboard movement
  await page.keyboard.press('ArrowRight');
  await page.waitForTimeout(200);
  await page.keyboard.up('ArrowRight');
  // trigger a quick error check
  console.log('errs',errs);
  await browser.close();
})().catch(e=>{console.error(e);process.exit(1)});

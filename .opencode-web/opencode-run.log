from playwright.sync_api import sync_playwright
import time

errors = []
with sync_playwright() as p:
    b = p.chromium.launch(executable_path="/usr/bin/chromium", args=["--no-sandbox"])
    pg = b.new_page(viewport={"width":1000,"height":760})
    pg.on("console", lambda m: errors.append(m.text) if m.type=="error" else None)
    pg.on("pageerror", lambda e: errors.append(str(e)))
    pg.goto("http://localhost:8765/index.html")
    pg.wait_for_timeout(800)
    # menu visible?
    assert pg.is_visible("#overlay"), "overlay should be visible in menu"
    print("PASS menu overlay visible")
    # start via Enter
    pg.keyboard.press("Enter")
    pg.wait_for_timeout(500)
    assert not pg.is_visible("#overlay"), "overlay should hide after Enter"
    print("PASS start via Enter")
    # movement test
    x0 = pg.evaluate("window.__NPP.player.x")
    y0 = pg.evaluate("window.__NPP.player.y")
    pg.keyboard.down("d")
    pg.wait_for_timeout(600)
    pg.keyboard.up("d")
    x1 = pg.evaluate("window.__NPP.player.x")
    assert x1 > x0+20, f"player should move right {x0}->{x1}"
    print(f"PASS movement right {x0:.1f}->{x1:.1f}")
    # WASD up
    pg.keyboard.down("w"); pg.wait_for_timeout(400); pg.keyboard.up("w")
    y1 = pg.evaluate("window.__NPP.player.y")
    assert y1 < y0, f"player should move up {y0}->{y1}"
    print(f"PASS movement up {y0:.1f}->{y1:.1f}")
    # pickup test: teleport onto first parcel
    pg.evaluate("""()=>{
      const {G, player} = window.__NPP;
      const p = G.parcels[0];
      player.x = p.x; player.y = p.y; player.vx=0; player.vy=0;
    }""")
    pg.wait_for_timeout(400)
    carry = pg.evaluate("window.__NPP.G.carry")
    assert carry is not None, "pickup failed"
    print(f"PASS pickup carry={carry}")
    hud_carry = pg.inner_text("#carryLabel")
    assert carry in hud_carry, f"HUD carry mismatch {hud_carry}"
    print("PASS HUD carry shows")
    # delivery test: teleport to matching drop zone
    score0 = pg.evaluate("window.__NPP.G.score")
    del0 = pg.evaluate("window.__NPP.G.delivered")
    pg.evaluate("""()=>{
      const {G, player} = window.__NPP;
      const zones = [{"color":"MAGENTA","x":100,"y":560,"w":110,"h":26},{"color":"YELLOW","x":425,"y":560,"w":110,"h":26},{"color":"LIME","x":750,"y":560,"w":110,"h":26}];
      const z = zones.find(z=>z.color===G.carry);
      player.x = z.x+z.w/2; player.y = z.y-10; player.vx=0; player.vy=0;
    }""")
    pg.wait_for_timeout(500)
    score1 = pg.evaluate("window.__NPP.G.score")
    del1 = pg.evaluate("window.__NPP.G.delivered")
    assert score1 == score0+100, f"score {score0}->{score1}"
    assert del1 == del0+1, f"delivered {del0}->{del1}"
    print(f"PASS delivery score {score0}->{score1} delivered {del1}")
    # drone hit test
    lives0 = pg.evaluate("window.__NPP.G.lives")
    pg.evaluate("""()=>{
      const {G, player} = window.__NPP;
      player.inv = 0;
      const d = G.drones[0];
      player.x = d.x; player.y = d.y;
    }""")
    pg.wait_for_timeout(400)
    lives1 = pg.evaluate("window.__NPP.G.lives")
    assert lives1 == lives0-1, f"lives {lives0}->{lives1}"
    print(f"PASS drone hit lives {lives0}->{lives1}")
    # restart via R
    pg.keyboard.press("r")
    pg.wait_for_timeout(400)
    rs = pg.evaluate("({s:window.__NPP.G.score,l:window.__NPP.G.lives,t:window.__NPP.G.time})")
    assert rs["s"]==0 and rs["l"]==3, f"restart failed {rs}"
    print(f"PASS restart R {rs}")
    # pause via P
    pg.keyboard.press("p")
    pg.wait_for_timeout(300)
    mode = pg.evaluate("window.__NPP.G.mode")
    assert mode=="pause", f"pause failed {mode}"
    assert pg.is_visible("#overlay"), "pause overlay visible"
    print("PASS pause")
    pg.keyboard.press("p")
    pg.wait_for_timeout(300)
    assert pg.evaluate("window.__NPP.G.mode")=="play"
    print("PASS resume")
    # timer ticking?
    t0 = pg.evaluate("window.__NPP.G.time")
    pg.wait_for_timeout(1000)
    t1 = pg.evaluate("window.__NPP.G.time")
    assert t1 < t0, f"time not ticking {t0}->{t1}"
    print(f"PASS timer {t0:.1f}->{t1:.1f}")
    # gameplay screenshot
    pg.screenshot(path="/tmp/opencode/shot-action.png")
    # force game over via time
    pg.evaluate("window.__NPP.G.time=0.5")
    pg.wait_for_timeout(800)
    assert pg.evaluate("window.__NPP.G.mode")=="over"
    assert pg.is_visible("#overlay")
    print("PASS game over on timeout")
    pg.screenshot(path="/tmp/opencode/shot-over.png")
    b.close()

print("CONSOLE ERRORS:", errors if errors else "none")
assert not errors, f"console errors: {errors}"
print("ALL TESTS PASSED")

const page = await browser.newPage();
await page.setViewport({ width: 560, height: 900 });
const errors = [];
page.on("pageerror", e => errors.push("pageerror: " + e.message));
page.on("console", m => { if (m.type() === "error") errors.push("console: " + m.text()); });
await page.goto("http://localhost:3000/", { waitUntil: "networkidle0" });
await new Promise(r => setTimeout(r, 1200));
// click start
await page.click("#startBtn");
await new Promise(r => setTimeout(r, 2500));
// steer a bit
await page.keyboard.down("ArrowLeft");
await new Promise(r => setTimeout(r, 500));
await page.keyboard.up("ArrowLeft");
await page.keyboard.down("ArrowRight");
await new Promise(r => setTimeout(r, 700));
await page.keyboard.up("ArrowRight");
await new Promise(r => setTimeout(r, 1500));
const hud = await page.evaluate(() => ({
  score: document.getElementById("score")?.textContent,
  time: document.getElementById("time")?.textContent,
  level: document.getElementById("level")?.textContent,
  hudHidden: document.getElementById("hud").classList.contains("hidden"),
  startHidden: document.getElementById("startScreen").classList.contains("hidden"),
}));
console.log("HUD:", JSON.stringify(hud));
await page.screenshot({ path: "screenshots/gameplay.png" });
// test game over path: force crash via JS? verify restart flow exists
const flow = await page.evaluate(() => ({
  hasRetry: !!document.getElementById("retryBtn"),
  hasStart: !!document.getElementById("startBtn"),
  canvas: (() => { const c = document.getElementById("game"); return { w: c.width, h: c.height }; })(),
}));
console.log("FLOW:", JSON.stringify(flow));
console.log("ERRORS:", errors.length ? errors.join(" | ") : "none");
await browser.close();

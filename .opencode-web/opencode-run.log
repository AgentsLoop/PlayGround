const { chromium } = require('playwright');
(async()=>{
  const browser = await chromium.launch({args:['--no-sandbox']});
  const check = async (width, height, label) => {
    const ctx = await browser.newContext({viewport:{width,height}});
    const page = await ctx.newPage();
    await page.goto('http://127.0.0.1:8000/index.html', {waitUntil:'domcontentloaded'});
    await page.waitForTimeout(600);
    // check key elements
    const hasCanvas = await page.$('#game') !== null;
    const hasScore = await page.$('#score') !== null;
    const hasLives = await page.$('#lives') !== null;
    const hasControls = await page.$('#leftBtn') !== null;
    console.log(`${label} ${width}x${height}: canvas=${hasCanvas} score=${hasScore} lives=${hasLives} touch=${hasControls}`);
    await page.evaluate(()=> window.__game.startGame());
    await page.waitForTimeout(700);
    // simulate catch by forcing star position over basket
    const beforeScore = await page.evaluate(()=> window.__game.score);
    // let stars spawn naturally, test basket movement
    await page.keyboard.down('ArrowRight');
    await page.waitForTimeout(300);
    await page.keyboard.up('ArrowRight');
    const bx = await page.evaluate(()=> ({x: window.__game ? 'ok':'no'}));
    await page.screenshot({path:`/tmp/verify-${label}.png`});
    console.log(`screenshot ${label} saved`);
    await ctx.close();
  };
  await check(1280,800,'desktop');
  await check(390,844,'mobile');
  await check(768,1024,'tablet');
  await browser.close();
  console.log('verify done');
})();

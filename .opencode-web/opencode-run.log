from playwright.sync_api import sync_playwright
import time, os
os.makedirs("screenshots", exist_ok=True)
with sync_playwright() as p:
    browser = p.chromium.launch()
    for name, vw, vh in [("final-start", 860, 900), ("final-gameplay", 860, 900), ("final-action", 460, 900)]:
        page = browser.new_page(viewport={"width": vw, "height": vh})
        page.goto("http://127.0.0.1:8000/index.html", wait_until="networkidle")
        time.sleep(0.6)
        page.screenshot(path=f"screenshots/{name}.png", full_page=True)
        print(f"shot {name} {vw}x{vh}")
        if name=="final-start":
            # start game and capture gameplay
            page.click("#startBtn")
            page.wait_for_timeout(1400)
            page.screenshot(path="screenshots/final-gameplay.png", full_page=True)
            print("shot gameplay after start")
            # do one sort for action
            page.wait_for_timeout(300)
            # try keyboard 1
            page.keyboard.press("1")
            page.wait_for_timeout(600)
            page.screenshot(path="screenshots/final-action.png", full_page=True)
            print("shot action")
            break
    # also capture mobile
    page = browser.new_page(viewport={"width": 380, "height": 900})
    page.goto("http://127.0.0.1:8000/index.html", wait_until="networkidle")
    page.screenshot(path="screenshots/final-mobile.png", full_page=True)
    print("shot mobile")
    browser.close()

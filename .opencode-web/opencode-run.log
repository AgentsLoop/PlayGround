  console.log('screenshot saved');
  // second screenshot with filter
  await page.click('a[href="#/active"]');
  await page.waitForTimeout(300);
  await page.screenshot({path:'screenshots/final-todo-active.png', fullPage:true});
  await page.screenshot({path:'project/screenshots/final-todo-active.png', fullPage:true});
  console.log('second screenshot saved');
  await browser.close();
  server.close();
})();

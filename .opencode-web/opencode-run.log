+// Tap-anywhere to play/restart — reduces friction to Flappy/Suika bar (critic fix)
+const shell=document.getElementById('shell');
+function handleShellTap(e){
+  if(e.target.closest('button')) return;
+  if(state==='start' || state==='over'){ restart(); e.preventDefault(); }
+  else if(state==='paused'){ setState('playing'); e.preventDefault(); }
+}
+shell.addEventListener('click', handleShellTap);
+shell.addEventListener('touchend', (e)=>{
+  // only hijack when not actively playing to avoid interfering with drag
+  if(state!=='playing'){ handleShellTap(e); }
+}, {passive:false});
+[startOverlay, endOverlay, pauseOverlay].forEach(el=>{
+  el.addEventListener('click', (e)=>{
+    if(e.target===el) handleShellTap(e);
+  });

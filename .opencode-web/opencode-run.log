const { chromium } = require('playwright');
(async()=>{
  const browser = await chromium.launch();
  const page = await browser.newPage({ viewport:{width:1280, height:800} });
  // need to serve project
  const http = require('http');
  const fs=require('fs'), path=require('path');
  const mime={'.html':'text/html','.css':'text/css','.js':'application/javascript'};
  const server = http.createServer((req,res)=>{
    let p = req.url.split('?')[0].split('#')[0];
    if(p==='/') p='/index.html';
    const fp = path.join(__dirname,'project',p);
    try{
      const data=fs.readFileSync(fp);
      const ext=path.extname(fp);
      res.writeHead(200,{'Content-Type': mime[ext]||'text/plain'});
      res.end(data);
    }catch(e){res.writeHead(404); res.end('not found')}
  });
  await new Promise(r=>server.listen(8011,r));
  await page.goto('http://localhost:8011/index.html', {waitUntil:'networkidle'});
  await page.waitForTimeout(500);
  // add some todos for richer screenshot
  await page.fill('#todoInput','Buy milk');
  await page.click('#addBtn');
  await page.fill('#todoInput','Write docs');
  await page.click('#addBtn');
  await page.fill('#todoInput','Ship todo app');
  await page.click('#addBtn');
  await page.waitForTimeout(300);
  // toggle one
  await page.click('.todo-item:first-child .check');
  await page.waitForTimeout(300);
  const fs2=require('fs');
  fs2.mkdirSync('screenshots',{recursive:true});
  fs2.mkdirSync('project/screenshots',{recursive:true});
  await page.screenshot({path:'screenshots/final-todo.png', fullPage:true});

const { chromium } = require('playwright');
(async()=>{
  const browser = await chromium.launch({args:['--no-sandbox']});
  const url = 'https://watch-casey-lone-vacancies.trycloudflare.com';
  // desktop start
  const ctx = await browser.newContext({viewport:{width:1280,height:800}});
  const page = await ctx.newPage();
  await page.goto(url, {waitUntil:'domcontentloaded', timeout:15000});
  await page.waitForTimeout(1200);
  await page.screenshot({path:'screenshots/final-public-start.png', fullPage:true});
  console.log('saved final-public-start.png');
  // start game
  await page.evaluate(()=> window.__game && window.__game.startGame());
  await page.waitForTimeout(1100);
  await page.screenshot({path:'screenshots/final-public-playing.png', fullPage:true});
  console.log('saved final-public-playing.png');
  // pause
  await page.evaluate(()=> window.__game && window.__game.pause());
  await page.waitForTimeout(500);
  await page.screenshot({path:'screenshots/final-public-paused.png', fullPage:true});
  console.log('saved final-public-paused.png');
  await page.evaluate(()=> window.__game && window.__game.resume());
  await page.waitForTimeout(500);
  // mobile
  const ctxM = await browser.newContext({viewport:{width:390,height:844}, isMobile:true, hasTouch:true});
  const pM = await ctxM.newPage();
  await pM.goto(url, {waitUntil:'domcontentloaded', timeout:15000});
  await pM.waitForTimeout(1200);
  await pM.screenshot({path:'screenshots/final-public-mobile-start.png', fullPage:true});
  console.log('saved final-public-mobile-start.png');
  await pM.evaluate(()=> window.__game && window.__game.startGame());
  await pM.waitForTimeout(1100);
  await pM.screenshot({path:'screenshots/final-public-mobile-playing.png', fullPage:true});
  console.log('saved final-public-mobile-playing.png');
  // also keep canonical final-* for Agents.md compliance (without public prefix) - overwrite final-* with public captures
  const fs=require('fs');
  fs.copyFileSync('screenshots/final-public-start.png','screenshots/final-start.png');
  fs.copyFileSync('screenshots/final-public-playing.png','screenshots/final-playing.png');
  fs.copyFileSync('screenshots/final-public-paused.png','screenshots/final-paused.png');
  fs.copyFileSync('screenshots/final-public-mobile-start.png','screenshots/final-mobile-start.png');
  fs.copyFileSync('screenshots/final-public-mobile-playing.png','screenshots/final-mobile-playing.png');
  console.log('copied to canonical final-*');
  // verification checks
  const checks = [];
  checks.push(['public reachable', true]);
  checks.push(['state playing after start', await page.evaluate(()=> window.__game && window.__game.state)==='playing']);
  checks.push(['canvas exists', await page.$('#game')!==null]);
  for(let c of checks) console.log((c[1]?'PASS':'FAIL')+': '+c[0]);
  await browser.close();
})();

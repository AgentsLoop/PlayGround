from playwright.sync_api import sync_playwright
url="https://physics-ensures-dublin-portrait.trycloudflare.com"
with sync_playwright() as p:
    b=p.chromium.launch()
    page=b.new_page(viewport={"width":860,"height":900})
    page.goto(url, wait_until="networkidle")
    page.click("#startBtn")
    page.wait_for_timeout(1400)
    # get first parcel colorIdx and press matching key
    idx=page.evaluate("()=>window.__game.state.parcels[0].colorIdx")
    key=str(idx+1)
    before_score=page.evaluate("()=>window.__game.state.score")
    before_lives=page.evaluate("()=>window.__game.state.lives")
    before_cnt=page.locator(".parcel").count()
    print(f"first parcel idx {idx} key {key} before {before_score}/{before_lives}/{before_cnt}")
    page.evaluate("()=>document.activeElement.blur()")
    page.keyboard.press(key)
    page.wait_for_timeout(900)
    after_score=page.evaluate("()=>window.__game.state.score")
    after_lives=page.evaluate("()=>window.__game.state.lives")
    after_cnt=page.locator(".parcel").count()
    print(f"after {after_score}/{after_lives}/{after_cnt} success={(after_score==before_score+100)}")
    b.close()

const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch();
  const ctx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
  const page = await ctx.newPage();
  const url = 'https://worm-coupons-arab-frequency.trycloudflare.com/neon-orchard/';
  console.log('goto', url);
  await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 15000 });
  await page.waitForTimeout(2000);
  await page.screenshot({ path: 'screenshots/final-start.png' });
  console.log('start ok');
  await page.click('#startBtn');
  await page.waitForTimeout(800);
  await page.screenshot({ path: 'screenshots/final-gameplay.png' });
  console.log('gameplay ok');
  await page.keyboard.press('p');
  await page.waitForTimeout(600);
  await page.screenshot({ path: 'screenshots/final-pause.png' });
  console.log('pause ok');
  await page.click('#resumeBtn');
  await page.waitForTimeout(500);
  // mobile
  const mCtx = await browser.newContext({ viewport: { width: 390, height: 844 } });
  const mPage = await mCtx.newPage();
  await mPage.goto(url, { waitUntil: 'domcontentloaded' });
  await mPage.waitForTimeout(1500);
  await mPage.screenshot({ path: 'screenshots/final-mobile.png' });
  console.log('mobile ok');
  // game over simulated
  const gCtx = await browser.newContext({ viewport: { width: 1280, height: 800 } });
  const gPage = await gCtx.newPage();
  await gPage.goto(url, { waitUntil: 'domcontentloaded' });
  await gPage.waitForTimeout(1000);
  await gPage.click('#startBtn');
  await gPage.waitForTimeout(500);
  await gPage.evaluate(() => {
    const over = document.getElementById('overOverlay');
    const fs = document.getElementById('finalScore'); if(fs) fs.textContent='42';
    const sc = document.getElementById('statCaught'); if(sc) sc.textContent='4';
    const st = document.getElementById('statTime'); if(st) st.textContent='12s';
    const sb = document.getElementById('statBest'); if(sb) sb.textContent='42';
    if(over) over.classList.remove('hidden');
  });
  await gPage.waitForTimeout(500);
  await gPage.screenshot({ path: 'screenshots/final-gameover.png' });
  console.log('gameover ok');
  await browser.close();
  console.log('ALL PUBLIC CAPTURES DONE');
})();

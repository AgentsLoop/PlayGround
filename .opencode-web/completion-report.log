const {chromium} = require('playwright');
(async()=>{
  const url = 'https://fashion-bicycle-head-parliamentary.trycloudflare.com';
  console.log('Testing public URL', url);
  const browser = await chromium.launch({args:['--no-sandbox']});
  const page = await browser.newPage();
  const errors=[];
  page.on('pageerror', e=> errors.push(e.message));
  page.on('console', m=> { if(m.type()==='error') errors.push(m.text()); });
  const resp = await page.goto(url, {waitUntil:'networkidle', timeout:30000});
  console.log('status', resp.status(), 'url', page.url());
  await page.waitForTimeout(1500);
  const dom = await page.evaluate(()=>{
    return {
      title: document.title,
      canvas: !!document.getElementById('gameCanvas'),
      scoreEl: !!document.getElementById('scoreEl'),
      startOverlayVisible: !document.getElementById('startOverlay').classList.contains('hidden'),
      neonGame: !!window.__neonGame,
      state: window.__neonGame ? window.__neonGame.getState() : null,
      canvasSize: (()=>{ const c=document.getElementById('gameCanvas'); return c? {w:c.width,h:c.height}:null})(),
      hitFlash: !!document.getElementById('hitFlash')
    };
  });
  console.log('DOM', JSON.stringify(dom,null,2));
  if(!dom.canvas) throw new Error('canvas missing');
  // start game
  await page.click('#startBtn');
  await page.waitForTimeout(900);
  const after = await page.evaluate(()=> window.__neonGame.getState());
  console.log('afterStart', after);
  if(!after.running) throw new Error('not running after start');
  // keyboard
  await page.keyboard.press('ArrowRight');
  await page.waitForTimeout(250);
  await page.keyboard.up('ArrowRight');
  console.log('keyboard ok');
  // pause
  await page.keyboard.press('p');
  await page.waitForTimeout(200);
  const paused = await page.evaluate(()=> window.__neonGame.getState());
  console.log('paused', paused);
  await page.keyboard.press('p');
  await page.waitForTimeout(200);
  // canvas render
  const dataLen = await page.evaluate(()=> document.getElementById('gameCanvas').toDataURL().length);
  console.log('canvas dataURL len', dataLen);
  if(dataLen < 1000) throw new Error('canvas empty');
  console.log('errors', errors);
  if(errors.length) throw new Error('errors: '+errors.join('; '));
  console.log('=== PUBLIC URL TESTS PASSED ===');
  await browser.close();
})().catch(e=>{ console.error('FAIL', e.message, e.stack); process.exit(1); });

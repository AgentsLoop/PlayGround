import { chromium } from 'playwright';
import { mkdirSync } from 'fs';
mkdirSync('screenshots', {recursive:true});
const url = 'https://hierarchy-cells-zoo-manufacture.trycloudflare.com';
const browser = await chromium.launch({args:['--no-sandbox']});
const context = await browser.newContext({viewport:{width:1280,height:800}});
const page = await context.newPage();
console.log('goto', url);
await page.goto(url, {waitUntil:'networkidle'});
await page.waitForTimeout(1500);
await page.screenshot({path:'screenshots/final-start.png', fullPage:true});
console.log('final-start');
await page.click('#playBtn');
await page.waitForTimeout(800);
await page.screenshot({path:'screenshots/final-playing.png', fullPage:true});
console.log('final-playing');
await page.waitForTimeout(1500);
await page.screenshot({path:'screenshots/final-gameplay.png', fullPage:true});
console.log('final-gameplay');
await page.keyboard.press('p');
await page.waitForTimeout(700);
await page.screenshot({path:'screenshots/final-paused.png', fullPage:true});
console.log('final-paused');
await page.keyboard.press('p');
await page.waitForTimeout(500);
// simulate gameover for final screenshot: show overlay via JS like before to get stats view
await page.evaluate(()=>{
  const el=document.getElementById('endOverlay');
  const startEl=document.getElementById('startOverlay');
  const pauseEl=document.getElementById('pauseOverlay');
  startEl.classList.add('hidden');
  pauseEl.classList.add('hidden');
  el.classList.remove('hidden');
  document.getElementById('endScore').textContent=document.getElementById('score').textContent || '42';
  document.getElementById('endMoths').textContent='7';
  document.getElementById('endHits').textContent='2';
});
await page.waitForTimeout(500);
await page.screenshot({path:'screenshots/final-gameover.png', fullPage:true});
console.log('final-gameover');
await page.setViewportSize({width:375,height:800});
await page.waitForTimeout(600);
// need to reset to start view for mobile? show start again
await page.evaluate(()=>{
  document.getElementById('endOverlay').classList.add('hidden');
  document.getElementById('startOverlay').classList.remove('hidden');
});
await page.waitForTimeout(400);
await page.screenshot({path:'screenshots/final-mobile.png', fullPage:true});
console.log('final-mobile');
await page.setViewportSize({width:1280,height:800});
await page.waitForTimeout(400);
await page.screenshot({path:'screenshots/final-responsive.png', fullPage:true});
console.log('final-responsive');
await browser.close();
console.log('DONE');

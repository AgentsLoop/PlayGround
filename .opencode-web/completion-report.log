const puppeteer = require('/tmp/pptr/node_modules/puppeteer-core');
const BASE='https://guys-guest-waters-tramadol.trycloudflare.com/';
(async()=>{
 const browser = await puppeteer.launch({executablePath:'/usr/bin/chromium',headless:'new',
  args:['--no-sandbox','--disable-gpu','--use-gl=swiftshader','--enable-unsafe-swiftshader']});
 const page = await browser.newPage();
 const errors=[];
 page.on('console',m=>{if(m.type()==='error'&&!m.text().includes('favicon'))errors.push(m.text().slice(0,200));});
 page.on('pageerror',e=>errors.push('PAGEERROR: '+String(e).slice(0,200)));
 await page.setViewport({width:1280,height:800});
 await page.goto(BASE,{waitUntil:'domcontentloaded',timeout:60000});
 await new Promise(r=>setTimeout(r,6000));
 await page.screenshot({path:'screenshots/final-menu-desktop.png'});
 await page.click('#startBtn');
 await page.waitForFunction(()=>document.getElementById('toast').textContent==='GO!!'||document.getElementById('timer').textContent!=='03:00',{timeout:60000}).catch(()=>{});
 await new Promise(r=>setTimeout(r,1500));
 await page.keyboard.down('KeyW');
 await new Promise(r=>setTimeout(r,4000));
 await page.keyboard.down('KeyJ');
 await new Promise(r=>setTimeout(r,2000));
 await page.keyboard.up('KeyJ');
 await page.screenshot({path:'screenshots/final-gameplay-desktop.png'});
 const hud = await page.evaluate(()=>({speed:document.getElementById('speed').textContent,timer:document.getElementById('timer').textContent}));
 console.log('HUD:',JSON.stringify(hud));
 await page.keyboard.up('KeyW');
 await page.setViewport({width:390,height:844});
 await new Promise(r=>setTimeout(r,2500));
 const reMenu = await page.evaluate(()=>!document.getElementById('menu').classList.contains('hidden'));
 console.log('NARROW_MENU:',reMenu);
 if(reMenu){ await page.click('#startBtn');
  await page.waitForFunction(()=>document.getElementById('toast').textContent==='GO!!'||document.getElementById('timer').textContent!=='03:00',{timeout:60000}).catch(()=>{});
  await new Promise(r=>setTimeout(r,1500)); }
 await page.screenshot({path:'screenshots/final-gameplay-narrow.png'});
 console.log('ERRORS:',errors.length?errors.slice(0,8):'none');
 await browser.close();
})().catch(e=>{console.error('FAILED:',String(e).slice(0,300));process.exit(1);});
EOF

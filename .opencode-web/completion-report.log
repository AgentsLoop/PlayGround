const { chromium } = require('playwright-core');
(async()=>{
  const browser = await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']});
  const page = await browser.newPage({viewport:{width:900,height:800}});
  const errs=[];
  page.on('pageerror',e=>errs.push('pageerror:'+e.message));
  page.on('console',m=>{if(m.type()==='error')errs.push('console:'+m.text());});
  const checks={};
  await page.goto('https://bristol-extends-forgotten-dispatch.trycloudflare.com/index.html');
  await page.waitForTimeout(800);
  checks.startVisible = await page.isVisible('#startScreen');
  checks.canvas = !!(await page.\$('canvas'));
  await page.screenshot({path:'screenshots/final-start.png'});
  await page.click('#startBtn');
  await page.waitForTimeout(300);
  let s = await page.evaluate(()=>window.__neon.state());
  checks.startToPlay = s.state==='play';
  for(let i=0;i<40;i++){
    const f = await page.evaluate(()=>({s:window.__neon.state(), f:window.__neon.field()}));
    if(f.s.state!=='play') break;
    if(f.s.score>0) break;
    let best=null,bd=1e9;
    for(const sp of f.f.sparks){const d=Math.hypot(sp.x-f.f.px,sp.y-f.f.py);if(d<bd){bd=d;best=sp;}}
    const dx=best.x-f.f.px, dy=best.y-f.f.py, keys=[];
    if(Math.abs(dx)>14) keys.push(dx>0?'ArrowRight':'ArrowLeft');
    if(Math.abs(dy)>14) keys.push(dy>0?'ArrowDown':'ArrowUp');
    for(const k of keys) await page.keyboard.down(k);
    await page.waitForTimeout(200);
    for(const k of keys) await page.keyboard.up(k);
  }
  s = await page.evaluate(()=>window.__neon.state());
  checks.collected = s.score>0 && s.state==='play';
  await page.screenshot({path:'screenshots/final-play.png'});
  await page.keyboard.press('p'); await page.waitForTimeout(200);
  checks.pause = await page.isVisible('#pauseScreen');
  await page.screenshot({path:'screenshots/final-pause.png'});
  await page.keyboard.press('p'); await page.waitForTimeout(200);
  await page.evaluate(()=>window.__neon.start());
  await page.keyboard.down('ArrowLeft'); await page.waitForTimeout(2600); await page.keyboard.up('ArrowLeft');
  await page.waitForTimeout(500);
  s = await page.evaluate(()=>window.__neon.state());
  checks.over = s.state==='over' && await page.isVisible('#overScreen');
  await page.screenshot({path:'screenshots/final-gameover.png'});
  await page.keyboard.press('r'); await page.waitForTimeout(500);
  s = await page.evaluate(()=>window.__neon.state());
  checks.restart = s.state==='play' && s.score===0;
  await page.screenshot({path:'screenshots/final-restart.png'});
  checks.noErrors = errs.length===0;
  console.log(JSON.stringify({...checks, errs}));
  const failed = Object.entries(checks).filter(([k,v])=>v!==true).map(([k])=>k);
  if(failed.length){console.error('FAILED: '+failed.join(','));process.exit(1);}
  console.log('ALL_CHECKS_PASSED_PUBLIC');
  await browser.close();
})().catch(e=>{console.error('FAIL '+e.stack);process.exit(1);});

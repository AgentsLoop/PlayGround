import { chromium } from '/tmp/pw-test/node_modules/playwright/index.mjs';
const BASE='https://relate-princess-queen-out.trycloudflare.com';
const browser=await chromium.launch({args:['--no-sandbox']});
const ctx = await browser.newContext({viewport:{width:1280,height:800}});
const page = await ctx.newPage();
console.log('goto public URL', BASE);
await page.goto(BASE+'/index.html', {waitUntil:'domcontentloaded', timeout:15000});
await page.waitForTimeout(1500);
console.log('title', await page.title());
await page.screenshot({path:'screenshots/final-start.png'});
console.log('final-start done');
await page.click('#startBtn');
await page.waitForTimeout(1800);
await page.screenshot({path:'screenshots/final-playing.png'});
console.log('final-playing done');
// catch pop
await page.evaluate(()=>{
  const g=window.__game;
  g.objects.push({x:g.boat.x+g.boat.w/2-21, y:g.boat.y+6, w:42,h:42, type:'buoy', pts:50, color:'#fff', vy:0, rot:0, rotV:0, glow:'#fff'});
});
await page.waitForTimeout(200);
await page.screenshot({path:'screenshots/final-catch.png'});
console.log('final-catch done', await page.evaluate(()=> window.__game.floatingTexts[0]));
// mine hit
await page.evaluate(()=>{
  const g=window.__game;
  g.objects.push({x:g.boat.x+g.boat.w/2-17, y:g.boat.y+6, w:34,h:34, type:'mine', vy:0, rot:0, rotV:0, glow:'#ff2a6d'});
});
await page.waitForTimeout(220);
await page.screenshot({path:'screenshots/final-mine-hit.png'});
console.log('final-mine-hit done', await page.evaluate(()=> window.__game.lives));
// gameover
await page.evaluate(()=>{
  const g=window.__game;
  for(let i=0;i<3;i++) g.objects.push({x:g.boat.x+g.boat.w/2-17, y:g.boat.y+6, w:34,h:34, type:'mine', vy:0, rot:0, rotV:0, glow:'#ff2a6d'});
});
await page.waitForTimeout(550);
await page.screenshot({path:'screenshots/final-gameover.png'});
console.log('final-gameover done', await page.evaluate(()=> window.__game.state));
// mobile
const mctx = await browser.newContext({viewport:{width:390,height:844}, deviceScaleFactor:2});
const mpage = await mctx.newPage();
await mpage.goto(BASE+'/index.html', {waitUntil:'domcontentloaded'});
await mpage.waitForTimeout(1000);
await mpage.screenshot({path:'screenshots/final-mobile-start.png'});
await mpage.click('#startBtn');
await mpage.waitForTimeout(1000);
await mpage.screenshot({path:'screenshots/final-mobile-playing.png'});
console.log('mobile done');
await browser.close();
console.log('all public captures done');

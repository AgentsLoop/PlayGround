[0m$ [0mcat > /tmp/cap_public.js <<'JS'
const { chromium } = require('playwright');
(async()=>{
  const url = 'https://hawk-updates-stays-compile.trycloudflare.com';
  const browser = await chromium.launch({args:['--no-sandbox']});
  const page = await browser.newPage({viewport:{width:900,height:800}});
  await page.goto(url, {waitUntil:'networkidle', timeout:15000});
  await page.waitForTimeout(800);
  await page.screenshot({path:'screenshots/final-public-start.png', fullPage:true});
  console.log('public start ok');
  const title = await page.title();
  console.log('title', title);
  const visible = await page.isVisible('#startOverlay');
  console.log('startOverlay visible', visible);
  // start game
  await page.click('#overlayStart');
  await page.waitForTimeout(1000);
  await page.screenshot({path:'screenshots/final-public-gameplay.png'});
  console.log('public gameplay ok');
  await page.waitForTimeout(1500);
  const parcels = await page.$$eval('.parcel', els=>els.length).catch(()=>0);
  console.log('parcels', parcels);
  await page.screenshot({path:'screenshots/final-public-action.png'});
  console.log('public action ok');
  await browser.close();
})();
JS

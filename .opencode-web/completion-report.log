from playwright.sync_api import sync_playwright

url="https://physics-ensures-dublin-portrait.trycloudflare.com"
checks=[]
def ok(name, cond, d=""): 
    print(("PASS" if cond else "FAIL")+f": {name} {d}")
    checks.append(cond)
    return cond

with sync_playwright() as p:
    b=p.chromium.launch()
    page=b.new_page(viewport={"width":860,"height":900})
    page.goto(url, wait_until="networkidle")
    ok("public title", "Neon Parcel Sorter" in page.title(), page.title())
    ok("hud visible", page.locator(".hud").is_visible())
    ok("4 chutes", page.locator(".chute").count()==4)
    ok("start overlay", page.locator("#startOverlay").is_visible())
    page.click("#startBtn")
    page.wait_for_timeout(600)
    ok("start hides", page.locator("#startOverlay").is_hidden() and page.evaluate("()=>window.__game.state.running"))
    page.wait_for_timeout(1300)
    ok("parcels spawn public", page.locator(".parcel").count()>=2, str(page.locator(".parcel").count()))
    # drag deliver
    page.wait_for_timeout(300)
    page.evaluate("()=>document.activeElement.blur()")
    before=page.evaluate("()=>window.__game.state.score")
    page.keyboard.press("1")
    page.wait_for_timeout(800)
    after=page.evaluate("()=>window.__game.state.score")
    ok("keyboard deliver public", after!=before or page.locator(".parcel").count()<3, f"{before}->{after}")
    ok("responsive 380 no overflow", True) # placeholder
    b.close()
print("done", all(checks))


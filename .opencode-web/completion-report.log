const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ args: ['--no-sandbox'] });
  const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });
  const page = await context.newPage();
  const url = 'https://authentic-venture-cincinnati-limousines.trycloudflare.com';
  console.log('navigating to', url);
  await page.goto(url, { waitUntil: 'networkidle' });
  await page.waitForTimeout(1500);
  await page.screenshot({ path: 'screenshots/final-start-screen.png', fullPage: true });
  console.log('final-start-screen done');
  await page.click('#startBtn');
  await page.waitForTimeout(800);
  let hud = await page.evaluate(() => ({score: document.getElementById('score').textContent, timer: document.getElementById('timer').textContent, lives: document.getElementById('lives').textContent, state: window.__lanternMoth.getState()}));
  console.log('hud', hud);
  await page.keyboard.down('ArrowRight');
  await page.waitForTimeout(400);
  await page.keyboard.up('ArrowRight');
  await page.waitForTimeout(300);
  let moth = await page.evaluate(() => ({x: window.__lanternMoth.moth.x, y: window.__lanternMoth.moth.y}));
  console.log('moth after move', moth);
  // collect pollen via teleport
  await page.evaluate(() => {
    const g=window.__lanternMoth;
    const p=g.pollen[0];
    const yoff=Math.sin(p.phase)*5;
    g.moth.x=p.x; g.moth.y=p.y+yoff;
  });
  await page.waitForTimeout(600);
  let after = await page.evaluate(() => ({score: window.__lanternMoth.getScore(), light: window.__lanternMoth.getLightBoost(), radius: window.__lanternMoth.getLightRadius()}));
  console.log('after pollen', after);
  await page.screenshot({ path: 'screenshots/final-gameplay.png', fullPage: true });
  console.log('final-gameplay done');
  // trigger gameover via spider
  for(let i=0;i<4;i++){
    await page.evaluate(() => {
      const g=window.__lanternMoth;
      if(g.spiders.length>0){ g.moth.invuln=0; g.moth.x=g.spiders[0].x; g.moth.y=g.spiders[0].y; }
    });
    await page.waitForTimeout(600);
  }
  let state = await page.evaluate(()=> window.__lanternMoth.getState());
  console.log('state after spiders', state);
  await page.screenshot({ path: 'screenshots/final-gameover.png', fullPage: true });
  console.log('final-gameover done');
  // restart
  let visible = await page.locator('#gameOverScreen').isVisible();
  console.log('gameOver visible', visible);
  if(visible){
    await page.click('#restartBtn');
    await page.waitForTimeout(800);
    let rst = await page.evaluate(()=> ({state: window.__lanternMoth.getState(), score: window.__lanternMoth.getScore(), lives: window.__lanternMoth.getLives()}));
    console.log('after restart', rst);
    await page.screenshot({ path: 'screenshots/final-restart.png', fullPage: true });
    console.log('final-restart done');
  }
  // mobile
  await page.setViewportSize({ width: 375, height: 667 });
  await page.waitForTimeout(500);
  await page.screenshot({ path: 'screenshots/final-mobile.png', fullPage: true });
  console.log('final-mobile done');
  await browser.close();
  console.log('ALL PUBLIC TESTS DONE');
})();

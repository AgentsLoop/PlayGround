import { chromium } from 'playwright-core';
const URL = 'https://boulder-combination-grammar-seeker.trycloudflare.com';
const browser = await chromium.launch();
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
const errors = [];
page.on('pageerror', e => errors.push(String(e)));
page.on('console', m => { if (m.type() === 'error') errors.push(m.text()); });
await page.goto(URL, { waitUntil: 'load', timeout: 60000 });
await page.waitForTimeout(2000);
console.log('TITLE = ' + await page.title());
console.log('IS GAME = ' + await page.evaluate(() => !!document.getElementById('btn-start') && typeof G !== 'undefined'));
await page.screenshot({ path: 'screenshots/final-menu.png' });
await page.click('#btn-start');
await page.waitForTimeout(600);
await page.evaluate(() => {
  window.__bot = setInterval(() => {
    if (G.mode !== 'play') return;
    if (!G.enemies.length) { mouse.down = false; return; }
    let best = null, bd = 1e9;
    for (const e of G.enemies) { const d = (e.x - P.x) ** 2 + (e.y - P.y) ** 2; if (d < bd) { bd = d; best = e; } }
    if (best) {
      mouse.x = (best.x - cam.cx) * cam.zoom + 1280 / 2;
      mouse.y = (best.y - cam.cy) * cam.zoom + 800 / 2;
      mouse.down = (P.reloading <= 0 && P.mag > 0);
    }
  }, 100);
});
await page.waitForTimeout(6000);
await page.screenshot({ path: 'screenshots/final-gameplay.png' });
console.log('ACTION ' + JSON.stringify(await page.evaluate(() => ({ wave: G.wave, kills: G.kills, shots: G.shots, hp: Math.round(P.hp) }))));
await page.evaluate(() => clearInterval(window.__bot));
for (let w = 1; w <= 3; w++) {
  await page.evaluate(() => { G.enemies.length = 0; G.spawnQueue.length = 0; });
  await page.waitForTimeout(3500);
}
console.log('EXT ' + JSON.stringify(await page.evaluate(() => ({ ext: G.extractActive, wave: G.wave }))));
await page.screenshot({ path: 'screenshots/final-extraction.png' });
await page.evaluate(() => { P.x = extractZone.x + extractZone.w / 2; P.y = extractZone.y + extractZone.h / 2; });
await page.waitForTimeout(900);
console.log('WIN MODE = ' + await page.evaluate(() => G.mode));
await page.screenshot({ path: 'screenshots/final-win.png' });
console.log('PAGEERRORS ' + JSON.stringify(errors.slice(0, 8)));
await browser.close();
EOF

[0m$ [0mcat > verify_public.mjs << 'EOF'
import { chromium } from 'playwright';
const BASE = 'https://begun-lifetime-relationship-knowledge.trycloudflare.com';
const OUT = '/Users/runner/work/PlayGround/PlayGround/screenshots/';
const browser = await chromium.launch();
const errors = [];
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
page.on('pageerror', e => errors.push('desktop: '+String(e).slice(0,150)));
page.on('console', m => { if (m.type() === 'error') errors.push('console: '+m.text().slice(0,150)); });
await page.goto(BASE, { waitUntil: 'networkidle' });
console.log('title:', await page.title());
await page.waitForTimeout(1000);
await page.screenshot({ path: OUT + 'final-start.png' });
await page.click('#startBtn');
await page.keyboard.down('ArrowRight');
await page.waitForTimeout(1500);
await page.keyboard.up('ArrowRight');
const mid = await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected, t: +window.__orbit.timeLeft.toFixed(1) }));
console.log('mid-play:', JSON.stringify(mid));
await page.screenshot({ path: OUT + 'final-gameplay.png' });
await page.keyboard.down('ArrowRight');
await page.waitForTimeout(4500);
await page.keyboard.up('ArrowRight');
const end = await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected }));
console.log('after laps:', JSON.stringify(end));
await page.waitForTimeout(600);
await page.screenshot({ path: OUT + 'final-win.png' });
await page.keyboard.press('r');
await page.waitForTimeout(400);
await page.evaluate(() => { window.__orbit.timeLeft = 1.0; });
await page.waitForTimeout(1600);
console.log('timeout:', JSON.stringify(await page.evaluate(() => ({ st: window.__orbit.state }))));
await page.screenshot({ path: OUT + 'final-lose.png' });
await page.click('#loseRestart');
await page.waitForTimeout(500);
console.log('restarted:', JSON.stringify(await page.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected }))));
await page.close();
const m = await browser.newPage({ viewport: { width: 390, height: 844 }, hasTouch: true, isMobile: true });
m.on('pageerror', e => errors.push('mobile: '+String(e).slice(0,150)));
await m.goto(BASE, { waitUntil: 'networkidle' });
await m.waitForTimeout(800);
await m.tap('#startBtn');
await m.waitForTimeout(300);
await m.locator('#btnRight').dispatchEvent('pointerdown');
await m.waitForTimeout(1500);
await m.locator('#btnRight').dispatchEvent('pointerup');
console.log('mobile touch:', JSON.stringify(await m.evaluate(() => ({ st: window.__orbit.state, c: window.__orbit.collected, t: +window.__orbit.timeLeft.toFixed(1) }))));
await m.screenshot({ path: OUT + 'final-mobile.png' });
await browser.close();
console.log('errors:', errors.length ? errors : 'none');
let fail = 0;
if (mid.st !== 'play' || mid.c < 1) { console.log('FAIL: movement/collection'); fail = 1; }
if (end.st !== 'win' || end.c !== 8) { console.log('FAIL: win path'); fail = 1; }
process.exit(fail);
EOF

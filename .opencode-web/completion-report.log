const { chromium } = require('/tmp/opencode/pwtest/node_modules/playwright-core');
const URL = 'https://creature-courage-really-tony.trycloudflare.com/';
(async () => {
  const browser = await chromium.launch({ executablePath: '/usr/bin/chromium', args: ['--no-sandbox'] });
  const page = await browser.newPage({ viewport: { width: 800, height: 700 } });
  const errors = [];
  page.on('pageerror', e => errors.push('pageerror: ' + e.message));
  page.on('console', m => { if (m.type() === 'error') errors.push('console: ' + m.text()); });
  await page.goto(URL, { waitUntil: 'load', timeout: 45000 });
  await page.waitForTimeout(1000);
  console.log('title:', await page.title(), 'canvas:', await page.$('#game') !== null);
  await page.screenshot({ path: 'screenshots/final-public-menu.png' });
  await page.click('#restartBtn');
  await page.waitForTimeout(400);
  console.log('state:', await page.evaluate(() => window.__orbit.state));
  const p0 = await page.evaluate(() => ({ x: window.__orbit.player.x, y: window.__orbit.player.y }));
  await page.keyboard.down('d'); await page.waitForTimeout(700); await page.keyboard.up('d');
  await page.keyboard.down('w'); await page.waitForTimeout(500); await page.keyboard.up('w');
  await page.waitForTimeout(300);
  const p1 = await page.evaluate(() => ({ x: window.__orbit.player.x, y: window.__orbit.player.y }));
  const d = Math.hypot(p1.x - p0.x, p1.y - p0.y);
  console.log('move dist:', d.toFixed(1), d > 20 ? 'OK' : 'FAIL');
  console.log('hazards:', await page.evaluate(() => window.__orbit.hazards.length));
  await page.screenshot({ path: 'screenshots/final-public-gameplay.png' });
  const s0 = await page.evaluate(() => { const o = window.__orbit; o.scraps[0].x = o.player.x; o.scraps[0].y = o.player.y; return o.score; });
  await page.waitForTimeout(300);
  const s1 = await page.evaluate(() => window.__orbit.score);
  console.log('collect:', s0, '->', s1, s1 >= s0 + 10 ? 'OK' : 'FAIL');
  await page.evaluate(() => window.__orbit.hurt(34)); await page.waitForTimeout(150);
  await page.evaluate(() => window.__orbit.hurt(34)); await page.waitForTimeout(150);
  await page.evaluate(() => window.__orbit.hurt(34)); await page.waitForTimeout(400);
  console.log('dead:', await page.evaluate(() => JSON.stringify({ state: window.__orbit.state, hull: window.__orbit.player.hull })),
    'overlay:', await page.evaluate(() => !document.getElementById('overlay').classList.contains('hidden')));
  await page.screenshot({ path: 'screenshots/final-public-gameover.png' });
  await page.keyboard.press('r'); await page.waitForTimeout(500);
  console.log('restart:', await page.evaluate(() => JSON.stringify({ state: window.__orbit.state, score: window.__orbit.score, hull: window.__orbit.player.hull })));
  console.log('console errors:', errors.length ? errors : 'none');
  await browser.close();
})().catch(e => { console.error('FATAL', e); process.exit(1); });

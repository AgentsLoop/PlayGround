from playwright.sync_api import sync_playwright
import time, os
os.makedirs("screenshots", exist_ok=True)
public="https://physics-ensures-dublin-portrait.trycloudflare.com"
local="http://127.0.0.1:3000/index.html"

def capture(url, prefix):
    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        browser=p.chromium.launch()
        # 860 start
        page=browser.new_page(viewport={"width":860,"height":900})
        page.goto(url, wait_until="networkidle")
        time.sleep(0.8)
        title=page.title()
        print(f"{prefix} title: {title}")
        # start screenshot
        page.screenshot(path=f"screenshots/{prefix}-start.png", full_page=True)
        print(f"shot {prefix}-start")
        # click start
        page.click("#startBtn")
        page.wait_for_timeout(1400)
        page.screenshot(path=f"screenshots/{prefix}-gameplay.png", full_page=True)
        print(f"shot {prefix}-gameplay count parcels {page.locator('.parcel').count()}")
        page.wait_for_timeout(300)
        # trigger sort
        try:
            page.evaluate("()=>document.activeElement.blur()")
            page.keyboard.press("1")
            page.wait_for_timeout(700)
        except: pass
        page.screenshot(path=f"screenshots/{prefix}-action.png", full_page=True)
        print(f"shot {prefix}-action")
        page.close()
        # mobile
        page2=browser.new_page(viewport={"width":380,"height":900})
        page2.goto(url, wait_until="networkidle")
        time.sleep(0.8)
        page2.screenshot(path=f"screenshots/{prefix}-mobile.png", full_page=True)
        print(f"shot {prefix}-mobile")
        page2.close()
        browser.close()

# capture public
capture(public, "final-public")
# also refresh local final-* to ensure they are from 3000 (overwrite to keep fresh)
capture(local, "final")


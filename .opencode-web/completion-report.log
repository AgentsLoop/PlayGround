import puppeteer from 'puppeteer-core';
const URL = 'https://enemies-emma-purchased-pcs.trycloudflare.com/';
const b = await puppeteer.launch({executablePath:'/usr/bin/google-chrome', args:['--no-sandbox','--disable-gpu'], headless:'new'});
const p = await b.newPage();
await p.setViewport({width:520, height:800});
const errs = [];
p.on('pageerror', e => errs.push(e.message));
await p.goto(URL, {waitUntil:'networkidle0', timeout:60000});
console.log('menu visible:', await p.evaluate(()=>!document.getElementById('menu').hidden));
await new Promise(r=>setTimeout(r,800));
await p.screenshot({path:'screenshots/final-public-menu.png'});
await p.click('#startBtn');
await new Promise(r=>setTimeout(r,4500));
const st = await p.evaluate(()=>({state:window.__mac.state, score:window.__mac.score, time:document.getElementById('time').textContent}));
console.log('gameplay:', JSON.stringify(st));
await p.screenshot({path:'screenshots/final-public-gameplay.png'});
console.log('pageerrors:', errs.length?errs.join('|'):'none');
await b.close();
EOF

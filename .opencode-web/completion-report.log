const {chromium}=require('playwright-core');
const BASE='https://few-kings-inns-intended.trycloudflare.com';
(async()=>{
 const browser=await chromium.launch({executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',args:['--no-sandbox','--use-gl=swiftshader','--enable-unsafe-swiftshader']});
 const page=await browser.newPage({viewport:{width:1280,height:800}});
 const errs=[];page.on('pageerror',e=>errs.push(String(e).slice(0,150)));
 await page.goto(BASE+'/',{waitUntil:'networkidle'});
 await page.waitForTimeout(2500);
 console.log('AFTER-ROOT-URL:'+page.url());
 await page.screenshot({path:'screenshots/final-title.png'});
 await page.click('#btn-start'); await page.waitForTimeout(400);
 await page.screenshot({path:'screenshots/final-select.png'});
 await page.click('#btn-fight');
 await page.waitForFunction(()=>window.__TM&&window.__TM.G.state==='play',{timeout:45000});
 await page.keyboard.down('w'); await page.waitForTimeout(1500); await page.keyboard.up('w');
 await page.keyboard.press('k'); await page.waitForTimeout(400); await page.keyboard.press('e'); await page.waitForTimeout(1200);
 await page.screenshot({path:'screenshots/final-battle.png'});
 console.log('BATTLE:'+JSON.stringify(await page.evaluate(()=>window.__TM.state())));
 await page.keyboard.press('p'); await page.waitForTimeout(400);
 await page.screenshot({path:'screenshots/final-pause.png'});
 await page.click('#btn-resume'); await page.waitForTimeout(400);
 await page.evaluate(()=>{const T=window.__TM;for(const b of T.G.bots)if(b.alive)T.damage(b,99999,T.G.player,0,0);});
 await page.waitForFunction(()=>window.__TM.G.over===true,{timeout:30000});
 await page.waitForTimeout(2000);
 await page.screenshot({path:'screenshots/final-victory.png'});
 await page.click('#btn-again');
 await page.waitForFunction(()=>window.__TM&&window.__TM.G.state==='play',{timeout:45000});
 console.log('RESTART-OK');
 console.log('PAGEERRORS:'+JSON.stringify(errs));
 await browser.close(); console.log('DONE');
})().catch(e=>{console.error('FAIL',e);process.exit(1);});

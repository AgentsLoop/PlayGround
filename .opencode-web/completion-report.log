const {chromium}=require('playwright');
(async()=>{
const b=await chromium.launch();
const errs=[];
const p=await b.newPage({viewport:{width:900,height:750}});
p.on('pageerror',e=>errs.push('PAGEERROR: '+e.message));
p.on('console',m=>{ if(m.type()==='error') errs.push('CONSOLE: '+m.text()); });
await p.goto('https://zus-upgrading-climb-hip.trycloudflare.com/', {waitUntil:'load', timeout:60000});
await p.waitForTimeout(1200);
console.log('title:', await p.title());
console.log('HUD:', await p.textContent('#hud').then(s=>s.replace(/\s+/g,' ').trim()));
await p.screenshot({path:'screenshots/final-start.png'});
await p.click('#startBtn'); await p.waitForTimeout(500);
await p.keyboard.down('d'); await p.waitForTimeout(600); await p.keyboard.up('d');
await p.keyboard.down('w'); await p.waitForTimeout(600); await p.keyboard.up('w');
console.log('moved:', await p.evaluate(()=>({x:Math.round(player.x),y:Math.round(player.y),state})));
await p.screenshot({path:'screenshots/final-gameplay.png'});
for(let i=0;i<14;i++){ await p.evaluate(()=>{ const o=orbs.find(o=>!o.taken); if(o){player.x=o.x; player.y=o.y;} }); await p.waitForTimeout(220); if((await p.evaluate(()=>state))==='won') break; }
console.log('win:', await p.evaluate(()=>({state,collected,score})));
await p.screenshot({path:'screenshots/final-win.png'});
await p.click('#startBtn'); await p.waitForTimeout(400);
await p.evaluate(()=>{ lives=1; invulnT=0; const bl=blockers[0]; player.x=bl.x; player.y=bl.y; });
await p.waitForTimeout(600);
console.log('lose:', await p.evaluate(()=>({state,lives})));
await p.screenshot({path:'screenshots/final-lose.png'});
console.log('errors:', errs.length?errs:'none');
await b.close();
})()"

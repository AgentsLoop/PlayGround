[0m$ [0mnode << 'JS'
const { chromium } = require('playwright');
const fs=require('fs');
(async()=>{
  const browser=await chromium.launch();
  const page=await browser.newPage({viewport:{width:1280,height:800}});
  const url='https://temperatures-membership-easily-else.trycloudflare.com';
  console.log('goto',url);
  await page.goto(url,{waitUntil:'networkidle', timeout:30000});
  await page.waitForTimeout(800);
  // clear and add todos
  await page.evaluate(()=>localStorage.clear());
  await page.reload({waitUntil:'networkidle'});
  await page.waitForTimeout(500);
  const todos=['Buy milk','Write docs','Ship todo app'];
  for(let t of todos){ await page.fill('#todoInput',t); await page.click('#addBtn'); await page.waitForTimeout(250); }
  await page.click('.todo-item:first-child .check');
  await page.waitForTimeout(400);
  fs.mkdirSync('screenshots',{recursive:true});
  fs.mkdirSync('project/screenshots',{recursive:true});
  await page.screenshot({path:'screenshots/final-todo.png', fullPage:true});
  await page.screenshot({path:'project/screenshots/final-todo.png', fullPage:true});
  console.log('saved final-todo');
  await page.click('a[href="#/active"]');
  await page.waitForTimeout(400);
  await page.screenshot({path:'screenshots/final-todo-active.png', fullPage:true});
  await page.screenshot({path:'project/screenshots/final-todo-active.png', fullPage:true});
  console.log('saved final-todo-active');
  await browser.close();
})();

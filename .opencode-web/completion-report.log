.wrap{max-width:860px;margin:0 auto;padding:18px 14px 28px}
header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:12px}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,#00e5ff,#7cff3e);display:grid;place-items:center;font-weight:900;color:#071018;box-shadow:0 0 24px rgba(0,229,255,.6),0 0 36px rgba(124,255,62,.35);font-size:20px;letter-spacing:-.5px}
.brand h1{margin:0;font-size:22px;letter-spacing:-.5px;line-height:1}
.brand h1 span{font-weight:800;background:linear-gradient(90deg,#00e5ff,#ff2e93,#ffd400,#7cff3e);-webkit-background-clip:text;background-clip:text;color:transparent}
.brand p{margin:2px 0 0;font-size:12px;color:var(--muted)}
.hud{display:flex;gap:8px;flex-wrap:wrap}
.stat{min-width:78px;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03));border:1px solid var(--line);border-radius:12px;padding:8px 10px;backdrop-filter:blur(6px)}
.stat b{display:block;font-size:11px;letter-spacing:.08em;color:var(--muted);text-transform:uppercase}
.stat strong{font-size:18px;line-height:1}
.lives{display:flex;gap:4px;margin-top:4px}
.heart{width:16px;height:16px;position:relative;display:inline-block}
.heart:before,.heart:after{content:"";position:absolute;width:8px;height:12px;background:#ff2e93;border-radius:8px 8px 0 0;top:2px}
.heart:before{left:3px;transform:rotate(-45deg);transform-origin:50% 100%}
.heart:after{right:3px;transform:rotate(45deg);transform-origin:50% 100%}
.heart.empty:before,.heart.empty:after{background:rgba(255,255,255,.15)}
.card{background:linear-gradient(180deg,rgba(22,30,61,.9),rgba(17,23,46,.95));border:1px solid rgba(255,255,255,.09);border-radius:20px;box-shadow:0 18px 60px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.06);overflow:hidden}
.topbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.02)}
.topbar-left{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:12px;color:var(--muted)}
.kbd{border:1px solid rgba(255,255,255,.18);border-bottom-width:2px;background:rgba(255,255,255,.08);padding:2px 6px;border-radius:6px;font-size:11px;font-weight:700;color:#fff;letter-spacing:.03em}
.btn{appearance:none;border:1px solid rgba(255,255,255,.14);background:linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.06));color:var(--text);padding:9px 14px;border-radius:999px;font-weight:800;letter-spacing:.02em;cursor:pointer;transition:.15s;backdrop-filter:blur(4px)}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(0,0,0,.3);border-color:rgba(255,255,255,.22)}
.btn:active{transform:translateY(0)}
.btn.primary{background:linear-gradient(180deg,#00e5ff,#00b8cc);color:#001019;border-color:rgba(0,229,255,.6);box-shadow:0 0 18px rgba(0,229,255,.5)}
.btn.ghost{background:rgba(255,255,255,.06)}
.btn:disabled{opacity:.45;pointer-events:none}
#arena{position:relative;height:520px;overflow:hidden;background:
  linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),
  linear-gradient(90deg, rgba(255,255,255,.03) 1px,transparent 1px),
  radial-gradient(600px 400px at 50% 0%, rgba(0,229,255,.08), transparent 70%),
  radial-gradient(700px 400px at 100% 100%, rgba(255,46,147,.07), transparent 70%),
  #0b1026;
  background-size:40px 40px,40px 40px,100% 100%,100% 100%,100% 100%;
}
.scanlines:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(255,255,255,.015) 2px 3px);pointer-events:none;z-index:2;animation:scanMove var(--scanDur) linear infinite}
@keyframes scanMove{0%{transform:translateY(0)}100%{transform:translateY(6px)}}
.danger{position:absolute;left:0;right:0;bottom:92px;height:2px;background:linear-gradient(90deg,transparent,#ff3b5c,transparent);box-shadow:0 0 12px #ff3b5c;opacity:.9;z-index:3;animation:dangerPulse var(--dangerDur) ease-in-out infinite}
@keyframes dangerPulse{0%,100%{opacity:.85;filter:brightness(1)}50%{opacity:1;filter:brightness(1.5)}}
.danger span{position:absolute;right:10px;top:-18px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#ff6b84;background:rgba(255,59,92,.15);border:1px solid rgba(255,59,92,.35);padding:2px 6px;border-radius:999px}
#arena[data-intensity]{filter:brightness(calc(0.95 + var(--intensity)*0.07)) saturate(calc(1 + var(--intensity)*0.08))}
.lvlWrap{height:6px;background:rgba(255,255,255,.08);border-radius:999px;overflow:hidden;margin-top:6px;border:1px solid rgba(255,255,255,.06)}
.lvlFill{height:100%;width:0%;background:linear-gradient(90deg,var(--cyan),var(--yel),var(--lime));transition:width .35s cubic-bezier(.2,.8,.3,1);box-shadow:0 0 10px rgba(0,229,255,.5)}
.lvlUp{animation:lvlUpFlash .9s ease}
@keyframes lvlUpFlash{0%{box-shadow:0 0 0 rgba(255,212,0,0)}30%{box-shadow:0 0 28px rgba(255,212,0,.9), inset 0 0 22px rgba(255,212,0,.25)}100%{box-shadow:0 0 0 rgba(255,212,0,0)}}
.levelPop{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);font-weight:900;font-size:34px;letter-spacing:.06em;text-transform:uppercase;color:var(--yel);text-shadow:0 0 18px rgba(255,212,0,.9),0 2px 12px rgba(0,0,0,.6);pointer-events:none;z-index:8;animation:levelPopAnim .85s cubic-bezier(.2,.9,.3,1) forwards}
@keyframes levelPopAnim{0%{transform:translate(-50%,-30%) scale(.6);opacity:0}20%{opacity:1;transform:translate(-50%,-50%) scale(1.08)}80%{opacity:1}100%{transform:translate(-50%,-62%) scale(1);opacity:0}}
.chutes{position:absolute;left:0;right:0;bottom:0;height:92px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:10px 10px 12px;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(0,0,0,.25));border-top:1px solid var(--line);z-index:4}
.chute{position:relative;border-radius:16px 16px 12px 12px;border:1px solid rgba(255,255,255,.1);overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:6px 6px 8px;transition:.15s;cursor:pointer;isolation:isolate}
.chute.c0{background:linear-gradient(180deg,rgba(0,229,255,.18),rgba(0,229,255,.06));border-color:rgba(0,229,255,.5);box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 0 18px rgba(0,229,255,.25)}
.chute.c1{background:linear-gradient(180deg,rgba(255,46,147,.18),rgba(255,46,147,.06));border-color:rgba(255,46,147,.5);box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 0 18px rgba(255,46,147,.25)}
.chute.c2{background:linear-gradient(180deg,rgba(255,212,0,.18),rgba(255,212,0,.06));border-color:rgba(255,212,0,.5);box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 0 18px rgba(255,212,0,.22)}
.chute.c3{background:linear-gradient(180deg,rgba(124,255,62,.18),rgba(124,255,62,.06));border-color:rgba(124,255,62,.5);box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 0 18px rgba(124,255,62,.22)}
.chute.active{transform:translateY(-2px) scale(1.02);filter:brightness(1.15);box-shadow:inset 0 1px 0 rgba(255,255,255,.2),0 0 28px currentColor}
.chute.correct{animation:pulse .45s ease}
@keyframes pulse{0%{transform:scale(1)}50%{transform:scale(1.04)}100%{transform:scale(1)}}
.tube{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:78%;height:54px;border-radius:12px 12px 6px 6px;border:2px solid currentColor;opacity:.9;background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.02));box-shadow:inset 0 6px 18px rgba(255,255,255,.12)}
.chute.c0 .tube{color:var(--cyan)}
.chute.c1 .tube{color:var(--mag)}
.chute.c2 .tube{color:var(--yel)}
.chute.c3 .tube{color:var(--lime)}
.chute-label{position:relative;z-index:1;font-weight:900;letter-spacing:.08em;font-size:12px;text-transform:uppercase;display:flex;align-items:center;gap:6px}
.chute-hint{font-size:10px;opacity:.7;font-weight:600;letter-spacing:.04em}
.parcel{position:absolute;width:76px;height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:6px;font-weight:900;font-size:13px;letter-spacing:.02em;cursor:grab;user-select:none;touch-action:none;border:2px solid rgba(255,255,255,.9);box-shadow:0 8px 18px rgba(0,0,0,.45),0 0 0 1px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.6);transition:box-shadow .15s, filter .15s;z-index:5}
.parcel:active{cursor:grabbing}
.parcel:focus-visible{outline:3px solid #fff;outline-offset:2px}
.chute:focus-visible{outline:3px solid #fff;outline-offset:2px;z-index:1}
.parcel.c0{background:linear-gradient(180deg,#7af2ff,#00c8e0);color:#002027;border-color:#9af6ff;box-shadow:0 8px 18px rgba(0,0,0,.45),0 0 16px rgba(0,229,255,.55)}
.parcel.c1{background:linear-gradient(180deg,#ff8ac0,#ff2e93);color:#2a0014;border-color:#ffb3d6;box-shadow:0 8px 18px rgba(0,0,0,.45),0 0 16px rgba(255,46,147,.55)}
.parcel.c2{background:linear-gradient(180deg,#fff08a,#ffd400);color:#2a2100;border-color:#fff6b3;box-shadow:0 8px 18px rgba(0,0,0,.45),0 0 16px rgba(255,212,0,.5)}
.parcel.c3{background:linear-gradient(180deg,#c6ff9a,#7cff3e);color:#0f2600;border-color:#dbffb8;box-shadow:0 8px 18px rgba(0,0,0,.45),0 0 16px rgba(124,255,62,.5)}
.parcel.dragging{filter:brightness(1.08);box-shadow:0 16px 32px rgba(0,0,0,.5),0 0 22px currentColor;z-index:20;transform:rotate(1deg) scale(1.04)}
.parcel.selected{outline:3px solid #fff;outline-offset:1px}
.parcel-icon{width:18px;height:18px;border-radius:4px;background:rgba(0,0,0,.12);display:grid;place-items:center;font-size:12px}
.burst{position:absolute;width:10px;height:10px;border-radius:50%;pointer-events:none;z-index:6}
.scorePop{position:absolute;font-weight:900;font-size:18px;text-shadow:0 2px 10px rgba(0,0,0,.6);pointer-events:none;z-index:7;animation:pop .7s ease forwards}
@keyframes pop{0%{transform:translateY(0) scale(.8);opacity:0}15%{opacity:1;transform:translateY(-6px) scale(1.05)}100%{transform:translateY(-36px) scale(1);opacity:0}}
.shake{animation:shake .35s ease}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-6px)}40%{transform:translateX(6px)}60%{transform:translateX(-4px)}80%{transform:translateX(4px)}}
.overlay{position:absolute;inset:0;display:grid;place-items:center;background:linear-gradient(180deg,rgba(8,12,26,.72),rgba(8,12,26,.88));backdrop-filter:blur(8px);z-index:10;padding:18px}
.modal{width:min(520px,92%);background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:20px 18px 16px;box-shadow:0 20px 60px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08);text-align:center}
.modal h2{margin:0 0 6px;font-size:26px;letter-spacing:-.5px}
.modal p{margin:0;color:var(--muted);line-height:1.5;font-size:13px}
.badges{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:14px 0 6px}
.badge{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06)}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0;text-align:left}
.step{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:10px}
.step b{font-size:12px;display:block;margin-bottom:4px}
.step span{font-size:11px;color:var(--muted);line-height:1.4;display:block}
.controls{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px}
.hint{margin-top:12px;font-size:11px;color:var(--muted)}
.pauseBadge{position:absolute;top:10px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.15);padding:6px 12px;border-radius:999px;font-weight:800;letter-spacing:.08em;font-size:11px;text-transform:uppercase;z-index:6;display:none}
.pauseBadge.show{display:block}
.footer{margin-top:10px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;color:var(--muted);font-size:11px}
.footer a{color:var(--muted);text-decoration:underline;text-underline-offset:2px}
@media(max-width:640px){
  #arena{height:560px}
  .chutes{height:86px;gap:6px;padding:8px 8px 10px}
  .tube{height:48px}
  .parcel{width:70px;height:48px;font-size:12px}
  .steps{grid-template-columns:1fr}
  .brand h1{font-size:19px}
}
@media(max-width:460px){
  .wrap{padding:12px 10px 20px}
  #arena{height:600px}
}
@media(max-width:380px){
  .wrap{padding:10px 8px 16px}
  #arena{height:620px}
  .chutes{height:80px;gap:5px;padding:6px 6px 8px}
  .tube{height:44px}
  .chute-label{font-size:10px;gap:4px}
  .chute-hint{font-size:9px}
  .parcel{width:70px;height:46px;font-size:11px}
  .stat{min-width:70px;padding:6px 8px}
  .stat strong{font-size:16px}
  .topbar{padding:10px 10px}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <div class="logo">⬢</div>
      <div>
        <h1><span>Neon Parcel Sorter</span></h1>
        <p>Drag glowing parcels into matching chutes — don’t let them hit the floor!</p>
      </div>
    </div>
    <div class="hud" aria-live="polite">
      <div class="stat"><b>Score</b><strong id="score">0</strong></div>
      <div class="stat"><b>Lives</b><strong id="livesTxt">5</strong><div class="lives" id="lives"></div></div>
      <div class="stat" style="min-width:110px"><b>Level</b><strong id="level">1</strong><div class="lvlWrap" aria-hidden="true"><div class="lvlFill" id="lvlFill"></div></div><div style="font-size:10px;color:var(--muted);margin-top:3px"><span id="lvlProgTxt">0</span>/400</div></div>
      <div class="stat"><b>Best</b><strong id="best">0</strong></div>
    </div>
  </header>

  <div class="card" id="card">
    <div class="topbar">
      <div class="topbar-left">
        <span><span class="kbd">Drag</span> or <span class="kbd">Tab</span> + <span class="kbd">1</span><span class="kbd">2</span><span class="kbd">3</span><span class="kbd">4</span></span>
        <span>• <span class="kbd">←</span><span class="kbd">→</span> move • <span class="kbd">P</span> pause</span>
      </div>
      <div style="display:flex;gap:8px">
        <button class="btn ghost" id="pauseBtn" aria-label="Pause game">⏸ Pause</button>
        <button class="btn ghost" id="restartBtn" aria-label="Restart game">↻ Restart</button>
      </div>
    </div>

    <div id="arena" class="scanlines" role="application" aria-label="Neon Parcel Sorter game arena">
      <div class="danger"><span>Drop zone — sort before impact</span></div>
      <div class="pauseBadge" id="pauseBadge">Paused — press P or Resume</div>

      <div class="chutes" id="chutes" aria-label="Delivery chutes">
        <!-- generated -->
      </div>

      <!-- overlays -->
      <div class="overlay" id="startOverlay">
        <div class="modal">
          <h2>Neon Parcel Sorter</h2>
          <p>Parcels fall from the sky. <b style="color:var(--text)">Drag</b> each glowing crate into the <b style="color:var(--text)">same-color chute</b> before it slams the floor. Miss or wrong chute costs a life. Reach <b style="color:var(--yel)">2000 pts</b> to win!</p>
          <div class="badges">
            <span class="badge" style="color:var(--cyan);border-color:rgba(0,229,255,.4)">● Cyan — 1</span>
            <span class="badge" style="color:var(--mag);border-color:rgba(255,46,147,.4)">● Magenta — 2</span>
            <span class="badge" style="color:var(--yel);border-color:rgba(255,212,0,.4)">● Yellow — 3</span>
            <span class="badge" style="color:var(--lime);border-color:rgba(124,255,62,.4)">● Lime — 4</span>
          </div>
          <div class="steps">
            <div class="step"><b>🖱 Drag & Drop</b><span>Grab any parcel and pull it into the glowing tube mouth.</span></div>
            <div class="step"><b>⌨ Keyboard</b><span>Tab to focus → Arrow keys move → 1-4 to auto-sort. Space to drop.</span></div>
            <div class="step"><b>⚡ Survive</b><span>+100 per correct, –1 life on miss/wrong. Speed ramps every 400 pts.</span></div>
          </div>
          <div class="controls">
            <button class="btn primary" id="startBtn" autofocus>▶ Start Sorting</button>
            <button class="btn" id="howBtn">How to play</button>
          </div>
          <div class="hint">Tip: parcels have a 28px snap zone — drag near the tube and it locks in. Works on touch too.</div>
        </div>
      </div>

      <div class="overlay" id="winOverlay" style="display:none">
        <div class="modal">
          <h2 style="color:var(--yel)">★ You Win! ★</h2>
          <p id="winMsg">You hit 2000 points — master sorter!</p>
          <div class="badges"><span class="badge" id="winScore">Score 2000</span><span class="badge" id="winLevel">Level 5</span></div>
          <div class="controls"><button class="btn primary" id="winRestart">Play Again</button></div>
        </div>
      </div>

      <div class="overlay" id="loseOverlay" style="display:none">
        <div class="modal">
          <h2 style="color:#ff5a7a">★ Out of Lives ★</h2>
          <p id="loseMsg">The floor ate too many parcels. Try again?</p>
          <div class="badges"><span class="badge" id="loseScore">Score 0</span><span class="badge" id="loseLevel">Level 1</span></div>
          <div class="controls"><button class="btn primary" id="loseRestart">Try Again</button></div>
        </div>
      </div>

      <div class="overlay" id="pauseOverlay" style="display:none">
        <div class="modal">
          <h2>⏸ Paused</h2>
          <p>Take a breather — parcels are frozen.</p>
          <div class="controls"><button class="btn primary" id="resumeBtn">Resume</button><button class="btn" id="pauseRestart2">Restart</button></div>
        </div>
      </div>

    </div>

    <div class="footer">
      <span>Self-contained • No build step • Best saved in this browser • <span id="status">Ready</span></span>
      <span>Built for keyboard + mouse + touch • Responsive down to 360px</span>
    </div>
  </div>
</div>

<script>
const COLORS=[
  {name:'Cyan',key:'1',cls:'c0',hex:'#00e5ff'},
  {name:'Magenta',key:'2',cls:'c1',hex:'#ff2e93'},
  {name:'Yellow',key:'3',cls:'c2',hex:'#ffd400'},
  {name:'Lime',key:'4',cls:'c3',hex:'#7cff3e'},
];
const WIN_SCORE=2000, MAX_LIVES=5, START_LIVES=5;
const LEVEL_EVERY=400;
const BASE_FALL=70; // px per second
const BASE_SPAWN=1100; // ms
const els={
  arena:document.getElementById('arena'),
  chutes:document.getElementById('chutes'),
  score:document.getElementById('score'),
  lives:document.getElementById('lives'),
  livesTxt:document.getElementById('livesTxt'),
  level:document.getElementById('level'),
  best:document.getElementById('best'),
  startOverlay:document.getElementById('startOverlay'),
  winOverlay:document.getElementById('winOverlay'),
  loseOverlay:document.getElementById('loseOverlay'),
  pauseOverlay:document.getElementById('pauseOverlay'),
  pauseBadge:document.getElementById('pauseBadge'),
  status:document.getElementById('status'),
  card:document.getElementById('card'),
};
let state={score:0,lives:START_LIVES,level:1,running:false,paused:false,best:0, raf:0, last:0, spawnAcc:0, spawnEvery:BASE_SPAWN, parcels:[], selectedId:null};
let audioCtx=null;
function beep(freq,dur,type='sine',gain=0.18){
  try{
    if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)();
    if(audioCtx.state==='suspended') audioCtx.resume();
    const o=audioCtx.createOscillator(), g=audioCtx.createGain();
    o.type=type; o.frequency.value=freq; g.gain.value=gain;
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime+dur);
    o.stop(audioCtx.currentTime+dur);
  }catch(e){}
}
function loadBest(){ try{ state.best=parseInt(localStorage.getItem('neonParcelBest')||'0',10)||0; }catch(e){} els.best.textContent=state.best; }
function saveBest(){ try{ if(state.score>state.best){ state.best=state.score; localStorage.setItem('neonParcelBest',String(state.best)); els.best.textContent=state.best; } }catch(e){} }

function renderLives(){
  els.lives.innerHTML='';
  for(let i=0;i<MAX_LIVES;i++){
    const h=document.createElement('span'); h.className='heart'+(i<state.lives?'':' empty'); els.lives.appendChild(h);
  }
  els.livesTxt.textContent=state.lives;
}
function renderHUD(){
  els.score.textContent=state.score;
  els.level.textContent=state.level;
  renderLives();
  // progress bar toward next level (0-400)
  const prog=state.score % LEVEL_EVERY;
  const pct=(prog/LEVEL_EVERY)*100;
  const fill=document.getElementById('lvlFill');
  const progTxt=document.getElementById('lvlProgTxt');
  if(fill) fill.style.width=pct+'%';
  if(progTxt) progTxt.textContent=prog;
  const lvl=Math.floor(state.score/LEVEL_EVERY)+1; if(lvl!==state.level){ state.level=lvl; els.level.textContent=lvl; pulseHUD(); levelUpTheater(lvl); }
  state.spawnEvery=Math.max(420, BASE_SPAWN - (state.level-1)*130);
  applyIntensity();
}
function pulseHUD(){ els.level.animate([{transform:'scale(1)'},{transform:'scale(1.25)'},{transform:'scale(1)'}],{duration:320}); }
function applyIntensity(){
  const i=state.level;
  document.documentElement.style.setProperty('--intensity', String(i));
  // scanlines and danger speed up with level
  const scanDur=Math.max(1.2, 3 - (i-1)*0.35)+'s';
  const dangerDur=Math.max(0.5, 1.4 - (i-1)*0.16)+'s';
  document.documentElement.style.setProperty('--scanDur', scanDur);
  document.documentElement.style.setProperty('--dangerDur', dangerDur);
  els.arena.dataset.intensity=i;
}
function levelUpTheater(lvl){
  // arena flash
  els.arena.classList.remove('lvlUp'); void els.arena.offsetWidth; els.arena.classList.add('lvlUp');
  // center LEVEL UP pop
  const pop=document.createElement('div'); pop.className='levelPop'; pop.textContent='Level '+lvl+'!';
  els.arena.appendChild(pop); setTimeout(()=>pop.remove(),850);
  // burst fanfare
  for(let k=0;k<lvl+1;k++) setTimeout(()=>spawnBurst(els.arena.clientWidth*(0.2+k*0.15), 120+Math.random()*40, COLORS[(lvl+k)%4].hex), k*90);
  // rising pitch fanfare scaled by level
  const base=640 + lvl*60;
  beep(base,0.12,'square',0.15); setTimeout(()=>beep(base+140,0.12,'square',0.14),110); setTimeout(()=>beep(base+280,0.22,'square',0.16),240);
  els.status.textContent='Level '+lvl+' — speed up!';
}

function buildChutes(){
  els.chutes.innerHTML='';
  COLORS.forEach((c,i)=>{
    const d=document.createElement('div');
    d.className='chute '+c.cls; d.dataset.idx=i; d.tabIndex=0; d.setAttribute('role','button'); d.setAttribute('aria-label',c.name+' chute press '+c.key);
    d.innerHTML=`<div class="tube"></div><div class="chute-label" style="color:${c.hex}">${c.name}</div><div class="chute-hint">Key ${c.key}</div>`;
    d.addEventListener('click',()=>tryDeliverTo(i));
    d.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); tryDeliverTo(i);} });
    els.chutes.appendChild(d);
  });
}
function tryDeliverTo(chuteIdx){
  // deliver selected or lowest parcel that matches? Prefer selected, else closest to bottom matching color, else lowest
  let target=null;
  if(state.selectedId!==null) target=state.parcels.find(p=>p.id===state.selectedId);
  if(!target) target=[...state.parcels].sort((a,b)=>b.y-a.y)[0];
  if(!target) return;
  deliver(target,chuteIdx);
}

function makeParcel(){
  const idx=Math.floor(Math.random()*4);
  const c=COLORS[idx];
  const id=Math.random().toString(36).slice(2,7);
  const el=document.createElement('div');
  el.className='parcel '+c.cls; el.tabIndex=0; el.dataset.id=id;
  el.setAttribute('role','button');
  el.setAttribute('aria-label',c.name+' parcel, drag to '+c.name+' chute or press '+c.key);
  el.innerHTML=`<span class="parcel-icon">▣</span> ${c.name}`;
  el.style.left=(14+Math.random()*(els.arena.clientWidth-100))+'px';
  el.style.top='-56px';
  // keyboard on parcel
  el.addEventListener('focus',()=> state.selectedId=id);
  el.addEventListener('keydown',e=>{
    if(e.key==='ArrowLeft'){ e.preventDefault(); moveParcelBy(id,-22,0); }
    else if(e.key==='ArrowRight'){ e.preventDefault(); moveParcelBy(id,22,0); }
    else if(e.key==='ArrowUp'){ e.preventDefault(); moveParcelBy(id,0,-18); }
    else if(e.key==='ArrowDown'){ e.preventDefault(); moveParcelBy(id,0,18); }
    else if(e.key===' '){ e.preventDefault(); dropFocused(); }
    else if(['1','2','3','4'].includes(e.key)){ e.preventDefault(); deliverById(id, parseInt(e.key,10)-1); }
  });
  // pointer drag
  let pointerId=null, startX=0, startY=0, origX=0, origY=0;
  el.addEventListener('pointerdown',e=>{
    if(!state.running||state.paused) return;
    e.preventDefault();
    el.setPointerCapture(e.pointerId);
    pointerId=e.pointerId;
    startX=e.clientX; startY=e.clientY;
    origX=parseFloat(el.style.left); origY=parseFloat(el.style.top);
    el.classList.add('dragging');
    state.selectedId=id;
    parcelById(id).dragging=true;
    beep(520,0.07,'square',0.08);
    el.focus();
  });
  el.addEventListener('pointermove',e=>{
    if(pointerId===null || e.pointerId!==pointerId) return;
    const dx=e.clientX-startX, dy=e.clientY-startY;
    let nx=origX+dx, ny=origY+dy;
    const pw=getParcelW(), ph=getParcelH();
    const maxX=els.arena.clientWidth-pw, maxY=els.arena.clientHeight-40;
    nx=Math.max(0,Math.min(maxX,nx)); ny=Math.max(-10,Math.min(maxY,ny));
    el.style.left=nx+'px'; el.style.top=ny+'px';
    const p=parcelById(id); if(p){ p.x=nx; p.y=ny; }
    highlightChutesAt(nx+pw/2, ny+ph/2);
  });
  const endDrag=(e)=>{
    if(pointerId===null || (e && e.pointerId!==pointerId)) return;
    try{ el.releasePointerCapture(pointerId); }catch{}
    pointerId=null;
    el.classList.remove('dragging');
    const p=parcelById(id); if(p) p.dragging=false;
    clearHighlights();
    // check drop into chute (expanded 28px snap zone)
    const rect=els.arena.getBoundingClientRect();
    const pw=getParcelW(), ph=getParcelH();
    const px=parseFloat(el.style.left)+pw/2, py=parseFloat(el.style.top)+ph/2;
    const hit=hitTestChute(px,py, rect);
    if(hit>=0){
      deliverById(id,hit);
    } else {
      // if dropped near bottom but not in chute, keep falling; give haptic nudge
      // if pointer released outside arena bottom, treat as miss? no.
    }
  };
  el.addEventListener('pointerup',endDrag);
  el.addEventListener('pointercancel',endDrag);
  els.arena.appendChild(el);
  const p={id, el, colorIdx:idx, x:parseFloat(el.style.left), y:-56, dragging:false, vy:0};
  state.parcels.push(p);
  // focus for keyboard users if first parcel
  if(state.parcels.length===1) setTimeout(()=>el.focus(),30);
  return p;
}
function getParcelW(){ return window.innerWidth<=640?70:76; }
function getParcelH(){ return window.innerWidth<=380?46:window.innerWidth<=640?48:52; }
function parcelById(id){ return state.parcels.find(p=>p.id===id); }
function moveParcelBy(id,dx,dy){
  const p=parcelById(id); if(!p) return;
  const pw=getParcelW();
  const maxX=els.arena.clientWidth-pw, maxY=els.arena.clientHeight-40;
  p.x=Math.max(0,Math.min(maxX,p.x+dx)); p.y=Math.max(-10,Math.min(maxY,p.y+dy));
  p.el.style.left=p.x+'px'; p.el.style.top=p.y+'px';
  highlightChutesAt(p.x+pw/2,p.y+getParcelH()/2);
  setTimeout(clearHighlights,300);
}
function dropFocused(){
  if(state.selectedId===null) return;
  const p=parcelById(state.selectedId); if(!p) return;
  const pw=getParcelW(), ph=getParcelH();
  const hit=hitTestChute(p.x+pw/2,p.y+ph/2, els.arena.getBoundingClientRect());
  if(hit>=0) deliver(p,hit);
}
function hitTestChute(px,py, arenaRect){
  // chutes are at bottom; use enlarged hit zone 28px beyond visual tube
  const chutes=[...els.chutes.children];
  for(let i=0;i<chutes.length;i++){
    const r=chutes[i].getBoundingClientRect();
    const exp=28;
    // expand top upward significantly to create snap zone
    const top=r.top - exp - 18;
    const left=r.left - exp/2;
    const right=r.right + exp/2;
    const bottom=r.bottom + 6;
    // convert px,py are relative to arena? px is arena-local, py arena-local. Need to map to viewport?
    // px/py are arena-local (0..arenaWidth). Convert to viewport by adding arenaRect.left/top
    const vx=arenaRect.left + px;
    const vy=arenaRect.top + py;
    if(vx>=left && vx<=right && vy>=top && vy<=bottom) return i;
  }
  return -1;
}
function highlightChutesAt(px,py){
  clearHighlights();
  const r=els.arena.getBoundingClientRect();
  const idx=hitTestChute(px,py,r);
  if(idx>=0) els.chutes.children[idx].classList.add('active');
}
function clearHighlights(){ [...els.chutes.children].forEach(c=>c.classList.remove('active')); }

function deliver(parcel, chuteIdx){
  const correct=parcel.colorIdx===chuteIdx;
  const chuteEl=els.chutes.children[chuteIdx];
  // animate snap into chute
  const pw=getParcelW(), ph=getParcelH();
  const targetRect=chuteEl.getBoundingClientRect();
  const arenaRect=els.arena.getBoundingClientRect();
  const tx= targetRect.left + targetRect.width/2 - arenaRect.left - pw/2;
  const ty= targetRect.top + 14 - arenaRect.top - ph/2;
  parcel.dragging=true;
  parcel.el.style.transition='left .22s cubic-bezier(.2,.9,.3,1), top .22s cubic-bezier(.2,.9,.3,1), transform .22s, opacity .22s';
  parcel.el.style.left=tx+'px'; parcel.el.style.top=ty+'px';
  parcel.el.style.transform='scale(.45)';
  parcel.el.style.opacity='.9';
  setTimeout(()=>{
    if(correct){
      state.score+=100;
      renderHUD();
      spawnBurst(tx+pw/2,ty+ph/2, COLORS[chuteIdx].hex);
      spawnScorePop(tx+pw/2,ty+10,'+100',COLORS[chuteIdx].hex);
      chuteEl.classList.add('correct'); setTimeout(()=>chuteEl.classList.remove('correct'),450);
      const freqBase=880 + (state.level-1)*38;
      beep(freqBase,0.12,'square',0.14); setTimeout(()=>beep(freqBase+220,0.12,'square',0.12),80);
      if(state.score>=WIN_SCORE) win();
      els.status.textContent='Sorted! +100';
    } else {
      state.lives-=1; renderHUD();
      spawnScorePop(tx+pw/2,ty+10,'WRONG', '#ff5a7a');
      chuteEl.animate([{transform:'translateX(0)'},{transform:'translateX(-6px)'},{transform:'translateX(6px)'},{transform:'translateX(0)'}],{duration:260});
      beep(220,0.24,'sawtooth',0.12); setTimeout(()=>beep(160,0.2,'sawtooth',0.12),140);
      els.card.classList.remove('shake'); void els.card.offsetWidth; els.card.classList.add('shake');
      els.status.textContent='Wrong chute!';
      if(state.lives<=0) lose();
    }
    removeParcel(parcel.id);
    parcel.el.style.transition='';
  },220);
}
function deliverById(id, chuteIdx){ const p=parcelById(id); if(p) deliver(p,chuteIdx); }

function spawnBurst(x,y,color){
  const count=10 + state.level*3;
  for(let i=0;i<count;i++){
    const b=document.createElement('div'); b.className='burst';
    b.style.left=x+'px'; b.style.top=y+'px'; b.style.background=color; b.style.boxShadow='0 0 10px '+color;
    els.arena.appendChild(b);
    const ang=Math.random()*Math.PI*2, dist=18+Math.random()*34, dur=380+Math.random()*260;
    b.animate([{transform:'translate(-50%,-50%) scale(1)',opacity:1},{transform:`translate(calc(-50% + ${Math.cos(ang)*dist}px), calc(-50% + ${Math.sin(ang)*dist}px)) scale(0)`,opacity:0}],{duration:dur,easing:'cubic-bezier(.2,.8,.3,1)'}).onfinish=()=>b.remove();
  }
}
function spawnScorePop(x,y,text,color){
  const d=document.createElement('div'); d.className='scorePop'; d.textContent=text;
  d.style.left=x+'px'; d.style.top=y+'px'; d.style.color=color; d.style.transform='translate(-50%,-50%)';
  els.arena.appendChild(d); setTimeout(()=>d.remove(),720);
}
function removeParcel(id){
  const idx=state.parcels.findIndex(p=>p.id===id);
  if(idx>=0){
    const p=state.parcels[idx];
    try{ p.el.remove(); }catch{}
    state.parcels.splice(idx,1);
    if(state.selectedId===id) state.selectedId=state.parcels[0]?.id||null;
    if(state.selectedId) parcelById(state.selectedId)?.el.focus();
  }
}

function miss(parcel){
  state.lives-=1; renderHUD();
  const pw=getParcelW();
  spawnScorePop(parcel.x+pw/2, parcel.y+10, 'MISS', '#ff6b84');
  beep(180,0.3,'sawtooth',0.13);
  els.card.classList.remove('shake'); void els.card.offsetWidth; els.card.classList.add('shake');
  els.status.textContent='Missed!';
  removeParcel(parcel.id);
  if(state.lives<=0) lose();
}

function loop(now){
  if(!state.running||state.paused){ state.last=now; state.raf=requestAnimationFrame(loop); return; }
  if(!state.last) state.last=now;
  const dt=Math.min(48, now - state.last)/1000; state.last=now;
  // falling
  const speed=BASE_FALL + (state.level-1)*42 + Math.min(60, state.score/30);
  for(const p of [...state.parcels]){
    if(p.dragging) continue;
    // auto drift slight wobble?
    p.y += speed * dt * (1 + Math.sin(now*0.001 + p.x)*0.06);
    // keep x within bounds
    p.el.style.top=p.y+'px';
    // if hits bottom danger line (~ arenaHeight-92)
    const floorY=els.arena.clientHeight - 42; // parcel height 52, so top at floorY means bottom at floorY+52
    if(p.y >= floorY){
      miss(p);
    }
  }
  // spawn
  state.spawnAcc+=dt*1000;
  if(state.spawnAcc >= state.spawnEvery){
    state.spawnAcc=0;
    if(state.parcels.length<9) makeParcel();
  }
  state.raf=requestAnimationFrame(loop);
}

function win(){
  if(!state.running) return;
  state.running=false; cancelAnimationFrame(state.raf);
  saveBest();
  document.getElementById('winScore').textContent='Score '+state.score;
  document.getElementById('winLevel').textContent='Level '+state.level;
  document.getElementById('winMsg').textContent=`You sorted ${state.score/100} parcels — neon mastery!`;
  els.winOverlay.style.display='grid';
  els.status.textContent='You win!';
  for(let i=0;i<3;i++) setTimeout(()=>spawnBurst(els.arena.clientWidth*(0.25+i*0.25), 160, COLORS[i%4].hex), i*180);
  beep(660,0.14,'square',0.15); setTimeout(()=>beep(880,0.14,'square',0.15),140); setTimeout(()=>beep(1100,0.3,'square',0.16),280);
}
function lose(){
  if(!state.running) return;
  state.running=false; cancelAnimationFrame(state.raf);
  saveBest();
  document.getElementById('loseScore').textContent='Score '+state.score;
  document.getElementById('loseLevel').textContent='Level '+state.level;
  document.getElementById('loseMsg').textContent=`Final ${state.score} pts — level ${state.level}. The floor won this round.`;
  els.loseOverlay.style.display='grid';
  els.status.textContent='Game over';
  beep(220,0.3,'sawtooth',0.14); setTimeout(()=>beep(160,0.5,'sawtooth',0.14),220);
}
function startGame(){
  // reset
  state.score=0; state.lives=START_LIVES; state.level=1; state.spawnEvery=BASE_SPAWN; state.spawnAcc=0; state.selectedId=null;
  applyIntensity();
  state.parcels.forEach(p=>{ try{p.el.remove()}catch{}}); state.parcels=[];
  // clear bursts/pops left
  els.arena.querySelectorAll('.burst,.scorePop').forEach(e=>e.remove());
  [...els.arena.children].forEach(c=>{ if(c.classList.contains('burst')||c.classList.contains('scorePop')) c.remove(); });
  renderHUD(); els.status.textContent='Sorting…';
  els.startOverlay.style.display='none'; els.winOverlay.style.display='none'; els.loseOverlay.style.display='none'; els.pauseOverlay.style.display='none';
  els.pauseBadge.classList.remove('show');
  state.running=true; state.paused=false;
  document.getElementById('pauseBtn').textContent='⏸ Pause';
  state.last=0; cancelAnimationFrame(state.raf); state.raf=requestAnimationFrame(loop);
  // initial parcels staggered
  setTimeout(()=>{ if(state.running) makeParcel(); }, 420);
  setTimeout(()=>{ if(state.running) makeParcel(); }, 900);
  beep(520,0.09,'square',0.1);
}
function togglePause(){
  if(!state.running) return;
  state.paused=!state.paused;
  if(state.paused){
    els.pauseOverlay.style.display='grid'; els.pauseBadge.classList.add('show');
    document.getElementById('pauseBtn').textContent='▶ Resume';
    els.status.textContent='Paused';
  } else {
    els.pauseOverlay.style.display='none'; els.pauseBadge.classList.remove('show');
    document.getElementById('pauseBtn').textContent='⏸ Pause';
    els.status.textContent='Sorting…';
    state.last=0;
  }
}

buildChutes(); loadBest(); renderHUD();

// events
document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('howBtn').addEventListener('click', ()=>{
  // brief highlight chutes
  [...els.chutes.children].forEach((c,i)=> setTimeout(()=>{ c.classList.add('active'); setTimeout(()=>c.classList.remove('active'),420); }, i*120));
  beep(700,0.08,'sine',0.09);
});
document.getElementById('pauseBtn').addEventListener('click', togglePause);
document.getElementById('restartBtn').addEventListener('click', startGame);
document.getElementById('winRestart').addEventListener('click', startGame);
document.getElementById('loseRestart').addEventListener('click', startGame);
document.getElementById('resumeBtn').addEventListener('click', togglePause);
document.getElementById('pauseRestart2').addEventListener('click', startGame);

window.addEventListener('keydown', e=>{
  if(e.key.toLowerCase()==='p'){
    if(state.running){ e.preventDefault(); togglePause(); }
  } else if(e.key==='Escape' && state.paused){ togglePause(); }
  // when no parcel focused, 1-4 still sorts lowest parcel (global fallback)
  if(['1','2','3','4'].includes(e.key) && document.activeElement && document.activeElement.classList.contains('parcel')) {
    // let parcel handler do it, prevent double
    return;
  }
  if(['1','2','3','4'].includes(e.key) && state.running && !state.paused){
    // if focus is not a parcel, sort lowest
    if(!document.activeElement.classList.contains('parcel')){
      e.preventDefault(); tryDeliverTo(parseInt(e.key,10)-1);
    }
  }
});

// focus management helpers for screen readers
els.arena.addEventListener('click', e=>{
  if(e.target===els.arena) state.selectedId=null;
});

// expose for verifier
window.__game={state, startGame, makeParcel, els, COLORS, renderHUD, applyIntensity};

</script>

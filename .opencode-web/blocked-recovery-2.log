const { chromium } = require('playwright-core');
(async () => {
  const browser = await chromium.launch({ args: ['--use-gl=swiftshader','--enable-unsafe-swiftshader','--no-sandbox'] });
  const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
  page.on('pageerror', e => console.log('PAGEERROR:', String(e).slice(0,200)));
  await page.goto('file:///var/folders/d8/hvxvltxn0fl4rmnd52sncbth0000gn/T/opencode/inline-test.html', { waitUntil: 'networkidle', timeout: 60000 });
  await page.waitForTimeout(5000);
  await page.click('#playBtn').catch(()=>{});
  await page.waitForTimeout(3000);
  for (let i=0;i<8;i++){ await page.evaluate(() => window.__game.debugKillNearest()); await page.waitForTimeout(110); }
  await page.keyboard.press('r');
  await page.waitForTimeout(700);
  const mid = await page.evaluate(() => ({ reloading: window.__game.gun.reloading, tip: document.getElementById('reloadtip').textContent }));
  await page.screenshot({ path: 'screenshots/reload.png' });
  await page.waitForTimeout(1200);
  const done = await page.evaluate(() => ({ mag: window.__game.gun.mag, reserve: window.__game.gun.reserve, tip: document.getElementById('reloadtip').textContent }));
  console.log('MID:', JSON.stringify(mid), 'DONE:', JSON.stringify(done));
  await browser.close();
})().catch(e => { console.error('FATAL', e); process.exit(1); });

const fs = require('fs'), vm = require('vm');
const html = fs.readFileSync('lantern-lanes/index.html','utf8');
const src = html.match(/<script>([\s\S]*)<\/script>/)[1];

function mkEl(){
  return {
    innerHTML:'', textContent:'',
    style:{}, classList:{add(){},remove(){}},
    getBoundingClientRect:()=>({width:920,height:600}),
    addEventListener(){},
    querySelector:()=>({addEventListener(){}, getAttribute:()=>'start', click(){}}),
  };
}
const els = { game:mkEl(), overlay:mkEl(), panel:mkEl(), hEmbers:mkEl(), hHearts:mkEl(), hTime:mkEl(), hFlame:mkEl(), flameFill:mkEl(), stage:mkEl(), tUp:mkEl(), tDown:mkEl(), tDash:mkEl() };
const grad = { addColorStop(){} };
const ctxStub = new Proxy({}, { get:(t,p)=>{
  if(p==='createLinearGradient'||p==='createRadialGradient') return ()=>grad;
  if(p==='canvas') return {};
  return typeof p==='string' ? (...a)=>{} : undefined;
}, set:()=>true });
els.game.getContext = ()=>ctxStub;

const listeners = {};
const sandbox = {
  document:{ getElementById:(id)=>els[id]||mkEl() },
  window:{}, performance:{now:()=>0}, localStorage:{getItem:()=>'0',setItem(){}},
  requestAnimationFrame:(fn)=>{ sandbox.__raf = fn; },
  addEventListener:(t,f)=>{ (listeners[t]=listeners[t]||[]).push(f); },
  setTimeout:(f)=>0, clearTimeout:()=>{},
  console,
};
sandbox.globalThis = sandbox; sandbox.window = sandbox;
vm.createContext(sandbox);
vm.runInContext(src, sandbox, {filename:'game.js'});

const S = sandbox;
const ok = (c,m)=>{ console.log((c?'PASS':'FAIL'),m); if(!c) process.exitCode=1; };

// 1. title state
ok(S.state==='title','boot -> title state');
ok(els.panel.innerHTML.includes('Lantern Lanes'),'title panel tutorial text');

// 2. start via Enter
listeners.keydown.forEach(f=>f({key:'Enter',preventDefault(){},repeat:false}));
ok(S.state==='playing','Enter starts playing');
ok(els.overlay.classList,'overlay hidden after start');

// 3. lane movement
const l0=S.player.lane;
listeners.keydown.forEach(f=>f({key:'ArrowDown',preventDefault(){},repeat:false}));
ok(S.player.lane===Math.min(2,l0+1),'ArrowDown switches lane down');
listeners.keydown.forEach(f=>f({key:'w',preventDefault(){},repeat:false}));
ok(S.player.lane===l0,'W switches lane up');

// 4. dash
S.dashCd=0; S.doDash();
ok(S.dashT>0 && S.dashCd>0,'Space dash activates shield+cooldown');

// 5. ember collect: place ember on player, run update
S.dashT=0; S.player.inv=0;
const c0=S.collected;
S.embers.push({x:S.player.x,y:S.player.y,lane:S.player.lane,r:13,bob:0,got:false});
S.update(0.016);
ok(S.collected===c0+1,'ember collect increments + HUD '+els.hEmbers.textContent);
ok(els.hEmbers.textContent.includes((c0+1)+'/12'),'HUD embers shows n/12');

// 6. moth damage
S.player.inv=0; S.dashT=0;
const h0=S.hearts;
S.moths.push({x:S.player.x,y:S.player.y,lane:S.player.lane,r:17,vx:200,wing:0,drift:0});
S.update(0.016);
ok(S.hearts===h0-1,'moth hit costs 1 heart, HUD='+els.hHearts.textContent);

// 7. dash shield destroys moth without damage
S.player.inv=0; const h1=S.hearts; S.dashT=0.5;
S.moths.push({x:S.player.x,y:S.player.y,lane:S.player.lane,r:17,vx:200,wing:0,drift:0});
S.update(0.016);
ok(S.hearts===h1,'dashing through moth = no damage');

// 8. pause/resume via P (no reset)
const e1=S.elapsed;
listeners.keydown.forEach(f=>f({key:'p',preventDefault(){},repeat:false}));
ok(S.state==='paused','P pauses');
listeners.keydown.forEach(f=>f({key:'p',preventDefault(){},repeat:false}));
ok(S.state==='playing','P resumes without reset');

// 9. Resume button path (fixed bug): paused + onPrimary start => resume
listeners.keydown.forEach(f=>f({key:'p',preventDefault(){},repeat:false}));
S.collected=5; S.onPrimary({currentTarget:{getAttribute:()=>'start'}});
ok(S.state==='playing'&&S.collected===5,'Resume button resumes, keeps progress');

// 10. win: force 12 embers
S.startPlay(); S.collected=11; S.player.inv=1;
S.embers.push({x:S.player.x,y:S.player.y,lane:S.player.lane,r:13,bob:0,got:false});
S.update(0.016);
ok(S.state==='win','12th ember -> win');
ok(els.panel.innerHTML.includes('Festival Lit'),'win panel Festival Lit');
// win fx keeps animating
const ns=S.sparks.length; S.updateFx(0.1);
ok(true,'win fx update runs, sparks='+S.sparks.length);

// 11. restart via R after win
listeners.keydown.forEach(f=>f({key:'r',preventDefault(){},repeat:false}));
ok(S.state==='playing'&&S.collected===0&&S.hearts===3,'R restarts fresh run');

// 12. lose by hearts
S.hearts=1; S.player.inv=0; S.dashT=0;
S.moths.push({x:S.player.x,y:S.player.y,lane:S.player.lane,r:17,vx:200,wing:0,drift:0});
S.update(0.016);
ok(S.state==='lose','0 hearts -> lose');
ok(els.panel.innerHTML.includes('Lantern Out'),'lose panel Lantern Out');

// 13. lose by timeout
S.startPlay(); S.timeLeft=0.01; S.update(0.05);
ok(S.state==='lose','timer expiry -> lose');

// 14. render each state without throwing + responsive fit sizes
for(const st of ['title','playing','paused','win','lose']){ S.state=st; S.render(1.5); }
ok(true,'render() OK in all 5 states');
S.fit();
ok(/px$/.test(els.game.style.width),'fit() sets aspect-preserved px size '+els.game.style.width+'x'+els.game.style.height);
console.log(process.exitCode ? 'HARNESS FAILURES' : 'ALL_PLAYTEST_PASS');
EOF

const { chromium } = require('playwright-core');
(async()=>{
  const browser = await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']});
  const page = await browser.newPage({viewport:{width:900,height:800}, hasTouch:true});
  const errs=[];
  page.on('pageerror',e=>errs.push('pageerror:'+e.message));
  page.on('console',m=>{if(m.type()==='error')errs.push('console:'+m.text());});
  await page.goto('file:///home/runner/work/PlayGround/PlayGround/index.html');
  await page.waitForTimeout(500);
  await page.click('#startBtn');
  await page.waitForTimeout(300);
  // steer toward nearest spark using keyboard, up to 8s
  let collected=false;
  for(let i=0;i<40;i++){
    const f = await page.evaluate(()=>({s:window.__neon.state(), f:window.__neon.field()}));
    if(f.s.state!=='play') break;
    if(f.s.score>0){collected=true;break;}
    let best=null,bd=1e9;
    for(const sp of f.f.sparks){const d=Math.hypot(sp.x-f.f.px,sp.y-f.f.py);if(d<bd){bd=d;best=sp;}}
    const dx=best.x-f.f.px, dy=best.y-f.f.py;
    const keys=[];
    if(Math.abs(dx)>14) keys.push(dx>0?'ArrowRight':'ArrowLeft');
    if(Math.abs(dy)>14) keys.push(dy>0?'ArrowDown':'ArrowUp');
    for(const k of keys) await page.keyboard.down(k);
    await page.waitForTimeout(200);
    for(const k of keys) await page.keyboard.up(k);
  }
  const afterKeys = await page.evaluate(()=>window.__neon.state());
  await page.screenshot({path:'/tmp/opencode/neon-5-collect.png'});
  // clean touch test: restart, then tap-drag on canvas while playing
  await page.evaluate(()=>window.__neon.start());
  await page.waitForTimeout(300);
  const bb = await page.evaluate(()=>{const r=document.getElementById('game').getBoundingClientRect();return {x:r.x,y:r.y,w:r.width,h:r.height};});
  const before = await page.evaluate(()=>window.__neon.state());
  await page.touchscreen.tap(bb.x+bb.w*0.75, bb.y+bb.h*0.25);
  await page.waitForTimeout(600);
  const afterTap = await page.evaluate(()=>window.__neon.state());
  // rings visible after waiting?
  await page.evaluate(()=>window.__neon.start());
  await page.keyboard.down('ArrowRight'); await page.waitForTimeout(250); await page.keyboard.up('ArrowRight');
  await page.keyboard.down('ArrowUp'); await page.waitForTimeout(250); await page.keyboard.up('ArrowUp');
  await page.waitForTimeout(2200);
  const ringCheck = await page.evaluate(()=>window.__neon.field());
  await page.screenshot({path:'/tmp/opencode/neon-6-rings.png'});
  console.log(JSON.stringify({collected, afterKeys, before, afterTap, ringsSeen:ringCheck.rings.length, ringWarn: ringCheck.rings.map(r=>r.warn), errs}));
  await browser.close();
})().catch(e=>{console.error('FAIL '+e.stack);process.exit(1);});

import { chromium } from 'playwright-core';
const browser = await chromium.launch();
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
const errors = [];
page.on('pageerror', e => errors.push(String(e)));
await page.goto('file:///Users/runner/work/PlayGround/PlayGround/index.html');
await page.waitForTimeout(800);
await page.click('#btn-start');
await page.waitForTimeout(500);
// install aimbot: each 100ms aim at nearest live enemy (screen coords) and hold fire
await page.evaluate(() => {
  window.__bot = setInterval(() => {
    if (G.mode !== 'play') return;
    if (!G.enemies.length) { mouse.down = false; return; }
    let best = null, bd = 1e9;
    for (const e of G.enemies) { const d = (e.x - P.x) ** 2 + (e.y - P.y) ** 2; if (d < bd) { bd = d; best = e; } }
    if (best) {
      mouse.x = (best.x - cam.cx) * cam.zoom + 1280 / 2;
      mouse.y = (best.y - cam.cy) * cam.zoom + 800 / 2;
      // lead slightly: fire in bursts is automatic; hold trigger
      if (P.reloading <= 0 && P.mag > 0) mouse.down = true; else mouse.down = false;
      // kite: back away from nearest rusher
      keys['w'] = false; keys['a'] = false; keys['s'] = false; keys['d'] = false;
      if (bd < 300 * 300) { // too close: retreat south
        keys['s'] = P.y < best.y ? false : true;
      }
    }
  }, 100);
});
// strafe via keyboard events too (keys set directly above); wait for waves
let lastWave = 0;
for (let i = 0; i < 90; i++) {
  await page.waitForTimeout(2000);
  const s = await page.evaluate(() => ({ mode: G.mode, wave: G.wave, foes: G.enemies.length + G.spawnQueue.length, kills: G.kills, hp: Math.round(P.hp), ext: G.extractActive, t: Math.round(G.time) }));
  if (s.wave !== lastWave || s.ext) { console.log('T+' + s.t + 's', JSON.stringify(s)); lastWave = s.wave; }
  if (s.ext) break;
  if (s.mode !== 'play') { console.log('UNEXPECTED MODE', JSON.stringify(s)); break; }
}
let s = await page.evaluate(() => ({ mode: G.mode, wave: G.wave, kills: G.kills, ext: G.extractActive, hp: Math.round(P.hp) }));
console.log('PRE-EXTRACT ' + JSON.stringify(s));
if (s.ext) {
  await page.evaluate(() => { P.x = extractZone.x + extractZone.w / 2; P.y = extractZone.y + extractZone.h / 2; });
  await page.waitForTimeout(800);
  const w = await page.evaluate(() => G.mode);
  console.log('WIN MODE = ' + w);
  await page.screenshot({ path: '/tmp/shot-win.png' });
  // restart -> lose path
  await page.click('#btn-restart');
  await page.waitForTimeout(500);
  await page.evaluate(() => { clearInterval(window.__bot); P.hp = 5; P.lastHurt = G.time; G.enemies.push({ type: 'rush', x: P.x + 20, y: P.y, r: 13, hp: 45, maxhp: 45, speed: 200, atkCd: 0, flash: 0 }); });
  await page.waitForTimeout(2500);
  console.log('LOSE MODE = ' + await page.evaluate(() => G.mode));
  await page.screenshot({ path: '/tmp/shot-lose.png' });
  // redeploy again
  await page.click('#btn-restart');
  await page.waitForTimeout(800);
  console.log('RESTART MODE = ' + await page.evaluate(() => ({ mode: G.mode, wave: G.wave, hp: P.hp })));
}
console.log('PAGEERRORS ' + JSON.stringify(errors.slice(0, 8)));
await browser.close();
EOF

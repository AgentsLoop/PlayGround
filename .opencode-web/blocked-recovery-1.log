const { chromium } = require('playwright-core');
(async()=>{
  const browser = await chromium.launch({executablePath:'/usr/bin/chromium',args:['--no-sandbox']});
  const page = await browser.newPage({viewport:{width:900,height:800}});
  const errs=[];
  page.on('pageerror',e=>errs.push('pageerror:'+e.message));
  page.on('console',m=>{if(m.type()==='error')errs.push('console:'+m.text());});
  await page.goto('file:///home/runner/work/PlayGround/PlayGround/index.html');
  await page.waitForTimeout(400);
  await page.click('#startBtn');
  // synthetic touch-drag: hold pointer on canvas lower-left, player should veer toward it
  const drag = await page.evaluate(()=>{
    const c=document.getElementById('game'); const r=c.getBoundingClientRect();
    const cx=r.left+r.width*0.2, cy=r.top+r.height*0.75;
    const opts={bubbles:true,cancelable:true,pointerId:7,pointerType:'touch',isPrimary:true,clientX:cx,clientY:cy};
    c.dispatchEvent(new PointerEvent('pointerdown',opts));
    return new Promise(res=>setTimeout(()=>{
      const s=window.__neon.state();
      window.dispatchEvent(new PointerEvent('pointerup',opts));
      res(s);
    },700));
  });
  // survival loop: orbit center to stay alive until rings expand
  await page.evaluate(()=>window.__neon.start());
  const pattern=[['ArrowLeft',350],['ArrowDown',350],['ArrowRight',450],['ArrowUp',450],['ArrowLeft',450],['ArrowDown',350]];
  for(const [k,ms] of pattern){ await page.keyboard.down(k); await page.waitForTimeout(ms); await page.keyboard.up(k);
    const s=await page.evaluate(()=>window.__neon.state()); if(s.state!=='play') break; }
  const surv = await page.evaluate(()=>({s:window.__neon.state(),f:window.__neon.field()}));
  await page.screenshot({path:'/tmp/opencode/neon-7-survive.png'});
  console.log(JSON.stringify({drag, surv, errs}));
  await browser.close();
})().catch(e=>{console.error('FAIL '+e.stack);process.exit(1);});

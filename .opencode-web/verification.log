const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ args: ['--no-sandbox'] });
  const page = await browser.newPage();
  await page.goto('http://127.0.0.1:3000/', { waitUntil: 'networkidle' });
  await page.click('#startBtn');
  await page.waitForTimeout(500);
  console.log('started', await page.evaluate(() => window.__lanternMoth.getState()));
  // inspect pollen
  let info = await page.evaluate(() => {
    const g = window.__lanternMoth;
    return {
      moth: {x:g.moth.x, y:g.moth.y},
      pollen: g.pollen.map(p=>({x:p.x,y:p.y,phase:p.phase})),
      spiders: g.spiders.map(s=>({x:s.x,y:s.y,r:s.r}))
    };
  });
  console.log(JSON.stringify(info, null, 2));
  // try direct collection: set moth to first pollen exactly including yoff
  await page.evaluate(() => {
    const g = window.__lanternMoth;
    const p = g.pollen[0];
    const yoff = Math.sin(p.phase)*5;
    console.log('pollen yoff', yoff);
    g.moth.x = p.x;
    g.moth.y = p.y + yoff;
    console.log('teleported to pollen at', g.moth.x, g.moth.y, 'pollen at', p.x, p.y+yoff);
  });
  // wait multiple frames
  await page.waitForTimeout(300);
  let after = await page.evaluate(() => ({score: window.__lanternMoth.getScore(), light: window.__lanternMoth.getLightBoost(), moth: {x: window.__lanternMoth.moth.x, y: window.__lanternMoth.moth.y}, pollenCount: window.__lanternMoth.pollen.length}));
  console.log('after 300ms', after);
  await page.waitForTimeout(500);
  after = await page.evaluate(() => ({score: window.__lanternMoth.getScore(), light: window.__lanternMoth.getLightBoost(), pollen: window.__lanternMoth.pollen[0]}));
  console.log('after 800ms', after);
  // try triggering damage manually
  let beforeLives = await page.evaluate(()=> window.__lanternMoth.getLives());
  console.log('beforeLives', beforeLives);
  await page.evaluate(()=> {
    const g=window.__lanternMoth;
    g.moth.invuln=0;
    // force position exactly at spider center
    const s=g.spiders[0];
    g.moth.x=s.x;
    g.moth.y=s.y;
    console.log('teleported to spider', s.x,s.y, 'moth', g.moth.x,g.moth.y, 'dist', Math.hypot(s.x-g.moth.x,s.y-g.moth.y));
  });
  await page.waitForTimeout(300);
  console.log('after spider teleport', await page.evaluate(()=> ({lives: window.__lanternMoth.getLives(), invuln: window.__lanternMoth.moth.invuln, state: window.__lanternMoth.getState()})));
  await page.waitForTimeout(500);
  console.log('after 800', await page.evaluate(()=> ({lives: window.__lanternMoth.getLives(), invuln: window.__lanternMoth.moth.invuln})));
  await browser.close();
})();

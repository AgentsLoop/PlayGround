  await page.goto(BASE+'/index.html', {waitUntil:'domcontentloaded'});
  await page.waitForTimeout(700);
  // 1 - server serves 200 and title
  const title = await page.title();
  assert('title is Neon Harbor Catch', title==='Neon Harbor Catch', `got ${title}`);
  assert('canvas visible', await page.locator('#game').isVisible());
  assert('startOverlay visible initially', await page.locator('#startOverlay').isVisible() && !(await page.locator('#startOverlay').evaluate(el=>el.classList.contains('hidden'))));
  assert('score 0 initially', (await page.locator('#scoreEl').textContent())==='0');
  assert('lives 3 hearts visible', await page.locator('#livesEl .heart').count()===3);
  assert('speed 1.0× initially', (await page.locator('#speedEl').textContent())==='1.0×');
  // 2 - start game
  await page.click('#startBtn');
  await page.waitForTimeout(400);
  assert('after start, startOverlay hidden', await page.locator('#startOverlay').evaluate(el=>el.classList.contains('hidden')));
  assert('state playing after start', await page.evaluate(()=> window.__game.state)==='playing');
  // 3 - keyboard controls
  const xBefore = await page.evaluate(()=> window.__game.boat.x);
  await page.keyboard.down('ArrowLeft');
  await page.waitForTimeout(300);
  await page.keyboard.up('ArrowLeft');
  const xLeft = await page.evaluate(()=> window.__game.boat.x);
  assert('ArrowLeft moves left', xLeft < xBefore, `${xLeft} < ${xBefore}`);
  await page.keyboard.down('d');
  await page.waitForTimeout(300);
  await page.keyboard.up('d');
  const xRight = await page.evaluate(()=> window.__game.boat.x);
  assert('D moves right', xRight > xLeft, `${xRight} > ${xLeft}`);
  // 4 - A key moves left as well
  await page.keyboard.down('a');
  await page.waitForTimeout(200);
  await page.keyboard.up('a');
  const xA = await page.evaluate(()=> window.__game.boat.x);
  assert('A moves left', xA < xRight);
  // 5 - catch buoy via injection - test floatingTexts
  await page.evaluate(()=> {
    const g=window.__game;
    g.objects.push({x:g.boat.x+g.boat.w/2-16, y:g.boat.y+6, w:32,h:32, type:'buoy', pts:30, color:'#00f0ff', vy:0, rot:0, rotV:0, glow:'#00f0ff'});
  });
  await page.waitForTimeout(180);
  const afterCatch = await page.evaluate(()=> ({score:window.__game.score, lives:window.__game.lives, ftLen: window.__game.floatingTexts.length, ftText: window.__game.floatingTexts[0]?.text}));
  assert('catch buoy increments score by 30', afterCatch.score===30, `score ${afterCatch.score}`);
  assert('floatingTexts shows +30', afterCatch.ftText==='+30', `ft ${afterCatch.ftText}`);
  assert('HIT not yet', afterCatch.ftLen===1);
  // 6 - catch high-value buoy 50
  await page.evaluate(()=> {
    const g=window.__game;
    g.objects.push({x:g.boat.x+g.boat.w/2-21, y:g.boat.y+6, w:42,h:42, type:'buoy', pts:50, color:'#fff', vy:0, rot:0, rotV:0, glow:'#fff'});
  });
  await page.waitForTimeout(180);
  const after50 = await page.evaluate(()=> ({score:window.__game.score, ft: window.__game.floatingTexts.map(f=>f.text)}));
  assert('catch 50 increments to 80', after50.score===80, `score ${after50.score}`);
  assert('floatingTexts includes +50', after50.ft.includes('+50'));
  // 7 - mine hit
  await page.evaluate(()=> {
    const g=window.__game;
    g.objects.push({x:g.boat.x+g.boat.w/2-17, y:g.boat.y+6, w:34,h:34, type:'mine', vy:0, rot:0, rotV:0, glow:'#ff2a6d'});
  });
  await page.waitForTimeout(180);
  const afterMine = await page.evaluate(()=> ({lives:window.__game.lives, score:window.__game.score, ft: window.__game.floatingTexts.map(f=>f.text)}));
  assert('mine hit reduces lives 3->2', afterMine.lives===2, `lives ${afterMine.lives}`);
  assert('floating HIT! shown', afterMine.ft.includes('HIT!'));
  // 8 - pause
  await page.keyboard.press('p');
  await page.waitForTimeout(350);
  assert('P pauses', await page.evaluate(()=> window.__game.state)==='paused' && await page.locator('#pauseOverlay').isVisible());
  await page.keyboard.press('p');
  await page.waitForTimeout(350);
  assert('P resumes', await page.evaluate(()=> window.__game.state)==='playing');
  // 9 - game over by draining lives
  await page.evaluate(()=> {
    const g=window.__game;
    for(let i=0;i<2;i++) g.objects.push({x:g.boat.x+g.boat.w/2-17, y:g.boat.y+6, w:34,h:34, type:'mine', vy:0, rot:0, rotV:0, glow:'#ff2a6d'});
  });
  await page.waitForTimeout(500);
  const over = await page.evaluate(()=> ({state:window.__game.state, lives:window.__game.lives}));
  assert('lives 0 -> game over', over.state==='over' && over.lives===0, JSON.stringify(over));
  assert('gameOverOverlay visible', await page.locator('#gameOverOverlay').isVisible());
  // 10 - restart via R
  await page.keyboard.press('r');
  await page.waitForTimeout(400);
  assert('R restarts', await page.evaluate(()=> window.__game.state)==='playing' && await page.evaluate(()=> window.__game.lives)===3 && await page.evaluate(()=> window.__game.score)===0);
  // 11 - restart via Enter after forcing over again
  await page.evaluate(()=> {
    const g=window.__game;
    for(let i=0;i<3;i++) g.objects.push({x:g.boat.x+g.boat.w/2-17, y:g.boat.y+6, w:34,h:34, type:'mine', vy:0, rot:0, rotV:0, glow:'#ff2a6d'});
  });
  await page.waitForTimeout(500);
  assert('second over', await page.evaluate(()=> window.__game.state)==='over');
  await page.keyboard.press('Enter');
  await page.waitForTimeout(400);
  assert('Enter restarts', await page.evaluate(()=> window.__game.state)==='playing');
  // 12 - increasing speed: score 250 -> level 2
  // directly test logic: push enough buoys to reach 250
  await page.evaluate(()=> {
    const g=window.__game;
    // reset to ensure clean
    g.objects.length=0;
    // artificially set score near threshold and then catch
    // We'll inject multiple 50pt buoys
    for(let i=0;i<5;i++){
      g.objects.push({x:g.boat.x+g.boat.w/2-16, y:g.boat.y+6, w:32,h:32, type:'buoy', pts:50, color:'#00f0ff', vy:0, rot:0, rotV:0, glow:'#00f0ff'});
    }
  });
  // need sequential catches - do one by one with delays
  for(let i=0;i<4;i++){
    await page.waitForTimeout(180);
    await page.evaluate(()=> {
      const g=window.__game;
      if(g.state!=='playing') return;
      g.objects.push({x:g.boat.x+g.boat.w/2-16, y:g.boat.y+6, w:32,h:32, type:'buoy', pts:50, color:'#00f0ff', vy:0, rot:0, rotV:0, glow:'#00f0ff'});
    });
  }
  await page.waitForTimeout(300);
  const lvl = await page.evaluate(()=> ({score:window.__game.score, lvl: document.getElementById('levelEl').textContent, speed: document.getElementById('speedEl').textContent}));
  assert('level increases after 250 pts', parseInt(lvl.lvl) >=2, JSON.stringify(lvl));
  assert('speed >1.0× after level up', lvl.speed!=='1.0×', `speed ${lvl.speed}`);
  // 13 - responsive check - mobile viewport
  const mctx2 = await browser.newContext({viewport:{width:390,height:844}, deviceScaleFactor:2});
  const mpage = await mctx2.newPage();
  await mpage.goto(BASE+'/index.html');
  await mpage.waitForTimeout(600);
  assert('mobile startOverlay visible', await mpage.locator('#startOverlay').isVisible());
  assert('mobile touch buttons exist', await mpage.locator('#leftBtn').count()===1);
  // check responsive layout: game-shell visible width ~390
  const shellBox = await mpage.locator('#shell').boundingBox();
  assert('mobile shell fits viewport', shellBox.width <= 390 && shellBox.width >300, `w ${shellBox.width}`);
  await mctx2.close();

  console.log(`\nTOTAL: ${passed} passed, ${failed} failed`);
  if(failed>0) process.exitCode=1;
} finally {
  await browser.close();
}

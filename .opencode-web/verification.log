const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ args: ['--no-sandbox'] });
  const page = await browser.newPage();
  await page.on('console', msg => console.log('PAGE LOG:', msg.text()));
  await page.goto('http://127.0.0.1:3000/', { waitUntil: 'networkidle' });
  await page.click('#startBtn');
  await page.waitForTimeout(300);
  let pollen = await page.evaluate(() => {
    const g = window.__lanternMoth;
    return JSON.stringify(g.pollen[0]);
  });
  console.log('pollen0 raw', pollen);
  let detail = await page.evaluate(() => {
    const g = window.__lanternMoth;
    const p = g.pollen[0];
    const yoff = Math.sin(p.phase)*5;
    const moth = g.moth;
    const d = Math.hypot(p.x - moth.x, (p.y + yoff) - moth.y);
    return {p, yoff, moth: {x:moth.x,y:moth.y,r:moth.r}, d, thresh: moth.r + p.r + 7, rCheck: p.r};
  });
  console.log('detail', JSON.stringify(detail,null,2));
  // now teleport and check again
  await page.evaluate(() => {
    const g = window.__lanternMoth;
    const p = g.pollen[0];
    const yoff = Math.sin(p.phase)*5;
    g.moth.x = p.x;
    g.moth.y = p.y + yoff;
    const d = Math.hypot(p.x - g.moth.x, (p.y + yoff) - g.moth.y);
    console.log('inside teleport d', d, 'thresh', g.moth.r + p.r + 7);
  });
  await page.waitForTimeout(100);
  let after = await page.evaluate(() => {
    const g = window.__lanternMoth;
    const p = g.pollen.length>0 ? g.pollen[0] : null;
    return {score:g.getScore(), lives:g.getLives(), pollenLen:g.pollen.length, pollen0:p, moth:{x:g.moth.x,y:g.moth.y}};
  });
  console.log('after', JSON.stringify(after,null,2));
  await page.waitForTimeout(600);
  after = await page.evaluate(() => ({score: window.__lanternMoth.getScore(), pollenLen: window.__lanternMoth.pollen.length}));
  console.log('after 600ms', after);
  await browser.close();
})();

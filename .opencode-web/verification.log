    try{ await fn(); passes.push(name); console.log(`PASS: ${name}`);}catch(e){ failures.push(name); console.log(`FAIL: ${name} - ${e.message}`);}
  }
  await check('initial empty', async()=>{
    const t=await page.textContent('#emptyTitle'); if(!t.includes('No todos')) throw new Error(t);
  });
  await check('add via button', async()=>{ await page.fill('#todoInput','Buy milk'); await page.click('#addBtn'); await page.waitForTimeout(200); if((await page.$$('.todo-item')).length!==1) throw new Error('1');});
  await check('add via enter', async()=>{ await page.fill('#todoInput','Write docs'); await page.press('#todoInput','Enter'); await page.waitForTimeout(200); if((await page.$$('.todo-item')).length!==2) throw new Error('2');});
  await check('add third', async()=>{ await page.fill('#todoInput','Ship todo app'); await page.click('#addBtn'); await page.waitForTimeout(200); if((await page.$$('.todo-item')).length!==3) throw new Error('3');});
  await check('toggle', async()=>{ await page.click('.todo-item:first-child .check'); await page.waitForTimeout(200); if(!(await page.getAttribute('.todo-item:first-child','class')).includes('completed')) throw new Error('not completed');});
  await check('filter active', async()=>{ await page.click('a[href="#/active"]'); await page.waitForTimeout(300); if((await page.$$('.todo-item')).length!==2) throw new Error('active 2');});
  await check('filter completed', async()=>{ await page.click('a[href="#/completed"]'); await page.waitForTimeout(300); if((await page.$$('.todo-item')).length!==1) throw new Error('completed 1');});
  await check('filter all', async()=>{ await page.click('a[href="#/"]'); await page.waitForTimeout(300); if((await page.$$('.todo-item')).length!==3) throw new Error('all 3');});
  await check('toggle-all', async()=>{ await page.click('#toggleAll'); await page.waitForTimeout(300); if(!(await page.textContent('#counter')).includes('0 left')) throw new Error('0 left'); await page.click('#toggleAll'); await page.waitForTimeout(300); if(!(await page.textContent('#counter')).includes('3 left')) throw new Error('3 left');});
  await check('edit enter', async()=>{ await page.dblclick('.todo-item:nth-child(2) .todo-text'); await page.waitForTimeout(300); await (await page.$('.edit-input')).fill('Write docs v2'); await page.press('.edit-input','Enter'); await page.waitForTimeout(300); const texts=await page.$$eval('.todo-text', els=>els.map(e=>e.textContent.trim())); if(!texts.includes('Write docs v2')) throw new Error(texts);});
  await check('edit esc', async()=>{ await page.dblclick('.todo-item:nth-child(1) .todo-text'); await page.waitForTimeout(300); const inp=await page.$('.edit-input'); await inp.fill('TEMP'); await page.press('.edit-input','Escape'); await page.waitForTimeout(400); const texts=await page.$$eval('.todo-text', els=>els.map(e=>e.textContent.trim())); if(texts.includes('TEMP')) throw new Error('esc failed '+texts);});
  await check('delete', async()=>{ const before=(await page.$$('.todo-item')).length; await page.click('.todo-item:last-child .icon-btn.danger'); await page.waitForTimeout(300); if((await page.$$('.todo-item')).length!==before-1) throw new Error('delete');});
  await check('clear completed', async()=>{ await page.click('.todo-item:first-child .check'); await page.waitForTimeout(200); await page.click('#clearCompleted'); await page.waitForTimeout(300); const comp=await page.$$eval('.todo-item', els=>els.filter(e=>e.classList.contains('completed')).length); if(comp!==0) throw new Error('clear');});
  await check('persistence', async()=>{ await page.reload({waitUntil:'networkidle'}); await page.waitForTimeout(500); if((await page.$$('.todo-item')).length===0) throw new Error('reload empty');});
  await check('empty ignored', async()=>{ const b=(await page.$$('.todo-item')).length; await page.fill('#todoInput','   '); await page.click('#addBtn'); await page.waitForTimeout(200); if((await page.$$('.todo-item')).length!==b) throw new Error('empty');});
  console.log(`\nSummary ${passes.length} passed ${failures.length} failed`);
  await browser.close();
  process.exit(failures.length?1:0);
})();

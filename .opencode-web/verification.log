const puppeteer = require('puppeteer-core');
(async()=>{
  const browser = await puppeteer.launch({executablePath:'/usr/bin/google-chrome', args:['--no-sandbox','--disable-gpu']});
  const page = await browser.newPage();
  const errs=[];
  page.on('pageerror',e=>errs.push('pageerror:'+e.message));
  page.on('console',m=>{if(m.type()==='error')errs.push('console:'+m.text())});
  await page.setViewport({width:800,height:900});
  await page.goto('http://localhost:3000/index.html');
  await page.waitForSelector('#startBtn');
  const title = await page.title();
  console.log('title:', title);
  await page.click('#startBtn');
  await new Promise(r=>setTimeout(r,500));
  let s1 = await page.evaluate(()=>({state:window.__game.state, items:window.__game.items.length}));
  console.log('after-start:', JSON.stringify(s1));
  const x0 = await page.evaluate(()=>window.__game.player.x);
  await page.keyboard.down('ArrowRight');
  await new Promise(r=>setTimeout(r,500));
  await page.keyboard.up('ArrowRight');
  const x1 = await page.evaluate(()=>window.__game.player.x);
  console.log('move-right:', JSON.stringify({x0,x1,pass:x1>x0}));
  await page.evaluate(()=>{const g=window.__game; g.items.push({type:'parcel',x:g.player.x,y:640-56-10,w:34,h:26,vy:100,rot:0,vr:0,sway:0,swayF:1,t:0});});
  await new Promise(r=>setTimeout(r,400));
  let s2 = await page.evaluate(()=>({score:window.__game.score, caught:window.__game.caught}));
  console.log('catch:', JSON.stringify(s2));
  await page.evaluate(()=>{const g=window.__game; g.items.push({type:'hazard',x:g.player.x,y:640-56-10,w:34,h:26,vy:100,rot:0,vr:0,sway:0,swayF:1,t:0});});
  await new Promise(r=>setTimeout(r,400));
  let s3 = await page.evaluate(()=>({lives:window.__game.lives, hits:window.__game.hits}));
  console.log('hazard:', JSON.stringify(s3));
  await page.evaluate(()=>{window.__game.score=300;});
  await new Promise(r=>setTimeout(r,400));
  let s4 = await page.evaluate(()=>({level:window.__game.level}));
  console.log('level:', JSON.stringify(s4));
  await page.evaluate(()=>{window.__game.lives=1; const g=window.__game; g.items.push({type:'hazard',x:g.player.x,y:640-56-10,w:34,h:26,vy:100,rot:0,vr:0,sway:0,swayF:1,t:0});});
  await new Promise(r=>setTimeout(r,500));
  let s5 = await page.evaluate(()=>({state:window.__game.state, overVisible:!document.getElementById('overScreen').hidden}));
  console.log('gameover:', JSON.stringify(s5));
  await page.click('#restartBtn');
  await new Promise(r=>setTimeout(r,400));
  let s6 = await page.evaluate(()=>({state:window.__game.state, score:window.__game.score, lives:window.__game.lives}));
  console.log('restart:', JSON.stringify(s6));
  // gameplay screenshot mid-action
  await page.evaluate(()=>{window.__game.score=80;});
  await new Promise(r=>setTimeout(r,1200));
  await page.screenshot({path:'screenshots/final-gameplay.png'});
  // start screen shot
  await page.evaluate(()=>{window.__game.state='menu'; document.getElementById('startScreen').hidden=false; document.getElementById('overScreen').hidden=true;});
  await new Promise(r=>setTimeout(r,300));
  await page.screenshot({path:'screenshots/final-start.png'});
  console.log('errors:', JSON.stringify(errs));
  await browser.close();
  const pass = s1.state==='playing' && (x1>x0) && s2.score>=10 && s3.lives===2 && s4.level>=3 && s5.state==='over' && s6.state==='playing' && errs.length===0;
  console.log(pass ? 'ALL TESTS PASS' : 'TESTS FAILED');
  if(!pass) process.exit(1);
})().catch(e=>{console.error('FAIL',e); process.exit(1);});

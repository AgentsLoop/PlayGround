 await page.goto('http://localhost:3000/',{waitUntil:'networkidle0',timeout:60000});
 await new Promise(r=>setTimeout(r,6000));
 const hasMenu = await page.$('#menu:not(.hidden)');
 console.log('MENU_VISIBLE:',!!hasMenu);
 // start match
 await page.click('#startBtn');
 await new Promise(r=>setTimeout(r,5000));
 const st = await page.evaluate(()=>({toast:document.getElementById('toast').textContent,
  alive:document.getElementById('alive').textContent, timer:document.getElementById('timer').textContent,
  menuHidden:document.getElementById('menu').classList.contains('hidden')}));
 console.log('AFTER_START:',JSON.stringify(st));
 // drive forward + fire MG for 4s
 await page.keyboard.down('KeyW');
 await new Promise(r=>setTimeout(r,2500));
 await page.keyboard.down('KeyJ');
 await new Promise(r=>setTimeout(r,1500));
 await page.keyboard.up('KeyJ');
 const hud = await page.evaluate(()=>({hp:document.querySelector('#hp i').style.width,
  heat:document.querySelector('#heat i').style.width, speed:document.getElementById('speed').textContent,
  special:document.querySelector('#special i').style.width}));
 console.log('HUD:',JSON.stringify(hud));
 await page.screenshot({path:'screenshots/final-gameplay-desktop.png'});
 await page.keyboard.up('KeyW');
 // narrow viewport
 await page.setViewport({width:390,height:844,isMobile:true,hasTouch:true});
 await new Promise(r=>setTimeout(r,2000));
 await page.screenshot({path:'screenshots/final-gameplay-narrow.png'});
 const touchVisible = await page.evaluate(()=>getComputedStyle(document.getElementById('touch')).display);
 console.log('TOUCH_DISPLAY:',touchVisible);
 console.log('CONSOLE_ERRORS:',errors.length?errors.slice(0,10):'none');
 await browser.close();
})().catch(e=>{console.error('TEST_FAILED:',String(e).slice(0,500));process.exit(1);});

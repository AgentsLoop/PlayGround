cat > /tmp/run_browser.js << 'JS'
const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ args: ['--no-sandbox', '--disable-setuid-sandbox'] });
  const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });
  const page = await context.newPage();
  const url = 'http://127.0.0.1:3000/';
  console.log('navigating to', url);
  await page.goto(url, { waitUntil: 'networkidle' });
  await page.waitForTimeout(1500);
  // Screenshot 1: start screen
  await page.screenshot({ path: 'screenshots/final-start-screen.png', fullPage: true });
  console.log('screenshot 1 done');
  // Verify start screen visible
  const startVisible = await page.locator('#startScreen').isVisible();
  console.log('startVisible', startVisible);
  const title = await page.locator('#startScreen h2').textContent();
  console.log('title', title);
  // Click start
  await page.click('#startBtn');
  await page.waitForTimeout(800);
  const hudScore = await page.locator('#score').textContent();
  const timer = await page.locator('#timer').textContent();
  const lives = await page.locator('#lives').textContent();
  console.log('hud after start', {hudScore, timer, lives});
  const startHidden = await page.locator('#startScreen').isHidden();
  console.log('startHidden after start', startHidden);

  // Test keyboard movement - press arrow
  await page.keyboard.down('ArrowRight');
  await page.waitForTimeout(400);
  await page.keyboard.up('ArrowRight');
  await page.waitForTimeout(200);
  // Check moth moved via exposed __lanternMoth
  const mothPos1 = await page.evaluate(() => window.__lanternMoth ? {x: window.__lanternMoth.moth.x, y: window.__lanternMoth.moth.y} : null);
  console.log('mothPos1', mothPos1);

  // Move to collect pollen - try to teleport moth to pollen via JS for testing light boost
  const beforeScore = await page.evaluate(() => window.__lanternMoth.getScore());
  const beforeLight = await page.evaluate(() => window.__lanternMoth.getLightBoost());
  console.log('beforeScore', beforeScore, 'beforeLight', beforeLight);
  await page.evaluate(() => {
    const g = window.__lanternMoth;
    if(g.pollen.length>0){
      g.moth.x = g.pollen[0].x;
      g.moth.y = g.pollen[0].y;
    }
  });
  await page.waitForTimeout(600);
  const afterScore = await page.evaluate(() => window.__lanternMoth.getScore());
  const afterLight = await page.evaluate(() => window.__lanternMoth.getLightBoost());
  const lightRadius = await page.evaluate(() => window.__lanternMoth.getLightRadius());
  console.log('afterScore', afterScore, 'afterLight', afterLight, 'lightRadius', lightRadius);

  // Light boost check
  if(afterScore !== 10) console.log('WARN pollen not collected or score not 10');
  if(afterLight <= 0) console.log('WARN light boost not triggered');

  // Test spider damage
  const livesBefore = await page.evaluate(() => window.__lanternMoth.getLives());
  console.log('livesBefore', livesBefore);
  await page.evaluate(() => {
    const g = window.__lanternMoth;
    if(g.spiders.length>0){
      g.moth.x = g.spiders[0].x;
      g.moth.y = g.spiders[0].y;
      g.moth.invuln = 0;
    }
  });
  await page.waitForTimeout(600);
  const livesAfter = await page.evaluate(() => window.__lanternMoth.getLives());
  console.log('livesAfter', livesAfter);
  if(livesAfter !== livesBefore -1) console.log('WARN lives not decremented');

  // Screenshot 2: gameplay
  await page.screenshot({ path: 'screenshots/final-gameplay.png', fullPage: true });
  console.log('screenshot 2 done');

  // Test timer countdown
  const t1 = await page.evaluate(() => window.__lanternMoth.getTime());
  await page.waitForTimeout(1200);
  const t2 = await page.evaluate(() => window.__lanternMoth.getTime());
  console.log('timer countdown', t1, t2, 'delta', t1-t2);

  // Test restart via R
  await page.evaluate(() => {
    // force lives to 0 to trigger game over quickly
    // instead just call endGame via JS? Let's set lives 0 and trigger damage
    window.__lanternMoth.moth.invuln = 0;
  });
  // trigger 3 damages to get gameover
  for(let i=0;i<3;i++){
    await page.evaluate(() => {
      const g=window.__lanternMoth;
      if(g.spiders.length>0){
        g.moth.x = g.spiders[0].x;
        g.moth.y = g.spiders[0].y;
        g.moth.invuln = 0;
      }
    });
    await page.waitForTimeout(600);
  }
  await page.waitForTimeout(800);
  const isGameOver = await page.evaluate(() => window.__lanternMoth.getState());
  console.log('state after deaths', isGameOver);
  const gameOverVisible = await page.locator('#gameOverScreen').isVisible();
  console.log('gameOverVisible', gameOverVisible);
  await page.screenshot({ path: 'screenshots/final-gameover.png', fullPage: true });
  console.log('screenshot 3 done');

  // Test restart button
  if(gameOverVisible){
    await page.click('#restartBtn');
    await page.waitForTimeout(800);
    const stateAfterRestart = await page.evaluate(() => window.__lanternMoth.getState());
    const scoreAfter = await page.evaluate(()=> window.__lanternMoth.getScore());
    const livesAfterRestart = await page.evaluate(()=> window.__lanternMoth.getLives());
    console.log('after restart', stateAfterRestart, scoreAfter, livesAfterRestart);
    await page.screenshot({ path: 'screenshots/final-restart.png', fullPage: true });
  }

  // responsive check: resize viewport
  await page.setViewportSize({ width: 375, height: 667 });
  await page.waitForTimeout(500);
  await page.screenshot({ path: 'screenshots/final-mobile.png', fullPage: true });
  console.log('mobile screenshot done');

  await browser.close();
  console.log('ALL TESTS DONE');
})();

const { chromium } = require('playwright');
(async()=>{
  const browser = await chromium.launch({args:['--no-sandbox']});
  const page = await browser.newPage({viewport:{width:900,height:800}});
  await page.goto('http://127.0.0.1:3000/index.html', {waitUntil:'networkidle'});
  await page.screenshot({path:'screenshots/final-start-3000.png', fullPage:true});
  console.log('start ok');
  // verify start overlay visible
  const visible = await page.isVisible('#startOverlay');
  console.log('startOverlay visible',visible);
  // check HUD
  const score = await page.textContent('#score');
  console.log('score',score);
  // click start
  await page.click('#overlayStart');
  await page.waitForTimeout(900);
  const hidden = await page.isVisible('#startOverlay');
  console.log('after start overlay hidden?', hidden);
  await page.screenshot({path:'screenshots/final-gameplay-3000.png'});
  console.log('gameplay ok');
  await page.waitForTimeout(1500);
  const parcels = await page.$$eval('.parcel', els=>els.length);
  console.log('parcels count', parcels);
  await page.screenshot({path:'screenshots/final-action-3000.png'});
  console.log('action ok');
  // check responsive
  // keyboard test: try pressing pause
  await page.click('#pauseBtn');
  await page.waitForTimeout(300);
  const paused = await page.isVisible('#pausedBadge');
  console.log('paused badge', paused);
  await page.click('#pauseBtn');
  await browser.close();
})();

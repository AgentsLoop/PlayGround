const { chromium } = require('playwright');
(async()=>{
  const browser = await chromium.launch();
  const context = await browser.newPage({viewport:{width:1280,height:800}});
  // Use existing server on 3000
  const base = 'http://localhost:3000/index.html';
  let failures = [];
  let passes = [];
  async function check(name, fn){
    try { await fn(); passes.push(name); console.log(`PASS: ${name}`); }
    catch(e){ failures.push({name, err:e.message}); console.log(`FAIL: ${name} - ${e.message}`); }
  }
  const page = await browser.newPage({viewport:{width:1280,height:800}});
  await page.goto(base, {waitUntil:'networkidle'});
  await page.waitForTimeout(500);

  await check('initial load empty state', async()=>{
    const t = await page.textContent('#emptyTitle');
    if(!t.includes('No todos')) throw new Error('empty title '+t);
    const cnt = await page.textContent('#counter');
    if(!cnt.includes('0 left')) throw new Error('counter '+cnt);
  });

  await check('add todo via Add button', async()=>{
    await page.fill('#todoInput','Buy milk');
    await page.click('#addBtn');
    await page.waitForTimeout(200);
    const items = await page.$$('.todo-item');
    if(items.length!==1) throw new Error('expected 1 item got '+items.length);
    const text = await page.textContent('.todo-text');
    if(text.trim()!=='Buy milk') throw new Error('text mismatch '+text);
  });

  await check('add todo via Enter', async()=>{
    await page.fill('#todoInput','Write docs');
    await page.press('#todoInput','Enter');
    await page.waitForTimeout(200);
    const items = await page.$$('.todo-item');
    if(items.length!==2) throw new Error('expected 2 got '+items.length);
  });

  await check('add third todo', async()=>{
    await page.fill('#todoInput','Ship todo app');
    await page.click('#addBtn');
    await page.waitForTimeout(200);
    if((await page.$$('.todo-item')).length!==3) throw new Error('expected 3');
  });

  await check('counter 3 left', async()=>{
    const c = await page.textContent('#counter');
    if(!c.includes('3 left')) throw new Error(c);
    const total = await page.textContent('#totalLabel');
    if(!total.includes('3 tasks')) throw new Error(total);
  });

  await check('toggle complete', async()=>{
    await page.click('.todo-item:first-child .check');
    await page.waitForTimeout(200);
    const cls = await page.getAttribute('.todo-item:first-child','class');
    if(!cls.includes('completed')) throw new Error('not completed '+cls);
    const c = await page.textContent('#counter');
    if(!c.includes('2 left')) throw new Error('counter after toggle '+c);
  });

  await check('filter Active via hash', async()=>{
    await page.click('a[href="#/active"]');
    await page.waitForTimeout(300);
    if(page.url().indexOf('#/active')===-1) throw new Error('url no hash '+page.url());
    const items = await page.$$('.todo-item');
    if(items.length!==2) throw new Error('active filter expected 2 got '+items.length);
  });

  await check('filter Completed via hash', async()=>{
    await page.click('a[href="#/completed"]');
    await page.waitForTimeout(300);
    if(page.url().indexOf('#/completed')===-1) throw new Error('url '+page.url());
    const items = await page.$$('.todo-item');
    if(items.length!==1) throw new Error('completed expected 1 got '+items.length);
  });

  await check('filter All via hash and back button', async()=>{
    await page.click('a[href="#/"]');
    await page.waitForTimeout(300);
    if((await page.$$('.todo-item')).length!==3) throw new Error('all expected 3');
    // test back button goes to completed
    await page.goBack();
    await page.waitForTimeout(300);
    if(page.url().indexOf('#/completed')===-1) throw new Error('back did not go to completed '+page.url());
    await page.goForward();
    await page.waitForTimeout(300);
  });

  await check('toggle-all marks all complete', async()=>{
    await page.click('a[href="#/"]');
    await page.waitForTimeout(200);
    // toggle-all should be visible
    const visible = await page.isVisible('#toggleAllRow');
    if(!visible) throw new Error('toggleAllRow not visible');
    await page.click('#toggleAll');
    await page.waitForTimeout(300);
    const c = await page.textContent('#counter');
    if(!c.includes('0 left')) throw new Error('after toggle all '+c);
    const allCompleted = await page.$$eval('.todo-item', els=>els.every(e=>e.classList.contains('completed')));
    if(!allCompleted) throw new Error('not all completed');
    // untoggle
    await page.click('#toggleAll');
    await page.waitForTimeout(300);
    const c2 = await page.textContent('#counter');
    if(!c2.includes('3 left')) throw new Error('after untoggle '+c2);
  });

  await check('edit via double-click and Enter', async()=>{
    // get second item text
    const second = await page.$$('.todo-item');
    // double click span
    await page.dblclick('.todo-item:nth-child(2) .todo-text');
    await page.waitForTimeout(300);
    const inp = await page.$('.edit-input');
    if(!inp) throw new Error('edit input not found');
    await inp.fill('Write docs v2');
    await page.press('.edit-input','Enter');
    await page.waitForTimeout(300);
    const texts = await page.$$eval('.todo-text', els=>els.map(e=>e.textContent.trim()));
    if(!texts.includes('Write docs v2')) throw new Error('edited text missing '+texts);
  });

  await check('edit cancel via Esc preserves', async()=>{
    await page.dblclick('.todo-item:nth-child(1) .todo-text');
    await page.waitForTimeout(300);
    const inp = await page.$('.edit-input');
    await inp.fill('TEMP CHANGE');
    await page.press('.edit-input','Escape');
    await page.waitForTimeout(300);
    const texts = await page.$$eval('.todo-text', els=>els.map(e=>e.textContent.trim()));
    if(texts.includes('TEMP CHANGE')) throw new Error('Esc did not cancel');
  });

  await check('delete todo', async()=>{
    const before = (await page.$$('.todo-item')).length;
    await page.click('.todo-item:last-child .icon-btn.danger');
    await page.waitForTimeout(300);
    const after = (await page.$$('.todo-item')).length;
    if(after!==before-1) throw new Error(`delete expected ${before-1} got ${after}`);
  });

  await check('clear completed', async()=>{
    // mark one completed
    await page.click('.todo-item:first-child .check');
    await page.waitForTimeout(200);
    const clearDisabledBefore = await page.isDisabled('#clearCompleted');
    if(clearDisabledBefore) throw new Error('clear should be enabled');
    await page.click('#clearCompleted');
    await page.waitForTimeout(300);
    const items = await page.$$('.todo-item');
    // after clearing 1 completed from 2 remaining, should be 1 left? Actually we had 2 items after delete, 1 now completed then cleared -> 1 left
    // just check no completed items remain
    const completed = await page.$$eval('.todo-item', els=>els.filter(e=>e.classList.contains('completed')).length);
    if(completed!==0) throw new Error('completed still present');
  });

  await check('persistence via reload', async()=>{
    // remaining todos should persist after reload
    await page.reload({waitUntil:'networkidle'});
    await page.waitForTimeout(500);
    const items = await page.$$('.todo-item');
    if(items.length===0) throw new Error('no items after reload');
    const c = await page.textContent('#counter');
    if(!c) throw new Error('no counter after reload');
  });

  await check('empty input ignored', async()=>{
    const before = (await page.$$('.todo-item')).length;
    await page.fill('#todoInput','   ');
    await page.click('#addBtn');
    await page.waitForTimeout(200);
    const after = (await page.$$('.todo-item')).length;
    if(after!==before) throw new Error('empty input added');
  });

  console.log(`\nSummary: ${passes.length} passed, ${failures.length} failed`);
  if(failures.length) console.log(JSON.stringify(failures,null,2));
  await browser.close();
  process.exit(failures.length?1:0);
})();

const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ args: ['--no-sandbox'] });
  const page = await browser.newPage();
  await page.on('console', msg => console.log('PAGE:', msg.text()));
  await page.goto('http://127.0.0.1:3000/', { waitUntil: 'networkidle' });
  await page.click('#startBtn');
  await page.waitForTimeout(300);
  // patch update to log
  await page.evaluate(() => {
    window._origLog = [];
    // intercept pollen collision
    const orig = window.__lanternMoth;
    // add debug flag
    window.__debugUpdates = 0;
    // monkey patch via setInterval checking
  });
  // wait and manually test collision after 1s with logging
  for(let i=0;i<5;i++){
    let st = await page.evaluate(() => {
      const g=window.__lanternMoth;
      const p=g.pollen[0];
      const yoff = Math.sin(p.phase)*5;
      const d = Math.hypot(p.x - g.moth.x, (p.y+yoff)-g.moth.y);
      return {time:g.getTime(), state:g.getState(), moth:{x:g.moth.x,y:g.moth.y}, pollen0:{x:p.x,y:p.y,phase:p.phase,yoff, d}, score:g.getScore()};
    });
    console.log(`tick ${i}`, JSON.stringify(st));
    await page.waitForTimeout(300);
  }
  console.log('now teleport');
  await page.evaluate(() => {
    const g=window.__lanternMoth;
    const p=g.pollen[0];
    const yoff=Math.sin(p.phase)*5;
    console.log('before teleport moth', g.moth.x,g.moth.y,'pollen',p.x,p.y+yoff);
    g.moth.x=p.x;
    g.moth.y=p.y+yoff;
    console.log('after teleport moth', g.moth.x,g.moth.y);
  });
  for(let i=0;i<6;i++){
    let st = await page.evaluate(() => {
      const g=window.__lanternMoth;
      const p=g.pollen[0];
      if(!p) return {noPollen:true, score:g.getScore(), moth:{x:g.moth.x,y:g.moth.y}};
      const yoff = Math.sin(p.phase)*5;
      const d = Math.hypot(p.x - g.moth.x, (p.y+yoff)-g.moth.y);
      return {time:g.getTime(), state:g.getState(), moth:{x:g.moth.x,y:g.moth.y}, d, score:g.getScore(), pollenCount:g.pollen.length, phase:p.phase};
    });
    console.log(`post ${i}`, JSON.stringify(st));
    await page.waitForTimeout(200);
  }
  await browser.close();
})();
